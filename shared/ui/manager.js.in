 try{
  const s=await nativeRead('zerotier');zeroTierLast=Date.now();el('zt-state').textContent=!s.installed?'未安装 ZeroTier':({ONLINE:'在线',OFFLINE:'离线',UNAVAILABLE:'本地接口未响应'}[s.status]||s.status)+' · '+(s.version||'—');
  const box=el('zt-networks');box.replaceChildren();for(const n of s.networks||[]){const p=document.createElement('p');p.className='small-note';p.textContent=n.id+' · '+({OK:'已授权',ACCESS_DENIED:'未授权',NOT_FOUND:'网络不存在',REQUESTING_CONFIGURATION:'正在请求配置',PORT_ERROR:'虚拟网卡异常'}[n.status]||n.status)+' · '+n.ips;box.append(p)}
  if(s.installed&&!(s.networks||[]).length)box.textContent='未取得已加入网络，请检查本地服务。';
