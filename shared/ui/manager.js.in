async function waitJob(id,goal='done',limit=120000,messageTarget='operation-message'){const end=Date.now()+limit;let lastPhase='';while(Date.now()<end){await new Promise(r=>setTimeout(r,2500));let s;try{s=await syncNative()}catch(e){if(e.code==='session_conflict'||e.code==='session_expired')throw e;el(messageTarget).textContent='后台状态暂不可用，正在重新查询…';continue}lastPhase=s.phase;if(id&&s.id!==id)throw Error('另一项更新正在进行，请重试');if(s.phase==='uploading'&&!s.active&&pendingControl?.args[0]===id&&Date.now()-pendingControl.time>10000&&pendingControl.retries<2){pendingControl.retries++;pendingControl.time=Date.now();el(messageTarget).textContent='请求尚未执行，正在重新发送…';await control(pendingControl.script,pendingControl.args,true);continue}el(messageTarget).textContent=words[decode(s.message_b64||'').trim()]||decode(s.message_b64||'').trim()||'正在处理…';if(s.phase==='fetching'){const progress=await nativeRead('progress').catch(e=>{if(e.code==='session_conflict'||e.code==='session_expired')throw e;return ''});if(progress.trim())el(messageTarget).textContent=progress.trim()}if(s.phase==='error'&&!s.active)throw Error(words[decode(s.message_b64||'').trim()]||decode(s.message_b64||'').trim().replace(/^\/[^:\n]+:\d+:\s*/,'')||'操作失败，请查看日志');if(s.phase===goal&&!s.active)return s}throw Error(lastPhase==='uploading'?'操作未启动，修改尚未保存；请重新打开路由器管理页后重试':'操作仍在后台进行，请刷新状态或查看日志')}
