 const label=kind==='mirror'?'WebDAV 参数':kind==='source'?'订阅地址':kind==='filter'?'DNS 例外名单':kind==='policy'?'域名分流':'节点配置';
 // Four bounded requests share the same authenticated client. Await every
 // response before the next batch; no apply can run after a failed batch.
 for(let i=0;i<b64.length;i+=64){const jobs=[];for(let offset=i;offset<Math.min(i+64,b64.length);offset+=16){const chunk=(offset/16).toString(16).padStart(4,'0')+b64.slice(offset,offset+16);jobs.push(control('sc-put.sh',[id,chunk]))}const replies=await Promise.allSettled(jobs),failure=replies.find(r=>r.status==='rejected');if(failure)throw failure.reason;el(messageTarget).textContent='传输'+label+' '+Math.round(Math.min(i+64,b64.length)/b64.length*100)+'%'}
 const receipt=await nativeRead('uploadreceipt');if(receipt.id!==id||receipt.phase!=='uploading'||receipt.sha256!==sha256Bytes(new TextEncoder().encode(b64)))throw Error('配置传输不完整，未应用；请重新尝试');
}

