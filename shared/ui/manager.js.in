@@end@@
 if(el('subscription-parameters-details')){el('subscription-parameters-details').hidden=method!=='convert';el('subscription-parameters').textContent='target='+d.target+' · '+d.parameters}
}

async function loadConverters(force=false){if(convertersLoading||(!force&&(convertersLoaded||convertersAttempted)))return;convertersLoading=true;convertersAttempted=true;convertersError='';try{const data=await nativeRead('converters');converterDefaults=data.defaults||null;converterServers=data.servers||[];converterTemplates=data.templates||[];for(const old of Array.from(el('converter-server').options))if(/^[1-8]$/.test(old.value))old.remove();for(const row of data.servers||[]){if(Array.from(el('converter-server').options).some(o=>o.value===String(row.id)))continue;const o=document.createElement('option');o.value=row.id;o.textContent=row.url+' · '+row.name;el('converter-server').append(o)}for(const row of data.templates||[]){if(Array.from(el('converter-template-mode').options).some(o=>o.value===row.url))continue;const o=document.createElement('option');o.value=row.url;const category=/Mini|极简|精简|轻量|Lite/i.test(row.name)?'精简模板':/Full|全能|完整|重度/i.test(row.name)?'规则较多':/Online|在线/i.test(row.name)?'含远程规则':'资源需校验';o.textContent='ShellCrash · '+row.name+' · '+category;el('converter-template-mode').append(o)}syncSubscriptionOptions();if(Array.from(el('converter-server').options).some(o=>o.value===preferredConverter))el('converter-server').value=preferredConverter;convertersLoaded=true}catch(e){convertersError=e.message;converterDefaults=null}finally{convertersLoading=false;paintSubscriptionDefaults()}}
el('subscription-defaults-refresh').onclick=()=>loadConverters(true);
function syncSubscriptionOptions(){for(const [select,input]of [['subscription-ua-mode','subscription-ua'],['converter-template-mode','converter-template']]){const value=el(input).value;el(select).value=Array.from(el(select).options).some(o=>o.value===value)?value:'custom';el(input).hidden=el(select).value!=='custom'}}
for(const [select,input]of [['subscription-ua-mode','subscription-ua'],['converter-template-mode','converter-template']])el(select).onchange=()=>{const value=el(select).value;el(input).hidden=value!=='custom';if(value!=='custom')el(input).value=value;rememberSubscription()};
function subscriptionSource(url,exclusion=subscriptionExclusion()){
 const value=id=>el(id).value.trim(),method=el('subscription-method').value,custom=method==='convert'&&value('converter-server')==='custom'?value('converter-url'):method==='convert'&&value('converter-server')==='asailor'?'https://api.asailor.org':'',template=method==='convert'?value('converter-template'):'',ua=value('subscription-ua');
 const valid=(text,endpoint=false)=>{const u=new URL(text);if(!['http:','https:'].includes(u.protocol)||u.username||u.password||/\s/.test(text)||(endpoint&&(u.search||u.hash||text.length>512)))throw Error('请输入有效的 HTTP/HTTPS 地址，不含账号、密码或空格')};
 if(custom)valid(custom,true);else if(method==='convert'&&value('converter-server')==='custom')throw Error('请填写自定义转换服务地址');if(template)valid(template);if(template.length>2048||ua.length>128||/[\r\n\x00-\x1f\x7f]/.test(ua))throw Error('模板地址或 User-Agent 格式无效');
 const enc=text=>btoa(String.fromCharCode(...new TextEncoder().encode(text)));return url+'\n'+[['custom',custom.replace(/\/$/,'')],['template',template],['ua',ua],['exclude_mode',exclusion.mode],['exclude',exclusion.text]].map(([k,v])=>k+'='+enc(v)).join('\n')+'\n';
}
function converterPolicy(){return 's'+(['custom','asailor'].includes(el('converter-server').value)?'0':el('converter-server').value)+'a'+(!['custom','asailor'].includes(el('converter-server').value)&&el('converter-auto').checked?'1':'0')}
el('subscription-exclude').oninput=()=>{paintSubscriptionExclusion();rememberSubscription()};
subscriptionHelp();
for(const field of ['converter-url','converter-template','subscription-ua'])el(field).onchange=rememberSubscription;el('converter-auto').onchange=rememberSubscription;el('converter-server').onchange=rememberSubscription;

function paintCoreState(){
 if(!running)return;const groups=groupNames(),nodes=Object.values(proxies).filter(p=>!p.all&&!/^(direct|reject.*|pass.*|block|compatible|dns)$/i.test(p.type||'')).length;
 el('state').textContent=groups.length+' 个策略组 · '+nodes+' 个节点 · '+count+' 个连接 · '+(nativeState?.core_kind==='meta'?'mihomo':'sing-box')+' '+(version||nativeState?.core_version||'—')+' · 运行 '+coreUptimeText(nativeState||{running:true});
}

let inspectPage=0,inspectKind='rules',inspectQuery='',inspectController=null,inspectSnapshot=null,inspectGeneration=0,inspectTotal=0,inspectLoading=false,inspectPending=false;
const inspectLimit=20;
function inspectRows(kind,data){
 if(kind==='rules')return (data.rules||[]).map((r,i)=>({title:r.payload||r.rule||r.ruleSet||r.type||'默认规则',detail:[r.type,r.proxy||r.outbound].filter(Boolean).join(' → '),order:i+1}));
 if(kind==='groups')return Object.entries(data.proxies||{}).filter(([,p])=>Array.isArray(p.all)).map(([name,p])=>({title:label(name),detail:(p.type||'策略组')+' · '+p.all.length+' 个成员 · 当前 '+(p.now||'未选择')}));
 return (data.connections||[]).map(c=>{const m=c.metadata||{};return {title:m.host||m.destinationIP||'未知目标',detail:[m.network||'',m.sourceIP?m.sourceIP+':'+(m.sourcePort||''):'',...(c.chains||[]),c.rule?c.rule+(c.rulePayload?' / '+c.rulePayload:''):''].filter(Boolean).join(' · ')}});
}
function cancelInspection(){inspectPending=false;inspectGeneration++;if(inspectController)inspectController.abort();inspectController=null;inspectSnapshot=null;inspectLoading=false;el('inspect-list').replaceChildren();el('inspect-summary').textContent='按需查询内核已加载的数据';el('inspect-refresh').disabled=false;el('inspect-previous').disabled=el('inspect-next').disabled=true;el('inspect-page').textContent='';}
function renderInspection(data){
 if(!Array.isArray(data.rows)){
  if(data.total===0&&data.rows&&typeof data.rows==='object'&&!Object.keys(data.rows).length)data={...data,rows:[]};
  else throw Error('查询结果格式异常，请刷新重试');
 }
 inspectTotal=data.total;inspectPage=data.page;const list=el('inspect-list');list.replaceChildren();
 for(const r of data.rows){const row=document.createElement('div');row.className='inspect-row';const title=document.createElement('strong'),detail=document.createElement('small');title.textContent=(r.order?r.order+'. ':'')+String(r.title||'—');detail.textContent=String(r.detail||'');row.append(title,detail);list.append(row)}
 if(!data.rows.length){const empty=document.createElement('p');empty.className='small-note';empty.textContent=inspectKind==='connections'?'当前没有匹配的活动连接':'没有匹配的数据';list.append(empty)}
 el('inspect-summary').textContent=({rules:'已加载规则',groups:'当前策略组',connections:'当前连接'})[inspectKind]+' · '+data.total+' 项'+(data.checked?' · '+new Date(data.checked*1000).toLocaleTimeString('zh-CN',{hour12:false}):'');
 el('inspect-page').textContent=(data.total?data.page+1:0)+' / '+Math.ceil(data.total/inspectLimit);
 el('inspect-previous').disabled=inspectLoading||data.page<=0;el('inspect-next').disabled=inspectLoading||(data.page+1)*inspectLimit>=data.total;
}
async function loadInspection(reset=false){
 if(activeTab!=='rules'||!el('runtime-inspection').open||document.hidden)return;
 if(manageBusy||nativeState?.active){el('inspect-summary').textContent='正在处理配置，请稍后查询';return}
 if(!running){el('inspect-summary').textContent='代理已停止，启动后可查询运行数据';return}
 if(nativeState?.pressure==='protect'){el('inspect-summary').textContent='内存保护中，暂缓查询';return}
 if(inspectLoading){inspectPending=true;return}
 if(reset){inspectPage=0;inspectSnapshot=null}
 if(inspectController)inspectController.abort();const controller=new AbortController();inspectController=controller;const generation=++inspectGeneration;inspectLoading=true;el('inspect-refresh').disabled=true;el('inspect-previous').disabled=el('inspect-next').disabled=true;el('inspect-summary').textContent='正在查询…';
 const trafficWasActive=typeof trafficPollBusy!=='undefined'&&trafficPollBusy;
 if(typeof trafficController!=='undefined')trafficController?.abort();
 try{
  if(trafficWasActive)await new Promise(r=>setTimeout(r,1600));
  while(typeof trafficPollBusy!=='undefined'&&trafficPollBusy){await new Promise(r=>setTimeout(r,100));if(generation!==inspectGeneration)return}
  let data;
  if(typeof backendBase!=='undefined'&&apiBase===backendBase+'/api'){
   const params=new URLSearchParams({kind:'inspect',view:inspectKind,page:String(inspectPage),q:inspectQuery});
   const request=async()=>{const r=await fetch(backendBase+'/read?'+params,{cache:'no-store',signal:controller.signal});const d=await r.json();if(!r.ok)throw Error(d.error||'查询失败：'+r.status);return d};data=typeof withRouterRequest==='function'?await withRouterRequest(request,controller.signal):await request();
  }else{
   if(!inspectSnapshot){const d=await api(({rules:'/rules',groups:'/proxies',connections:'/connections'})[inspectKind],'GET',undefined,controller.signal);if(generation!==inspectGeneration)return;inspectSnapshot={rows:inspectRows(inspectKind,d),checked:Math.floor(Date.now()/1000)}}
   const rows=inspectSnapshot.rows.filter(r=>(r.title+' '+r.detail).toLowerCase().includes(inspectQuery.toLowerCase()));inspectPage=Math.min(inspectPage,Math.max(0,Math.ceil(rows.length/inspectLimit)-1));data={rows:rows.slice(inspectPage*inspectLimit,(inspectPage+1)*inspectLimit),total:rows.length,page:inspectPage,checked:inspectSnapshot.checked};
  }
  if(generation!==inspectGeneration||inspectPending)return;if(data.total>0&&data.page*inspectLimit>=data.total){inspectPage=Math.floor((data.total-1)/inspectLimit);loadInspection();return}inspectLoading=false;renderInspection(data);
 }catch(e){if(generation!==inspectGeneration||e.name==='AbortError')return;el('inspect-list').replaceChildren();el('inspect-summary').textContent=e.message;el('inspect-page').textContent='';}
 finally{if(generation===inspectGeneration){inspectLoading=false;inspectController=null;el('inspect-refresh').disabled=false;if(inspectPending){inspectPending=false;loadInspection(true)}}}
}
el('inspect-refresh').onclick=()=>loadInspection(true);
el('inspect-kind').onchange=()=>{inspectKind=el('inspect-kind').value;inspectQuery=el('inspect-query').value.trim();loadInspection(true)};
el('inspect-search-form').onsubmit=e=>{e.preventDefault();inspectQuery=el('inspect-query').value.trim();loadInspection(true)};
el('inspect-previous').onclick=()=>{if(inspectLoading||inspectPage<=0)return;inspectPage--;loadInspection()};
el('inspect-next').onclick=()=>{if(inspectLoading||(inspectPage+1)*inspectLimit>=inspectTotal)return;inspectPage++;loadInspection()};
document.addEventListener('visibilitychange',()=>{if(document.hidden)cancelInspection()});window.addEventListener('pagehide',cancelInspection);

let policyRows=[],policyLoaded=false,policyDirty=false,policyLoading=false;
function paintPolicyTargets(){const select=el('policy-target'),previous=select.value;select.replaceChildren();targetOptions(select,previous||mainName())}
function renderPolicy(){
 const list=el('policy-list');list.replaceChildren();for(let i=0;i<policyRows.length;i++){
  const r=policyRows[i],row=document.createElement('div');row.className='policy-row';const domain=document.createElement('strong'),match=document.createElement('small'),arrow=document.createElement('span'),target=document.createElement('span'),remove=document.createElement('button');domain.textContent=r.domain;match.textContent=r.kind==='suffix'?'含子域名':'仅此域名';arrow.className='policy-arrow';arrow.textContent='→';target.textContent=r.target==='direct'?'直连':groupLabel(r.target);remove.textContent='移除';remove.setAttribute('aria-label','移除 '+r.domain+' 的分流');remove.onclick=()=>{if(manageBusy)return;policyRows.splice(i,1);policyDirty=true;renderPolicy()};row.append(domain,match,arrow,target,remove);list.append(row)
 }
 el('policy-status').textContent=policyDirty?'有未保存的修改':policyRows.length?'已保存 '+policyRows.length+' 条 · 优先于'+(nativeState?.template_kind?'订阅模板规则':'国内分流与默认代理'):'没有自定义规则，使用现有国内直连与默认代理。';el('policy-save').hidden=!policyDirty;el('policy-save').classList.toggle('primary',policyDirty);el('policy-save').disabled=!policyLoaded||!policyDirty||manageBusy;
}
async function loadPolicy(){
 paintPolicyTargets();if(policyLoaded||policyLoading)return;policyLoading=true;
 try{const text=await nativeRead('policy');policyRows=text.trim()?text.trim().split('\n').map(line=>{const [kind,domain,target]=line.split('\t');return {kind,domain,target}}):[];policyLoaded=true;renderPolicy();paintQuickPolicies()}catch(e){el('policy-status').textContent='读取失败：'+e.message;el('policy-save').disabled=true}finally{policyLoading=false}
}
el('policy-add').onsubmit=e=>{e.preventDefault();if(!policyLoaded||manageBusy)return;const domain=el('policy-domain').value.trim().toLowerCase(),kind=el('policy-match').value,target=el('policy-target').value;const valid=domain.length<=253&&domain.includes('.')&&domain.split('.').every(x=>x.length>0&&x.length<=63&&/^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/.test(x));if(!valid||/^\d+\.\d+\.\d+\.\d+$/.test(domain)){el('policy-status').textContent='请输入域名，例如 github.com，不含 https://、路径或通配符';return}if(policyRows.length>=32){el('policy-status').textContent='最多添加 32 条简单分流规则';return}if(policyRows.some(r=>r.kind===kind&&r.domain===domain)){el('policy-status').textContent='该域名已存在，请先移除旧规则';return}policyRows.push({kind,domain,target});policyDirty=true;el('policy-domain').value='';renderPolicy()};
el('policy-save').onclick=async()=>{
 if(!policyLoaded||!policyDirty||manageBusy||nativeState?.active)return;
 pauseMeasurements();pauseSites();manageBusy=true;showService();el('policy-save').disabled=true;el('policy-status').textContent='正在保存；代理会短暂重启以应用规则…';note('正在保存域名分流，校验通过后应用…',false,{pending:true});const progressTarget=quickBaseRows?'quick-status':'policy-status';
 const id=[...crypto.getRandomValues(new Uint8Array(4))].map(b=>b.toString(16).padStart(2,'0')).join(''),text=policyRows.map(r=>r.kind+'\t'+r.domain+'\t'+r.target).join('\n')+(policyRows.length?'\n':'');
 try{await upload(id,'policy',new TextEncoder().encode(text),progressTarget);await control('sc-policy.sh',[id]);await waitJob(id,'done',240000,progressTarget);policyDirty=false;policyLoaded=false;await loadPolicy();if(running){await refresh();for(const item of quickPolicies){const target=quickDrafts.get(item.name);if(target&&proxies[item.tag]?.type==='Selector'&&proxies[item.tag].now!==target)await api('/proxies/'+encodeURIComponent(item.tag),'PUT',{name:target})}if(quickDrafts.size)await refresh()}quickBaseRows=null;quickDrafts.clear();renderPolicy();paintQuickPolicies();note('域名分流已保存并生效')}
 catch(e){if(quickBaseRows){policyRows=quickBaseRows;quickBaseRows=null;policyDirty=false;renderPolicy()}note('分流保存未确认：'+e.message+'；修改仍保留，请核对状态后重试',true);el('policy-status').textContent='保存未完成：'+e.message+'；修改保留，请核对运行状态。'}
 finally{manageBusy=false;await syncNative().catch(()=>{});showService();el('policy-save').disabled=!policyDirty;paintQuickActions();if(running)render()}
};
el('runtime-inspection').ontoggle=()=>{if(el('runtime-inspection').open)loadInspection(true);else cancelInspection()};

function paintGroupMode(){
 const p=proxies[viewRegion];if(!p)return;const note=el('group-mode-note');
 if(isPinnedAutoGroup(p)){note.textContent='自动组当前临时固定为 '+groupLabel(p.fixed)+'；解除固定后恢复内核自动选择。';return}
 if(el('search').value.trim()){note.textContent='搜索全部节点；经已有手动路径固定。共享手动组会联动；独立网站请用上方固定节点。';return}
 const descriptions={urltest:'内核按订阅配置定期测速择优；关闭网页后仍生效。',fallback:'内核按订阅优先顺序使用可用节点。',loadbalance:'内核按订阅配置分配连接，可能同时使用不同节点。'};
 note.textContent=isSelectable(p)?'手动组：点击成员固定使用。选择自动组后，由内核决定出口。':descriptions[String(p.type).toLowerCase()]||'此组由内核按订阅策略管理，可在高级面板查看。';
}


const policyLogos={"谷歌": "<svg viewBox=\"0 0 24 24\"><g transform=\"scale(.5)\"><path fill=\"#EA4335\" d=\"M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z\"/><path fill=\"#4285F4\" d=\"M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z\"/><path fill=\"#FBBC05\" d=\"M10.53 28.59A14.4 14.4 0 0 1 9.75 24c0-1.59.27-3.13.76-4.59l-7.98-6.19A23.87 23.87 0 0 0 0 24c0 3.87.93 7.53 2.56 10.78l7.97-6.19z\"/><path fill=\"#34A853\" d=\"M24 48c6.48 0 11.94-2.13 15.92-5.8l-7.73-6c-2.15 1.45-4.92 2.3-8.19 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z\"/></g></svg>", "ChatGPT": "<svg role=\"img\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><title>OpenAI</title><path d=\"M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z\"/></svg>", "GitHub": "<svg role=\"img\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><title>GitHub</title><path d=\"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12\"/></svg>", "国外 AI": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"m12 2 3 7 7 3-7 3-3 7-3-7-7-3 7-3z\"/></svg>"};
const quickPolicies=[{name:'谷歌',tag:'分流/谷歌',domains:['google.com','gstatic.com','googleapis.com']},{name:'ChatGPT',tag:'分流/ChatGPT',domains:['chatgpt.com','openai.com','oaistatic.com','oaiusercontent.com']},{name:'国外 AI',tag:'分流/国外 AI',domains:['claude.ai','anthropic.com','perplexity.ai','poe.com']},{name:'GitHub',tag:'分流/GitHub',domains:['github.com','githubusercontent.com','githubassets.com']}];
function targetOptions(select,current,includeDefault=false){
 if(includeDefault){const o=document.createElement('option');o.value='';o.textContent=nativeState?.template_kind?'跟随订阅规则':'跟随默认规则';select.append(o)}
 const direct=document.createElement('option');direct.value='direct';direct.textContent='直连';select.append(direct);
 for(const [caption,names]of [['策略组',groupNames().filter(n=>!n.startsWith('分流/'))],['固定节点',Object.keys(proxies).filter(n=>!proxies[n].all&&!/^(direct|reject.*|pass.*|block|compatible|dns)$/i.test(proxies[n].type||''))]]){const group=document.createElement('optgroup');group.label=caption;for(const n of names){const o=document.createElement('option');o.value=n;o.textContent=groupLabel(n);group.append(o)}select.append(group)}
 if(current&&!Array.from(select.options).some(o=>o.value===current)){const o=document.createElement('option');o.value=current;o.textContent=current+'（当前内核未找到）';select.append(o)}select.value=current;
}
const quickDrafts=new Map();
let quickBaseRows=null;
function paintQuickPolicies(){
 const box=el('quick-policies');if(!box)return;if(!policyLoaded){loadPolicy();return}if(box.querySelector('select:focus')){paintQuickActions();return;}
 box.replaceChildren();for(const item of quickPolicies){
  const card=document.createElement('div');card.className='quick-policy'+(quickDrafts.has(item.name)?' pending':'');const title=document.createElement('strong'),icon=document.createElement('span'),select=document.createElement('select');icon.className='policy-icon';icon.innerHTML=policyLogos[item.name];title.append(icon,document.createTextNode(item.name));title.title='匹配域名及其子域名：'+item.domains.join('、');select.setAttribute('aria-label',item.name+' 分流目标');
  const match=policyRows.filter(r=>item.domains.includes(r.domain)&&r.kind==='suffix'),values=new Set(match.map(r=>r.target)),saved=match.length===item.domains.length&&values.size===1?(match[0].target===item.tag?(proxies[item.tag]?.now||''):match[0].target):'';
  targetOptions(select,quickDrafts.has(item.name)?quickDrafts.get(item.name):saved,true);select.disabled=manageBusy||nativeState?.active;
  select.onchange=()=>{if(select.value===saved)quickDrafts.delete(item.name);else quickDrafts.set(item.name,select.value);card.classList.toggle('pending',quickDrafts.has(item.name));paintQuickActions()};const updateHint=()=>{const override=!!select.value;card.classList.toggle('overridden',override);select.title=override?'自定义覆盖，优先于'+(nativeState?.template_kind?'订阅规则':'默认规则'):(nativeState?.template_kind?'使用订阅模板规则':'使用默认规则')};const changed=select.onchange;select.onchange=()=>{changed();updateHint()};updateHint();card.append(title,select);box.append(card)
 }paintQuickActions();
}
function paintQuickActions(){const dirty=quickDrafts.size>0;el('quick-follow').hidden=false;el('quick-follow').textContent=nativeState?.template_kind?'全部跟随订阅':'全部恢复默认';el('quick-follow').disabled=manageBusy||nativeState?.active||(!quickDrafts.size&&!quickPolicies.some(p=>policyRows.some(r=>r.kind==='suffix'&&p.domains.includes(r.domain))));el('quick-policies').dataset.dirty=dirty?'1':'';el('quick-save').hidden=!dirty;el('quick-save').disabled=manageBusy||nativeState?.active;el('quick-status').classList.toggle('unsaved',dirty);el('quick-status').classList.toggle('has-overrides',!dirty&&quickPolicies.some(p=>policyRows.some(r=>r.kind==='suffix'&&p.domains.includes(r.domain))));el('quick-cancel').hidden=!dirty;el('quick-cancel').disabled=manageBusy;if(!(manageBusy&&quickBaseRows))el('quick-status').textContent=dirty?'有 '+quickDrafts.size+' 项未保存':(()=>{const n=quickPolicies.filter(p=>policyRows.some(r=>r.kind==='suffix'&&p.domains.includes(r.domain))).length;return n?n+' 项自定义覆盖 · '+(proxyMode!=='rule'?'恢复规则分流后生效':'优先于'+(nativeState?.template_kind?'订阅':'默认规则')):(nativeState?.template_kind?'全部跟随订阅规则':'全部跟随默认规则')})();}
el('quick-follow').onclick=()=>{if(manageBusy)return;for(const item of quickPolicies){const has=policyRows.some(r=>r.kind==='suffix'&&item.domains.includes(r.domain));if(has)quickDrafts.set(item.name,'');else quickDrafts.delete(item.name)}paintQuickPolicies()};
el('quick-cancel').onclick=()=>{if(manageBusy)return;quickDrafts.clear();paintQuickPolicies()};
async function saveNativeQuickPolicies(){
 const changes=quickPolicies.filter(p=>quickDrafts.has(p.name));
 if(!running||!changes.every(p=>quickDrafts.get(p.name)&&proxies[p.tag]?.type==='Selector'&&proxies[p.tag].all.includes(quickDrafts.get(p.name))&&p.domains.every(d=>policyRows.some(r=>r.kind==='suffix'&&r.domain===d&&r.target===p.tag))))return false;
 manageBusy=true;pauseMeasurements();pauseSites();showService();paintQuickActions();const applied=[];
 try{
  for(const p of changes){const old=proxies[p.tag].now;await api('/proxies/'+encodeURIComponent(p.tag),'PUT',{name:quickDrafts.get(p.name)});applied.push({tag:p.tag,old})}
  const data=await api('/proxies');if(!changes.every(p=>data.proxies[p.tag]?.now===quickDrafts.get(p.name)))throw Error('内核返回的选择与提交不一致');
  proxies=data.proxies;quickDrafts.clear();let warning='';if(typeof closeGroupConnections==='function')try{const r=await closeGroupConnections(changes.map(p=>p.tag));if(r.failed)warning=' 部分旧连接未重连，新连接使用新目标。'}catch{warning=' 旧连接未清理，新连接使用新目标。'}note('分流目标已生效，代理未重启；一分钟内自动保存。'+warning,!!warning);
 }catch(e){
  const errors=[];for(const p of applied.reverse()){try{await api('/proxies/'+encodeURIComponent(p.tag),'PUT',{name:p.old})}catch(err){errors.push(p.tag)}}
  await refresh().catch(()=>{});note(errors.length?'部分回退未确认：'+errors.join('、')+'；请核对当前选择。':('提交失败，已恢复原选择：'+e.message),true);
 }finally{manageBusy=false;showService();paintQuickPolicies();if(running)render()}
 return true;
}
el('quick-save').onclick=async()=>{
 if(!quickDrafts.size||manageBusy||nativeState?.active)return;if(policyDirty){note('请先保存规则页的未完成修改；这里的四项选择会保留',true);return}
 if(await saveNativeQuickPolicies())return;
 let next=policyRows.slice();for(const item of quickPolicies){if(!quickDrafts.has(item.name))continue;const target=quickDrafts.get(item.name);next=next.filter(r=>!(item.domains.includes(r.domain)&&r.kind==='suffix'));if(target)for(const domain of item.domains)next.push({kind:'suffix',domain,target})}
 if(next.length>32){note('自定义分流最多 32 条，请减少规则后重试',true);return}
 quickBaseRows=policyRows.slice();policyRows=next;policyDirty=true;renderPolicy();el('policy-save').click();paintQuickActions();
};

let advancedActive=false;
async function openAdvanced(){
 if(manageBusy||busy||nativeState?.active){note('正在处理操作，请稍后打开高级面板',true);return}
 if(policyDirty||el('quick-policies')?.dataset.dirty==='1'||dnsDirty){note('请先保存未完成的修改',true);return}
 advancedActive=true;showService();el('advanced-title').textContent=(nativeState?.core_kind==='meta'?'Yacd-Meta':'YACD')+' 高级面板';pauseMeasurements();pauseSites();cancelInspection();el('lightweight-area').hidden=true;el('advanced-area').hidden=false;el('advanced-frame').hidden=true;el('advanced-open').disabled=true;
 try{const id=[...crypto.getRandomValues(new Uint8Array(4))].map(b=>b.toString(16).padStart(2,'0')).join('');el('advanced-message').textContent='正在准备高级面板；代理服务继续运行。文件仅保存在内存中，重启后首次打开会重新下载。';await control('sc-advanced.sh',[id]);await waitJob(id,'done',180000,'advanced-message');if(!advancedActive)return;
 el('advanced-message').textContent='轻量面板的操作与测速已暂停。共用当前内核、规则和策略组；配置更新与 DNS 请返回轻量面板操作。流量图和实时日志暂不接入。';
 el('advanced-frame').src=typeof backendBase!=='undefined'?backendBase+'/advancedasset/index.html#/proxies':'/custom/sc-dashboard/index.html#/proxies';el('advanced-frame').hidden=false;
 }catch(e){el('advanced-message').textContent='高级面板准备失败：'+e.message+'。可返回轻量面板继续使用。'}
}
async function closeAdvanced(){advancedActive=false;el('advanced-frame').src='about:blank';el('advanced-frame').hidden=true;el('advanced-area').hidden=true;el('lightweight-area').hidden=false;el('advanced-open').disabled=false;if(!policyDirty&&!quickDrafts.size)policyLoaded=false;proxies={};await syncNative().catch(()=>{});if(running)await refresh();loadPolicy();}
el('advanced-open').onclick=openAdvanced;el('advanced-close').onclick=closeAdvanced;
window.addEventListener('message',async e=>{
 const d=e.data;if(!advancedActive||e.origin!==location.origin||e.source!==el('advanced-frame').contentWindow||d?.type!=='sc-dashboard-request')return;
 const method=String(d.method).toUpperCase(),path=String(d.path),allowed=method==='GET'&&/^\/(?:version|configs|rules|proxies|connections|providers\/(?:proxies|rules)|group)(?:\/[^?]*)?(?:\?.*)?$/.test(path)||(method==='PUT'||method==='DELETE')&&/^\/proxies\/[^?]+$/.test(path);
 let status=200,data,error;
 try{if(!allowed){status=403;throw Error('此操作请返回轻量面板处理')}data=await api(path,method,method==='PUT'?JSON.parse(d.body):undefined)}catch(err){status=err.status||status===403&&403||502;error=err.message}
 if(!advancedActive||e.source!==el('advanced-frame').contentWindow)return;e.source.postMessage({type:'sc-dashboard-response',id:d.id,status,data,error},location.origin);
});

function setDashboardScale(value){if(!['0.75','0.85','0.9','1'].includes(value))value='0.9';el('dashboard-scale').value=value;el('advanced-frame').style.setProperty('--dashboard-scale',value);try{localStorage.setItem('sc-dashboard-scale',value)}catch(e){}}
el('dashboard-scale').onchange=()=>setDashboardScale(el('dashboard-scale').value);
try{setDashboardScale(localStorage.getItem('sc-dashboard-scale')||'0.9')}catch(e){setDashboardScale('0.9')}

let proxyMode='rule',proxyModeLoading=false,proxyModeConflict=false;
function paintProxyMode(){
 const e=el('proxy-mode');if(!e)return;e.disabled=!running||manageBusy||!!nativeState?.active||advancedActive||proxyModeLoading;
 if(document.activeElement!==e||!proxyModeLoading)e.value=proxyMode;e.classList.toggle('mode-override',proxyMode!=='rule');
 if(running&&Object.keys(proxies).length){if(proxyMode==='direct')el('current').textContent='直连上网（内核待命）';else if(proxyMode==='global')displayNodeLabel(el('current'),resolvedNode('GLOBAL'),'全局 '+(nativeState?.transport?.active==='mixed'?'TCP / UDP':'TCP')+' 代理 / ');else displayNodeLabel(el('current'),resolvedNode(mainName()),groupLabel(mainName())+' / ');}
 const mixed=nativeState?.transport?.active==='mixed',protocol=mixed?'TCP / UDP':'TCP';
 for(const option of e.options||[])if(option.value==='global')option.textContent='全局 '+protocol+' 代理';
 const descriptions={rule:'规则：已接管的 '+protocol+' 新连接按分流规则选择出口。',direct:'直连：已暂停透明代理与 DNS 接管，新连接正常直连。',global:mixed?'全局：接管的外网 TCP / UDP 使用默认代理组；局域网与路由器 UDP 保持原路由。':'全局：外网 IPv4 TCP 使用默认代理组，取消国内 IP 绕过；普通 UDP 仍直连。'};
 const help=el('proxy-mode-help');if(help){help.textContent=proxyModeConflict?'内核与接管模式不一致，请重新选择模式。':descriptions[proxyMode];help.classList.toggle('override',proxyMode!=='rule');}
 const scope=el('proxy-mode-scope');if(scope)scope.textContent=(mixed?'手机、电脑的外网 IPv4 TCP / UDP 按所选模式接管；路由器自身 UDP 保持直连。':'外网 IPv4 TCP 按所选模式接管；普通 UDP 保持直连。')+'局域网、ZeroTier 与内核自身保留必要例外。直连暂停透明代理与 DNS 接管，内核仍可供手动代理使用。已有连接和客户端 DNS 缓存可能需要重新建立。重启内核后恢复规则分流。节点测速不用于验证分流。';
 const policy=el('policy-scope');if(policy)policy.textContent=proxyMode==='rule'?'自定义规则优先于订阅规则，作用于已接管的 '+protocol+' 新连接。保存会短暂重启服务。':proxyMode==='direct'?'当前为直连：这些规则已保存，恢复规则分流后生效。保存修改会重启服务并恢复规则分流。':'当前为全局代理：这些规则已保存，恢复规则分流后生效。保存修改会重启服务并恢复规则分流。';
 const dnsScope=el('dns-udp-scope');if(dnsScope)dnsScope.textContent=proxyMode==='direct'?'当前为直连，透明 DNS 接管已暂停；本页配置保留。保存修改会重启服务并恢复规则分流。':mixed?(proxyMode==='global'?'当前为全局代理，已接管的外网 UDP 使用默认代理组。':'局域网外网 UDP 按内核规则分流；Fake IP 的 UDP 可进入内核。')+' 路由器自身普通 UDP 保持直连。':'普通 UDP 保持直连；指向 Fake IP 的 UDP 被拒绝以便回落 TCP。游戏、STUN 等需在例外名单中。';
 if(typeof paintQuickActions==='function')paintQuickActions();
 e.title='只作用于接管的新连接；已有连接保持原出口，内核重启后恢复规则分流。';
 const traffic=el('traffic-state');if(traffic)traffic.textContent=!running?'接管已停止':proxyMode==='direct'?'接管已暂停':proxyMode==='global'?protocol+' 全局接管':protocol+' 规则接管';
 const advanced=el('advanced-open');if(advanced){advanced.textContent='打开 '+(nativeState?.core_kind==='meta'?'Yacd-Meta':'YACD')+' ↗';advanced.disabled=manageBusy||!!nativeState?.active||advancedActive||!running;}
}
async function readProxyMode(){const c=await api('/configs'),actual=String(c.mode||'rule').toLowerCase(),managed=nativeState?.traffic_mode||actual,mode=['rule','direct','global'].includes(managed)?managed:actual;if(['rule','direct','global'].includes(mode)){if(mode!==proxyMode&&typeof invalidateSiteResults==='function')invalidateSiteResults();proxyMode=mode;}proxyModeConflict=actual!==proxyMode;paintProxyMode();}
async function setProxyMode(){
 if(proxyModeLoading||manageBusy||nativeState?.active||advancedActive)return;
 const requested=el('proxy-mode').value,previous=proxyMode;if(!['rule','direct','global'].includes(requested)){paintProxyMode();return}
 proxyModeLoading=true;manageBusy=true;pauseMeasurements();pauseSites();showService();
 try{
  if(requested==='global'){
   const d=await api('/proxies'),g=d.proxies?.GLOBAL,target=[mainName(),'proxy-main'].find(n=>g?.all?.includes(n));if(!target)throw Error('GLOBAL 缺少默认代理组，当前模式保持');
   let leaf=target;const seen=new Set();while(d.proxies[leaf]?.all){if(seen.has(leaf)||!d.proxies[leaf].now)throw Error('默认代理组尚未选择可用节点');seen.add(leaf);leaf=d.proxies[leaf].now;}
   if(/^(direct|reject|rejectdrop)$/i.test(d.proxies[leaf]?.type||leaf))throw Error('默认代理组目前是直连或拒绝，请先选择代理节点');
   await api('/proxies/GLOBAL','PUT',{name:target});proxies=d.proxies;proxies.GLOBAL.now=target;
  }
  const id=[...crypto.getRandomValues(new Uint8Array(4))].map(b=>b.toString(16).padStart(2,'0')).join('');
  await control('sc-proxymode.sh',[id,requested]);await waitJob(id,'done',60000);await readProxyMode();
  if(proxyMode!==requested||proxyModeConflict)throw Error('未确认接管模式与内核一致');
  note(({rule:'已恢复规则分流',direct:'已暂停透明代理与 DNS 接管；旧连接或 DNS 缓存可能需要重新建立',global:nativeState?.transport?.active==='mixed'?'全局 TCP / UDP 代理已生效':'全局 TCP 代理已生效；普通 UDP 保持直连'})[requested]);
 }catch(e){proxyMode=previous;await syncNative().catch(()=>{});await readProxyMode().catch(()=>{});note('模式切换失败：'+e.message,true)}
 finally{manageBusy=false;proxyModeLoading=false;await syncNative().catch(()=>{});showService();if(running&&!manageBusy&&activeTab==='nodes')autoMeasure();}
}
el('proxy-mode').onchange=setProxyMode;

// Kernel counters reset with the core. Never integrate a browser-session total.
let trafficPrevious=null,trafficPollBusy=false,trafficController=null;
function trafficBytes(value){
 if(!Number.isFinite(value)||value<0)return '—';
 const units=['B','KB','MB','GB','TB'];let n=value,i=0;while(n>=1024&&i<units.length-1){n/=1024;i++}return n.toFixed(i?1:0)+' '+units[i];
}
function paintTraffic(data){
 const ids=['traffic-up','traffic-down','traffic-up-total','traffic-down-total'];
 if(!data?.running){trafficPrevious=null;for(const id of ids)el(id).textContent='—';el('traffic-sample-state').textContent='内核已停止';return}
 if(!data.epoch||![data.upTotal,data.downTotal,data.checked_ms].every(v=>Number.isFinite(v)&&v>=0))throw Error('流量统计暂不可用');
 let up=data.up,down=data.down;
 if(!Number.isFinite(up)||!Number.isFinite(down)){
  const last=trafficPrevious,ms=data.checked_ms-(last?.checked_ms||0);
  if(last?.epoch===data.epoch&&ms>0&&data.upTotal>=last.upTotal&&data.downTotal>=last.downTotal){up=(data.upTotal-last.upTotal)*1000/ms;down=(data.downTotal-last.downTotal)*1000/ms}else{up=down=NaN}
 }
 el('traffic-up').textContent=Number.isFinite(up)?trafficBytes(up)+'/s':'—';el('traffic-down').textContent=Number.isFinite(down)?trafficBytes(down)+'/s':'—';
 el('traffic-up-total').textContent=trafficBytes(data.upTotal);el('traffic-down-total').textContent=trafficBytes(data.downTotal);
 el('traffic-sample-state').textContent=Number.isFinite(up)?'':'采样中';trafficPrevious={...data};
}
async function pollTraffic(){
 if(trafficPollBusy)return;
 if(!running){paintTraffic({running:false});return}
 if(document.hidden||manageBusy||nativeState?.active||advancedActive||(typeof inspectLoading!=='undefined'&&inspectLoading)||(typeof activeTab==='string'&&activeTab==='rules'&&el('runtime-inspection')?.open)||(typeof siteBusy!=='undefined'&&siteBusy)){el('traffic-up').textContent=el('traffic-down').textContent='—';el('traffic-sample-state').textContent='采样已暂停';trafficPrevious=null;return}
 trafficPollBusy=true;trafficController=new AbortController();const timer=setTimeout(()=>trafficController?.abort(),3500);
 try{
@@if ax5@@
  const data=await api('/panel-traffic','GET',undefined,trafficController.signal);
@@else@@
  const data=await nativeRead('traffic');
@@end@@
  if(data.error)throw Error('流量统计暂不可用');
  if(!running){paintTraffic({running:false});return}
  if(document.hidden||manageBusy||nativeState?.active||advancedActive||(typeof inspectLoading!=='undefined'&&inspectLoading)||(typeof activeTab==='string'&&activeTab==='rules'&&el('runtime-inspection')?.open)||(typeof siteBusy!=='undefined'&&siteBusy)){el('traffic-up').textContent=el('traffic-down').textContent='—';el('traffic-sample-state').textContent='采样已暂停';trafficPrevious=null;return}
  paintTraffic(data);
 }catch(e){el('traffic-up').textContent=el('traffic-down').textContent='—';el('traffic-sample-state').textContent='统计暂不可用';trafficPrevious=null;}
 finally{clearTimeout(timer);trafficController=null;trafficPollBusy=false}
}
setInterval(pollTraffic,4000);
document.addEventListener('visibilitychange',()=>{if(document.hidden){trafficController?.abort();trafficPrevious=null}else pollTraffic()});
window.addEventListener('pagehide',()=>trafficController?.abort());
