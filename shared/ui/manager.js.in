 let data=bytes;if((kind==='bounds'||kind==='profile'||kind==='filter')&&typeof CompressionStream==='function')data=new Uint8Array(await new Response(new Blob([bytes]).stream().pipeThrough(new CompressionStream('gzip'))).arrayBuffer());
