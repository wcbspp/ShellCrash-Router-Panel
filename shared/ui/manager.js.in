async function downloadBackup(url,name){
 const r=await fetch(url,{cache:'no-store'});if(!r.ok)throw Error('备份文件下载失败：'+r.status);const text=await r.text();if(text.length>5400000)throw Error('备份传输超出限制');const split=text.indexOf('\n'),header=text.slice(0,split).trim().match(/^SCBACKUP1 ([0-9]+) ([a-f0-9]{64})$/);if(!header||Number(header[1])>4000000)throw Error('备份下载信息无效，请重新导出');const encoded=text.slice(split+1).replace(/\s/g,'');if(!/^[A-Za-z0-9+/]*={0,2}$/.test(encoded))throw Error('备份传输不完整，请重新导出');let binary;try{binary=atob(encoded)}catch{throw Error('备份传输不完整，请重新导出')}const bytes=Uint8Array.from(binary,c=>c.charCodeAt(0));if(bytes.length!==Number(header[1])||sha256Bytes(bytes)!==header[2])throw Error('备份下载校验失败，未导出损坏文件；请重试');if(bytes.length<32||bytes[0]!==31||bytes[1]!==139)throw Error('备份文件格式无效');
 const blob=new Blob([bytes],{type:'application/gzip'}),old=el('backup-download');if(old){URL.revokeObjectURL(old.href);old.remove()}const a=document.createElement('a');a.id='backup-download';a.className='refresh backup-download';a.href=URL.createObjectURL(blob);a.download=name;a.target='_top';a.textContent='下载文件';el('backup-local').parentNode.append(a);a.click();mirrorFeedback('备份已完整下载并通过校验（tar.gz）；若未自动保存，请点“下载文件”','success');setTimeout(()=>{if(a.isConnected){URL.revokeObjectURL(a.href);a.remove()}},600000);
@@end@@
}
