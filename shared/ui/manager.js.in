async function service(action){if(manageBusy||advancedActive)return;pauseMeasurements();pauseSites();manageBusy=true;showService();note('正在'+({start:'启动',stop:'停止',restart:'重启'}[action])+'服务…',false,{pending:true});try{await control('sc-'+action+'.sh');await waitJob('', 'done',180000);if(running)await refresh();note('');el('operation-message').textContent='操作完成'}catch(e){note(e.message,true)}finally{manageBusy=false;await syncNative().catch(()=>{});showService();if(running){render();autoMeasure()}}}
async function updateRules(){if(manageBusy||nativeState?.active)return;pauseMeasurements();pauseSites();manageBusy=true;showService();note('正在下载国内 IP 规则…',false,{pending:true});const id=[...crypto.getRandomValues(new Uint8Array(4))].map(b=>b.toString(16).padStart(2,'0')).join('');try{await control('sc-rules.sh',[id]);const s=await waitJob(id,'done',180000);if(running)await refresh();note(words[decode(s.message_b64).trim()]||'规则更新完成')}catch(e){note(e.message,true)}finally{manageBusy=false;await syncNative().catch(()=>{});showService();if(running)render()}}
async function loadDNS(){if(dnsLoaded)return;try{el('dns-filter').value=await nativeRead('filter');dnsLoaded=true;indexDNS()}catch(e){note(e.message,true)}}
function indexDNS(){const select=el('dns-index');select.replaceChildren();const lines=el('dns-filter').value.split('\n');lines.forEach((line,i)=>{if(line.startsWith('#')&&!line.startsWith('#+')&&!line.startsWith('#geosite:')){const o=document.createElement('option');o.value=i;o.textContent=line.slice(1);select.append(o)}})}
function jumpDNS(){const t=el('dns-filter'),lines=t.value.split('\n'),i=Number(el('dns-index').value),start=lines.slice(0,i).join('\n').length+(i?1:0);t.focus();t.setSelectionRange(start,start+lines[i].length);t.scrollTop=i*20;}
async function saveDNS(){if(manageBusy||nativeState?.active)return;manageBusy=true;pauseMeasurements();pauseSites();showService();const id=[...crypto.getRandomValues(new Uint8Array(4))].map(b=>b.toString(16).padStart(2,'0')).join(''),mode=el('dns-mode').value;try{await upload(id,'filter',new TextEncoder().encode(el('dns-filter').value));await control('sc-dns.sh',[id,mode==='redir_host'?'real':mode]);await waitJob(id,'done',180000);dnsDirty=false;if(running)await refresh();note('DNS 设置已保存并生效')}catch(e){note(e.message,true)}finally{manageBusy=false;await syncNative().catch(()=>{});showService();if(running)render()}}
async function clearLogs(){if(manageBusy||nativeState?.active)return;manageBusy=true;showService();try{await control('sc-clear.sh');await waitJob('','done',30000);await loadLogs();note('日志已清空')}catch(e){note(e.message,true)}finally{manageBusy=false;showService()}}
let logSections=[];function paintLogs(){const out=el('log-output');out.replaceChildren();const view=el('logs-view').value;for(const section of logSections){if(view!=='all'&&section.kind!==view)continue;const card=document.createElement('details');card.className='log-section';card.open=!!section.text;const title=document.createElement('summary');title.textContent=section.title+' · '+(section.text?section.text.split('\n').filter(Boolean).length+' 行':'暂无记录');card.append(title);const content=document.createElement(section.text?'pre':'p');if(!section.text)content.className='log-empty';content.textContent=section.text||'当前没有此类日志；只在操作、状态变化或异常时记录。';card.append(content);out.append(card)}}
async function loadLogs(){loadIncidents();el('logs-refresh').disabled=true;try{const raw=await nativeRead('logs'),text=raw.replace(/\x1b\[[0-9;]*m/g,'').replace(/https?:\/\/[^\s<>]+/g,'[链接已隐藏]');const parts=text.split(/^=== (.+?) ===\s*$/m);const names={'Management':'操作记录','Resource pressure':'内存压力','Proxy':'内核运行','ShellCrash':'工具日志','Subscription download':'订阅错误','ShellCrash subscription':'订阅获取','Last operation':'最近后台操作'};logSections=[];for(let i=1;i<parts.length;i+=2){const title=names[parts[i]]||parts[i],body=(parts[i+1]||'').trim();const kind=/订阅/.test(title)?'subscription':/内核/.test(title)?'core':/操作|校验/.test(title)?'operation':'system';logSections.push({title,text:body,kind})}if(!logSections.length)logSections=[{title:'最近日志',text:text.trim(),kind:'system'}];paintLogs();el('logs-summary').textContent='更新于 '+new Date().toLocaleTimeString('zh-CN',{hour12:false})+' · 按需读取，重启后清空'}catch(e){el('log-output').textContent='日志读取失败：'+e.message}finally{el('logs-refresh').disabled=false}}

// Exclusion runs on candidate nodes in the browser, before configuration publication.
function subscriptionExclusion(mode='auto'){
 const text=el('subscription-exclude').value.trim(),lines=text.split(/\r?\n/).map((s,i)=>({s:s.trim(),line:i+1})).filter(x=>x.s);
 if(new TextEncoder().encode(text).length>1024||lines.length>32)throw Error('节点排除最多 32 行、1024 字节');
 const entries=lines.map(x=>{const wrapped=x.s.match(/^\/(.*)\/[iu]*$/),regex=mode==='regex'||mode==='auto'&&(!!wrapped||/^\^|\$$|\.\*|\.\+|\||\\[dDwWsSpPbB]|\[[0-9][0-9-]*\]/.test(x.s)),pattern=wrapped&&mode==='auto'?wrapped[1]:x.s;
  if(regex)try{new RegExp(pattern,'iu')}catch(e){throw Error('节点排除第 '+x.line+' 行正则无效：'+e.message)}return {regex,pattern};});
 return {mode,text,lines:lines.map(x=>x.s),entries};
}
async function excludedNodeNames(names,filter){
 if(!filter.lines.length)return [];
 if(filter.entries.every(x=>!x.regex))return names.filter(name=>filter.entries.some(x=>name.normalize('NFKC').toLowerCase().includes(x.pattern.normalize('NFKC').toLowerCase())));
 // Run user expressions outside the UI thread; terminate expensive patterns.
 const code="onmessage=e=>{const {names,entries}=e.data,tests=entries.map(x=>x.regex?new RegExp(x.pattern,'iu'):x.pattern.normalize('NFKC').toLowerCase());postMessage(names.filter(n=>tests.some(r=>typeof r==='string'?n.normalize('NFKC').toLowerCase().includes(r):r.test(n))))}";
 const url=URL.createObjectURL(new Blob([code],{type:'text/javascript'}));let worker;
 try{return await new Promise((resolve,reject)=>{let timer;try{worker=new Worker(url);timer=setTimeout(()=>{worker.terminate();reject(Error('节点排除正则匹配超时，请简化表达式；当前配置保留'))},1000);worker.onmessage=e=>{clearTimeout(timer);resolve(e.data)};worker.onerror=()=>{clearTimeout(timer);reject(Error('节点排除正则执行失败；当前配置保留'))};worker.postMessage({names,entries:filter.entries})}catch(e){clearTimeout(timer);reject(Error('浏览器不支持安全正则匹配，请改用关键字'))}})}finally{if(worker)worker.terminate();URL.revokeObjectURL(url)}
}
async function filterSubscriptionNodes(profile,filter){
 const clash=Array.isArray(profile.proxies),list=clash?profile.proxies:Array.isArray(profile)?profile:profile.outbounds;
 if(!Array.isArray(list))throw Error('订阅缺少节点列表');
 const key=clash?'name':'tag',member=clash?'proxies':'outbounds',nodes=list.filter(n=>typeof n.server==='string'),removed=new Set(await excludedNodeNames(nodes.map(n=>n[key]),filter)),count=removed.size;
 const inputCount=nodes.length;if(!count)return {profile,count:0,inputCount,retainedCount:inputCount,removedGroups:[]};if(count===nodes.length)throw Error('节点排除命中了全部 '+count+' 个节点；当前配置保留');
 const result=JSON.parse(JSON.stringify(profile)),entries=clash?result.proxies:Array.isArray(result)?result:result.outbounds,groups=clash?result['proxy-groups']||[]:entries.filter(n=>Array.isArray(n.outbounds));
 let changed=true;while(changed){changed=false;for(const group of groups){if(removed.has(group[key])||!Array.isArray(group[member]))continue;group[member]=group[member].filter(name=>!removed.has(name));if(!group[member].length){removed.add(group[key]);changed=true}else if(group.default&&removed.has(group.default)){if(group[key].startsWith('分流/')){const fallback=groups.find(g=>g[key]==='proxy-main'&&!removed.has(g[key]))||groups.find(g=>!g[key].startsWith('分流/')&&!removed.has(g[key]));if(!fallback)throw Error('节点排除后缺少默认代理；当前配置保留');group._subscription_reset=true;group.default=fallback[key];if(!group[member].includes(group.default))group[member].push(group.default)}else group.default=group[member][0]}}}
 for(const n of entries)if(!removed.has(n[key])&&removed.has(n.detour||n['dialer-proxy']))throw Error('节点排除会破坏链式代理：'+n[key]+'；当前配置保留');
 const checkRoute=value=>{if(!value||typeof value!=='object')return;if(removed.has(value.final))throw Error('节点排除会移除最终出口：'+value.final);if(removed.has(value.outbound))throw Error('节点排除会移除规则目标：'+value.outbound+'；当前配置保留');for(const child of Object.values(value))if(typeof child==='object')checkRoute(child)};
 if(clash){for(const rule of result.rules||[]){const parts=rule.split(','),target=parts[parts.length-(parts.at(-1).toLowerCase()==='no-resolve'?2:1)];if(removed.has(target))throw Error('节点排除会移除规则目标：'+target+'；当前配置保留')}result.proxies=entries.filter(n=>!removed.has(n[key]));result['proxy-groups']=groups.filter(g=>!removed.has(g[key]))}else{checkRoute(result.route);const kept=entries.filter(n=>!removed.has(n[key]));if(Array.isArray(result))return {profile:kept,count,inputCount,retainedCount:inputCount-count,removedGroups:groups.filter(g=>removed.has(g[key])).map(g=>g[key])};result.outbounds=kept}
 return {profile:result,count,inputCount,retainedCount:inputCount-count,removedGroups:groups.filter(g=>removed.has(g[key])).map(g=>g[key])};
}
function subscriptionResult(message,kind='success'){
 const box=el('operation-message');box.textContent=message;box.className='operation-result '+kind;box.setAttribute?.('role',kind==='error'?'alert':'status');box.setAttribute?.('aria-live','polite');
}
function subscriptionSummary(filtered,full){
 const groups=Array.isArray(full['proxy-groups'])?full['proxy-groups']:full.outbounds?.filter(g=>Array.isArray(g.outbounds))||[];
 const rules=Array.isArray(full.rules)?full.rules:full.route?.rules||[];
 return '已采用本次订阅：'+filtered.retainedCount+' 个节点、'+groups.length+' 个订阅策略组、'+rules.length+' 条订阅规则。'+(filtered.count?' 下载 '+filtered.inputCount+' 个节点，按排除条件移除 '+filtered.count+' 个。':'')+(filtered.removedGroups?.length?' '+filtered.removedGroups.length+' 个空策略组已移除。':'')+' 本机 DNS 与自定义分流继续叠加。';
}
function paintSubscriptionExclusion(){const n=el('subscription-exclude').value.split(/\r?\n/).filter(s=>s.trim()).length;el('subscription-exclude-status').textContent=n?'已设置 '+n+' 条 · 下次更新时生效':'未设置';}

