let transportDirty=false;
function paintTransport(s){
 const select=el('transport-mode'),button=el('transport-save'),t=s.transport||{configured:'redir',active:s.running?'redir':'',mixed_available:false};
 const configured=t.configured||'redir',active=t.active||'';
 if(!transportDirty&&document.activeElement!==select)select.value=configured;
 for(const option of select.options)if(option.value==='mixed')option.disabled=!transportEditable||!t.mixed_available;
 const blocked=manageBusy||s.active||advancedActive;
 select.disabled=blocked||!transportEditable;
 const changed=select.value!==configured||(s.running&&active&&active!==configured);
 select.classList.toggle('changed',changed);button.classList.toggle('primary',changed&&!blocked);
 button.hidden=!transportEditable;button.disabled=!transportEditable||blocked||!changed||(!t.mixed_available&&select.value==='mixed');
 button.textContent=s.running?'应用并重启 ShellCrash':'保存接管方式';
 const label={redir:'Redir · TCP',mixed:'混合 · TCP + UDP',unsupported:'暂未适配'};
 el('transport-state').textContent='当前 '+(label[active||configured]||'待确认')+(s.running&&active&&active!==configured?' · 设置待重启':'');
 el('transport-result').textContent=!transportEditable?'K2P 当前适配 Redir，保留轻量接管。':changed?'有未应用的修改；应用时会短暂断开代理连接。':configured==='mixed'?'手机、电脑可接管 IPv4 TCP / UDP；路由器自身 UDP 保持直连。实际出口由首页流量模式决定。':'可接管 IPv4 TCP；普通 UDP 保持直连。实际出口由首页流量模式决定。';
 if(typeof paintProxyMode==='function')paintProxyMode();
}
async function saveTransport(){
 if(!transportEditable||manageBusy||nativeState?.active||advancedActive||el('transport-save').disabled)return;
 const mode=el('transport-mode').value,id=[...crypto.getRandomValues(new Uint8Array(4))].map(b=>b.toString(16).padStart(2,'0')).join('');
 manageBusy=true;pauseMeasurements();pauseSites();showService();note('正在应用接管方式，ShellCrash 将短暂重启…',false,{pending:true});
 try{
  await control('sc-transport.sh',[id,mode]);const result=await waitJob(id,'done',180000,'transport-result');
  transportDirty=false;invalidateSiteResults('接管方式已改变，请重新检测');
  await syncNative();if(running)await refresh();note(decode(result.message_b64||'').trim()||'接管方式已生效');
 }catch(e){note(e.message,true)}finally{
  manageBusy=false;await syncNative().catch(()=>{});showService();if(running){render();autoMeasure()}
 }
}
el('transport-save').onclick=saveTransport;
el('transport-mode').onchange=()=>{transportDirty=el('transport-mode').value!==(nativeState?.transport?.configured||'redir');paintTransport(nativeState||{})};

