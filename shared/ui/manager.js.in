 const lines=['ShellCrash '+(d.tool_version||nativeState?.tool_version||'—')+' · '+kind+' '+(d.core_version||'版本未记录')];
 const effective=ua==='none'?'':ua==='auto'?((d.core_kind||'').includes('singbox')?'sing-box/singbox/'+d.core_version:d.core_kind==='meta'?'clash.meta/mihomo/'+d.core_version:'clash'):ua||d.ua;
 lines.push('User-Agent：'+(method==='panel'?'curl 默认':(effective||'不发送')+'（'+(ua?'本次指定':d.ua_mode==='auto'?'ShellCrash 自动':'ShellCrash '+(d.ua_mode==='none'?'关闭 UA':'自定义'))+'）'));
 if(method==='convert'){
  const choice=el('converter-server').value,row=choice==='0'?d.converter:converterServers.find(x=>String(x.id)===choice),custom=choice==='asailor'?'https://api.asailor.org':choice==='custom'?el('converter-url').value.trim():'';
  lines.push('转换服务：'+(custom|| (choice==='custom'?'未填写自定义地址':row?.url||'未找到，请刷新工具参数'))+'（'+(choice==='0'?'ShellCrash 当前选择':choice==='custom'?'本次自定义':'本次选择')+'）');
@@if ax5@@
  const template=el('converter-template').value.trim(),selected=converterTemplates.find(x=>x.url===template);
  lines.push('转换模板：'+(template?(selected?.name||template):d.template?.name||'未找到，请在 ShellCrash 中确认')+'（'+(template?'本次指定':'ShellCrash 当前选择')+'）');
@@else@@
  const selected=el('converter-template').value.trim(),tpl=converterTemplates.find(t=>t.url===selected)||d.template;lines.push('规则模板：'+(selected||tpl?.url||'未配置')+'（'+(selected?'本次指定':'ShellCrash 当前选择')+'；加载前校验资源）');
@@end@@
  lines.push('失败换服务：'+(!['custom','asailor'].includes(el('converter-server').value)&&el('converter-auto').checked?'开启':'关闭'));
 }else lines.push('第三方转换：不调用');
 const count=(el('subscription-exclude')?.value||'').split(/\r?\n/).filter(s=>s.trim()).length,excludes=[];
 if(method==='convert'&&d.exclude)excludes.push('ShellCrash：'+d.exclude);if(count)excludes.push(count+' 条输入条件（下载后过滤）');
 lines.push('排除节点：'+(excludes.length?excludes.join('；'):'无'));if(method==='convert'&&d.include)lines.push('ShellCrash 保留条件：'+d.include);
