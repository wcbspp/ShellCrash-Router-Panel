let subscriptionOldNodes=[];
function retainSubscriptionNodeNames(nodes,oldNodes){
 const identity=n=>{if(!n?.server||!n.server_port||!n.type)return '';const type=n.type==='ss'?'shadowsocks':n.type;return JSON.stringify([type,String(n.server).toLowerCase(),Number(n.server_port),n.password??'',n.uuid??'',n.method??'',n.username??'',n.protocol??'',n.obfs??''])};
 const previous=new Map(),incoming=new Map();for(const n of oldNodes||[]){const key=identity(n);if(key)previous.set(key,[...(previous.get(key)||[]),n.tag])}for(const n of nodes){const key=identity(n);if(key)incoming.set(key,(incoming.get(key)||0)+1)}
