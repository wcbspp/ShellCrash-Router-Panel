  if(info.exclude_b64&&decode(info.exclude_b64).trim())lines.push('加载前节点排除：'+(info.exclude_mode==='auto'?'自动识别':info.exclude_mode==='regex'?'正则':'关键字')+' · '+decode(info.exclude_b64).split(/\r?\n/).filter(s=>s.trim()).length+' 条');
