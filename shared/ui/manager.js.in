async function syncNative(){if(!nativeHost)return;nativeState=await nativeRead('state');if(nativeState.running&&!nativeState.active&&!manageBusy)await readProxyMode().catch(()=>{});showService();if(activeTab==='monitor'&&el('memory-details').open)loadMemory();if(running&&!nativeState.active&&!manageBusy&&(!proxies[mainName()]||el('current').textContent==='代理已停止'))await refresh();else if(running&&activeTab==='nodes'&&!manageBusy&&!busy&&!nativeState.active&&Object.values(proxies).some(p=>p.all&&!isSelectable(p))){const d=await api('/proxies');proxies=d.proxies;render()}return nativeState}
