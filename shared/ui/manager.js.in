const decode=s=>new TextDecoder().decode(Uint8Array.from(atob(s),c=>c.charCodeAt(0)));
function nativeSessionError(response,json=false){
 if(response.includes('请先注销另一用户'))return Object.assign(Error('路由器后台存在另一登录会话，请退出旧连接后重新打开管理页；已停止等待'),{code:'session_conflict'});
 if((json&&/^\s*<(?:!doctype|html|head|script|body)\b/i.test(response))||response.includes('id="rtloginform"'))return Object.assign(Error('路由器登录已失效，请重新打开管理页；已停止等待'),{code:'session_expired'});
 return null;
}
async function nativeJSON(response,operation){
 const text=await response.text(),session=nativeSessionError(text,true);if(session)throw session;
 let result;try{result=JSON.parse(text)}catch{throw Error(operation+'：后台返回格式异常（HTTP '+response.status+'），修改尚未确认保存')}
 if(!response.ok||result.error||result.ok===false)throw Error(operation+'：'+response.status+(result.error?'（'+result.error+'）':''));return result;
}
@@if ax5@@
async function nativeRead(kind){const work=async()=>{const abort=new AbortController(),timer=setTimeout(()=>abort.abort(),10000);try{const r=await fetch(backendBase+'/read?kind='+encodeURIComponent(kind)+'&t='+Date.now(),{cache:'no-store',signal:abort.signal});if(['state','zerotier','converters','remoteconnection'].includes(kind))return await nativeJSON(r,'后台查询失败');const text=await r.text(),session=nativeSessionError(text);if(session)throw session;if(!r.ok)throw Error('后台请求失败：'+r.status);return text}finally{clearTimeout(timer)}};return typeof withRouterRequest==='function'?withRouterRequest(work):work()}
@@else@@
async function nativeRead(kind){
 const abort=new AbortController(),timer=setTimeout(()=>abort.abort(),10000),json=['state','converters','remoteconnection','nodeprofile','uploadreceipt','traffic'].includes(kind);
 try{const r=await fetch('/custom/sc-'+kind+'.asp?t='+Date.now(),{cache:'no-store',signal:abort.signal});if(!r.ok)throw Error('路由器后台请求失败：'+r.status);const response=await r.text(),session=nativeSessionError(response,json);if(session)throw session;return json?JSON.parse(response):response}finally{clearTimeout(timer)}
}
@@end@@
let pendingControl=null;
@@if ax5@@
async function control(script,args=[],retry=false){if(!retry&&!/^sc-(new|put)\.sh$/.test(script))pendingControl={script,args:args.slice(),time:Date.now(),retries:0};const r=await fetch(backendBase+'/control',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-SC-CSRF':csrf},body:new URLSearchParams({payload:JSON.stringify({script,args})})});const result=await nativeJSON(r,'操作请求失败');if(result.ok!==true)throw Error('后台未确认操作请求，修改尚未确认保存')}
function showTab(tab){const previous=activeTab;activeTab=tab;for(const t of ['nodes','checks','subscription','backup','rules','dns','monitor','logs']){el(t+'-tab').hidden=t!==tab;el('tab-'+t).classList.toggle('active',t===tab)}if(tab!=='nodes')pauseMeasurements();else if(previous!=='nodes')autoMeasure();if(tab!=='rules'&&typeof cancelInspection==='function')cancelInspection();if(tab==='rules'){loadPolicy();if(el('runtime-inspection').open)loadInspection()}if(tab==='logs')loadLogs();if(tab==='monitor'){refreshZeroTier();syncNative().catch(()=>{});loadIncidents();loadMemory(true)};if(tab==='dns')loadDNS();if(tab!=='checks'&&siteBusy)pauseSites();if(tab==='checks'&&(!siteLastTime||siteLastNode!==siteNode()))checkSites()}
function showService(){if(!nativeState)return;const s=nativeState,previousPressure=lastPressure;lastPressure=s.pressure;running=s.running;for(const field of el('subscription-form')?.elements||[])field.disabled=manageBusy||s.active||advancedActive;if(!dnsDirty&&s.dns_mode!=='unknown')el('dns-mode').value=s.dns_mode;el('rules-summary').textContent=(s.rules_count||4305)+' 条国内 IPv4 网段 · '+(s.rules_date_b64?'最近更新 '+decode(s.rules_date_b64).trim():'当前使用预置规则');const db=s.domain_check?.kind===s.core_kind?s.domain_check:s.domain_database||{};el('domain-summary').textContent='当前 '+(s.domain_file||'—')+(db.sha256?' · SHA256 '+db.sha256.slice(0,12):' · 部署固化版本')+(db.checked?' · 检查 '+new Date(db.checked*1000).toLocaleString('zh-CN',{hour12:false}):db.updated?' · 更新 '+new Date(db.updated*1000).toLocaleString('zh-CN',{hour12:false}):'');el('online').textContent=running?'内核运行中':'内核已停止';el('online').classList.toggle('off',!running);paintStartup(s);paintCoreState();paintSubscription(s);subscriptionHelp();el('resources').textContent='可用 '+((s.available_kb??s.free_kb)/1024).toFixed(1)+' MB · 内核 '+(s.rss_kb/1024).toFixed(1)+' MB · 异常恢复 '+(s.recoveries||0)+' 次';el('resources').title='异常恢复计数从本次记录启用后开始，清空日志不重置；重启路由器归零。';el('service-start').hidden=running;el('service-stop').hidden=!running;for(const id of ['service-start','service-stop','service-restart','subscription-update','rules-update','domain-update','dns-save','logs-clear','core-check','core-update','mirror-save','mirror-sync','memory-cleanup','memory-limits-save','guard-save'])el(id).disabled=manageBusy||s.active||advancedActive;el('service-restart').hidden=!running;el('panel').hidden=false;el('login').hidden=true;el('nodes-content').hidden=!running;el('stopped').hidden=running;if(!running){el('current').textContent='代理已停止';el('state').textContent='普通路由保持运行'}if(s.url_b64&&!el('subscription-url').value)el('subscription-url').value=decode(s.url_b64);paintSites();paintKernel();paintMirror();paintMonitor();paintTool();paintMeasurements();el('memory-protection').hidden=s.pressure==='normal'||!s.pressure;el('memory-protection').textContent=s.pressure==='protect'?'内存保护中：暂缓测速和配置更新，代理继续运行':'内存余量偏低，正在自动监测';el('resource-breakdown').textContent='RAM 文件与共享页 '+((s.shmem_kb||0)/1024).toFixed(1)+' MB · 内核数据 '+((s.slab_kb||0)/1024).toFixed(1)+' MB · TCP 缓冲 '+((s.tcp_kb||0)/1024).toFixed(2)+' MB · 连接跟踪 '+(s.conntrack||0);if(s.pressure==='protect'){pauseMeasurements();pauseSites();for(const id of ['subscription-update','rules-update','domain-update','dns-save','core-update'])el(id).disabled=true}else if(previousPressure==='protect'&&running&&!manageBusy){if(activeTab==='nodes')autoMeasure();if(activeTab==='checks')checkSites()}paintProxyMode();paintTransport(s);paintQuickActions();for(const select of el('quick-policies')?.querySelectorAll('select')||[])select.disabled=manageBusy||s.active||advancedActive;}
@@else@@
async function control(script,args=[],retry=false){if(!retry&&!/^sc-(new|put)\.sh$/.test(script))pendingControl={script,args:args.slice(),time:Date.now(),retries:0};if(!/^sc-(new|put|fetch|fetchconvert|fetchpanel|apply|start|stop|restart|clear|cleanup|memcfg|rules|dns|policy|groupmode|proxymode|transport|advanced|corecheck|coreupdate|toolcheck|toolupdate|mirrorsave|mirrorsync|mirrorverify|mirrortest|backuplocal|backupremote)\.sh$/.test(script)||args.some(s=>!/^[A-Za-z0-9+/=]+$/.test(s)))throw Error('请求参数无效');const action=[script,...args,csrf].join(' ');if(action.length>58)throw Error('请求长度超限');const r=await fetch('/start_apply.htm',{method:'POST',body:new URLSearchParams({action_mode:' Apply ',action_script:action,sid_list:'',current_page:'custom/AnyTLS.asp',next_page:''})});if(!r.ok)throw Error('操作请求失败：'+r.status);const response=await r.text();const session=nativeSessionError(response);if(session)throw session;if(!/<script>\s*done_committing\(\);\s*<\/script>/.test(response))throw Error('路由器未确认操作请求，请刷新管理页后重试')}
function showTab(tab){const previous=activeTab;activeTab=tab;for(const t of ['nodes','checks','subscription','backup','rules','dns','monitor','logs']){el(t+'-tab').hidden=t!==tab;el('tab-'+t).classList.toggle('active',t===tab)}if(tab!=='nodes')pauseMeasurements();else if(previous!=='nodes')autoMeasure();if(tab!=='rules'&&typeof cancelInspection==='function')cancelInspection();if(tab==='rules'){loadPolicy();if(el('runtime-inspection').open)loadInspection()}if(tab==='logs')loadLogs();if(tab==='monitor'){syncNative().catch(()=>{});loadIncidents();loadMemory(true)};if(tab==='dns')loadDNS();if(tab!=='checks'&&siteBusy)pauseSites();if(tab==='checks'&&(!siteLastTime||siteLastNode!==siteNode()))checkSites()}
function showService(){if(!nativeState)return;const s=nativeState,previousPressure=lastPressure;lastPressure=s.pressure;running=s.running;for(const field of el('subscription-form')?.elements||[])field.disabled=manageBusy||s.active||advancedActive;if(!dnsDirty&&s.dns_mode!=='unknown')el('dns-mode').value=s.dns_mode;el('rules-summary').textContent=(s.rules_count||4305)+' 条国内 IPv4 网段 · '+(s.rules_date_b64?'最近更新 '+decode(s.rules_date_b64).trim():'当前使用预置规则');el('online').textContent=running?'内核运行中':'内核已停止';el('online').classList.toggle('off',!running);paintStartup(s);paintCoreState();paintSubscription(s);subscriptionHelp();el('resources').textContent='可用 '+((s.available_kb??s.free_kb)/1024).toFixed(1)+' MB · 内核 '+(s.rss_kb/1024).toFixed(1)+' MB · 异常恢复 '+(s.recoveries||0)+' 次';el('resources').title='异常恢复计数从本次记录启用后开始，清空日志不重置；重启路由器归零。';el('service-start').hidden=running;el('service-stop').hidden=!running;for(const id of ['service-start','service-stop','service-restart','subscription-update','rules-update','dns-save','logs-clear','core-check','core-update','mirror-save','mirror-sync','memory-cleanup','memory-limits-save'])el(id).disabled=manageBusy||s.active||advancedActive;el('service-restart').hidden=!running;el('panel').hidden=false;el('login').hidden=true;el('nodes-content').hidden=!running;el('stopped').hidden=running;if(!running){el('current').textContent='代理已停止';el('state').textContent='普通路由和 ZeroTier 保持运行'}if(s.url_b64&&!el('subscription-url').value)el('subscription-url').value=decode(s.url_b64);paintSites();paintKernel();paintMirror();paintMonitor();paintTool();paintMeasurements();el('memory-protection').hidden=s.pressure==='normal'||!s.pressure;el('memory-protection').textContent=s.pressure==='protect'?'内存保护中：暂缓测速和配置更新，代理继续运行':'内存余量偏低，正在自动监测';el('resource-breakdown').textContent='RAM 文件与共享页 '+((s.shmem_kb||0)/1024).toFixed(1)+' MB · 内核数据 '+((s.slab_kb||0)/1024).toFixed(1)+' MB · TCP 缓冲 '+((s.tcp_kb||0)/1024).toFixed(2)+' MB · 连接跟踪 '+(s.conntrack||0);if(s.pressure==='protect'){pauseMeasurements();pauseSites();for(const id of ['subscription-update','rules-update','dns-save','core-update'])el(id).disabled=true}else if(previousPressure==='protect'&&running&&!manageBusy){if(activeTab==='nodes')autoMeasure();if(activeTab==='checks')checkSites()}paintProxyMode();paintTransport(s);paintQuickActions();for(const select of el('quick-policies')?.querySelectorAll('select')||[])select.disabled=manageBusy||s.active||advancedActive;}
