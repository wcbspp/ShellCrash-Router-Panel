let mirrorTestKey='',mirrorTestedAt=0;
function mirrorFeedback(message,kind='info'){const box=el('mirror-message');box.textContent=message;box.className='backup-feedback '+kind;box.hidden=!message;box.setAttribute?.('role',kind==='error'?'alert':'status');}
function mirrorDraft(){return {base:el('mirror-base').value.trim().replace(/\/$/,''),user:el('remote-user').value.trim(),password:el('remote-password').value,enabled:el('remote-enabled').checked};}
function mirrorDraftKey(){const d=mirrorDraft();return JSON.stringify([d.base,d.user,d.password]);}
function mirrorCredentialsValid(){const d=mirrorDraft(),same=d.base===decode(nativeState?.mirror_base_b64||'').trim().replace(/\/$/,'')&&d.user===decode(nativeState?.webdav_user_b64||'').trim();return /^https?:\/\/[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:\/[A-Za-z0-9._~%+-]+)*$/.test(d.base)&&!!d.user&&(!!d.password||same&&nativeState?.webdav_password_set);}
function mirrorDraftVerified(){const d=mirrorDraft();return mirrorTestKey===mirrorDraftKey()&&Date.now()-mirrorTestedAt<900000||!mirrorDirty&&nativeState?.remote_enabled&&nativeState?.remote_verified&&!d.password;}
function paintMirror(){
 if(!nativeState)return;const s=nativeState;
 if(mirrorTestKey&&Date.now()-mirrorTestedAt>=900000){mirrorTestKey='';mirrorFeedback('测试结果已过期，请重新测试连接后保存','info');}
 if(!mirrorDirty){el('mirror-base').value=s.remote_transport==='webdav'?decode(s.mirror_base_b64||'').trim():'';el('remote-user').value=decode(s.webdav_user_b64||'').trim();el('remote-enabled').checked=s.remote_transport==='webdav'&&!!s.remote_enabled;el('remote-password').value=''}
 const ready=s.remote_transport==='webdav'&&s.remote_enabled&&s.remote_verified,busy=manageBusy||s.active||advancedActive;
 const home=el('remote-home');if(home){home.hidden=s.remote_transport!=='webdav'||!s.remote_enabled;home.textContent=!ready?'WebDAV 待验证':!remoteConnection?'WebDAV 检查中':({connected:'WebDAV 连接正常',unreachable:'WebDAV 无法连接',unauthorized:'WebDAV 认证失败',error:'WebDAV 地址异常'}[remoteConnection.state]||'WebDAV 待验证');home.title=remoteConnection?.checked?'最近连接检查：'+new Date(remoteConnection.checked*1000).toLocaleString('zh-CN',{hour12:false})+'；打开页面检查，非持续在线监测':s.remote_checked?'最近验证：'+new Date(s.remote_checked*1000).toLocaleString('zh-CN',{hour12:false}):'尚未验证'}
 const connectionKey=ready?[s.mirror_base_b64,s.webdav_user_b64,s.remote_checked].join(':'):'';if(connectionKey!==remoteConnectionKey){remoteConnectionKey=connectionKey;remoteConnection=null;if(ready)nativeRead('remoteconnection').then(result=>{if(remoteConnectionKey===connectionKey){remoteConnection=result;paintMirror()}}).catch(()=>{if(remoteConnectionKey===connectionKey){remoteConnection={state:'unreachable',checked:Math.floor(Date.now()/1000)};paintMirror()}})}
 const versions=[];for(const [scope,title] of [['application','应用包'],['config','自动配置']]){let b;try{b=JSON.parse(decode(s['remote_'+scope+'_b64']||''))}catch{}if(b?.format===1&&b.created&&/^[a-f0-9]{64}$/.test(b.sha256||''))versions.push(title+' · '+new Date(b.created*1000).toLocaleString('zh-CN',{hour12:false})+' · '+(Number(b.size)/1024).toFixed(0)+' KB\n内核 '+(b.core_kind==='meta'?'Mihomo':'sing-box')+' '+b.core_version+' · ShellCrash '+b.tool_version+' · 面板 '+(b.panel_version&&b.panel_version!=='unknown'?b.panel_version:'版本未记录')+' · 包编号 '+b.sha256.slice(0,12))}el('remote-versions').textContent=!ready?'开启并验证后读取远端版本':versions.length?versions.join('\n\n'):'尚无最新备份记录，请点“备份到 WebDAV”创建';
 el('mirror-save').classList.toggle('dirty',mirrorDirty);
 el('backup-badge').textContent=mirrorDirty?(mirrorDraftVerified()?'测试通过 · 待保存':el('remote-enabled').checked?'待测试':s.remote_enabled?'待关闭':'未启用'):s.remote_transport!=='webdav'||!s.remote_enabled?'已关闭':ready?'已验证':'待验证';el('backup-badge').classList.toggle('ready',mirrorDirty?mirrorDraftVerified():ready);
 const samePeer=el('mirror-base').value.trim()===decode(s.mirror_base_b64||'').trim()&&el('remote-user').value.trim()===decode(s.webdav_user_b64||'').trim();el('backup-password-state').textContent=s.webdav_password_set&&samePeer?'密码已保存，留空沿用':s.webdav_password_set?'账号或地址已变更，请重新填写密码':'请填写此账号的 WebDAV 密码';
 el('mirror-status').textContent=mirrorDirty?(mirrorDraftVerified()?'测试通过，设置尚未保存':el('remote-enabled').checked?'有未保存设置，请先测试连接':'关闭尚未保存，点击保存后生效'):s.remote_transport!=='webdav'||!s.remote_enabled?'关闭时不连接 WebDAV；本地导出仍可使用':!s.remote_verified?'已保存，验证通过后才能备份和拉取':'WebDAV 已验证，可备份并用作恢复来源';
 el('mirror-sync').disabled=busy||!ready||mirrorDirty||s.pressure==='protect';el('mirror-verify').disabled=busy;el('backup-local').disabled=busy;
 el('backup-http-note').hidden=!el('mirror-base').value.startsWith('http://');
 el('mirror-save').disabled=busy||!mirrorDirty||el('remote-enabled').checked&&!mirrorDraftVerified();for(const id of ['remote-enabled','mirror-base','remote-user','remote-password'])el(id).disabled=busy;
}
async function mirrorAction(action){
 if(manageBusy||nativeState?.active){mirrorFeedback('另一项操作正在进行，请稍后重试','info');return false;}
 let {base,user,password,enabled}=mirrorDraft();const key=mirrorDraftKey(),disableOnly=action==='mirrorsave'&&!enabled&&!mirrorDraftVerified();if(disableOnly){base=decode(nativeState?.mirror_base_b64||'').trim();user=decode(nativeState?.webdav_user_b64||'').trim();password='';}
 if((action==='mirrortest'||action==='mirrorsave'&&enabled)&&!mirrorCredentialsValid()){mirrorFeedback(!password&&(!nativeState?.webdav_password_set||user!==decode(nativeState.webdav_user_b64||'').trim()||base!==decode(nativeState.mirror_base_b64||'').trim())?'测试未开始：更换账号或地址后，请重新填写密码':'测试未开始：请填写有效的 WebDAV 地址、账号和密码','error');if(!password)el('remote-password').focus?.();return false;}
 if(action==='mirrorsave'&&enabled&&!mirrorDraftVerified()){mirrorFeedback('请先测试当前地址与账号密码，通过后再保存','error');return false;}
 pauseMeasurements();pauseSites();manageBusy=true;showService();mirrorFeedback(action==='mirrortest'?'正在测试连接、写入、读取和清理…':action==='mirrorsave'?'正在保存设置…':'正在处理备份…','working');
 const id=[...crypto.getRandomValues(new Uint8Array(4))].map(b=>b.toString(16).padStart(2,'0')).join('');
 try{
  if(action==='mirrorsave'||action==='mirrortest'){const b64=v=>{let bytes=new TextEncoder().encode(v),str='';for(const b of bytes)str+=String.fromCharCode(b);return btoa(str)};await upload(id,'mirror',new TextEncoder().encode('enabled='+(enabled?'1':'0')+'\ntransport=webdav\nbase_b64='+b64(base)+'\nuser_b64='+b64(user)+'\npassword_b64='+b64(password)+'\n'),'mirror-message');}
  await control('sc-'+action+'.sh',[id]);await waitJob(id,'done',180000,'mirror-message');
  if(action==='mirrortest'){mirrorTestKey=key;mirrorTestedAt=Date.now();mirrorDirty=true;mirrorFeedback(enabled?'测试通过。点击“保存设置”后启用 WebDAV':'测试通过，设置尚未保存；勾选开启并保存后才启用','success');}
  else if(action==='mirrorsave'){await syncNative();mirrorDirty=false;mirrorTestKey='';el('remote-password').value='';mirrorFeedback(enabled?'设置已保存，WebDAV 已启用':disableOnly?'WebDAV 已关闭，连接参数保持原值':'设置已保存，WebDAV 保持关闭','success');}
  else mirrorFeedback(action==='backupremote'?'已备份到 WebDAV':'备份已准备好，正在下载','success');
  paintMirror();return true;
 }catch(e){if(action==='mirrortest'||action==='mirrorsave')mirrorTestKey='';mirrorFeedback((action==='mirrortest'?'测试失败：':'操作失败：')+e.message,'error');return false;}
 finally{manageBusy=false;await syncNative().catch(()=>{});showService();if(running)render();}
}
for(const id of ['mirror-base','remote-user','remote-password'])el(id).oninput=()=>{mirrorDirty=true;mirrorTestKey='';mirrorFeedback('参数已修改，请点击测试连接','info');paintMirror();};el('remote-enabled').onchange=()=>{mirrorDirty=true;paintMirror();};
el('mirror-form').onsubmit=e=>{e.preventDefault();mirrorAction('mirrorsave');};el('mirror-sync').onclick=()=>mirrorAction('backupremote');el('mirror-verify').onclick=()=>mirrorAction('mirrortest');
