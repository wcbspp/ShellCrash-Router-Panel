function sha256Bytes(bytes){
 const k=[],h=[],w=new Uint32Array(64);let prime=2;
 while(k.length<64){let valid=true;for(let d=2;d*d<=prime;d++)if(prime%d===0){valid=false;break}if(valid){if(h.length<8)h.push((Math.sqrt(prime)%1*4294967296)>>>0);k.push((Math.cbrt(prime)%1*4294967296)>>>0)}prime++}
 const data=new Uint8Array(Math.ceil((bytes.length+9)/64)*64);data.set(bytes);data[bytes.length]=128;const view=new DataView(data.buffer);view.setUint32(data.length-8,Math.floor(bytes.length/536870912));view.setUint32(data.length-4,(bytes.length*8)>>>0);
 const rr=(x,n)=>(x>>>n)|(x<<(32-n));
 for(let offset=0;offset<data.length;offset+=64){for(let i=0;i<16;i++)w[i]=view.getUint32(offset+i*4);for(let i=16;i<64;i++){const x=w[i-15],y=w[i-2];w[i]=(w[i-16]+(rr(x,7)^rr(x,18)^(x>>>3))+w[i-7]+(rr(y,17)^rr(y,19)^(y>>>10)))>>>0}let [a,b,c,d,e,f,g,z]=h;
  for(let i=0;i<64;i++){const t=(z+(rr(e,6)^rr(e,11)^rr(e,25))+((e&f)^(~e&g))+k[i]+w[i])>>>0,v=((rr(a,2)^rr(a,13)^rr(a,22))+((a&b)^(a&c)^(b&c)))>>>0;z=g;g=f;f=e;e=(d+t)>>>0;d=c;c=b;b=a;a=(t+v)>>>0}
  for(const [i,value]of [a,b,c,d,e,f,g,z].entries())h[i]=(h[i]+value)>>>0;
 }
 return h.map(x=>x.toString(16).padStart(8,'0')).join('');
@@end@@
}
