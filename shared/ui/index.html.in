el('node-ping-run').onclick=runNodePing;el('node-https-run').onclick=runNodeHTTPS;el('node-diagnostic-close').onclick=()=>{cancelNodeDiagnostic();el('node-diagnostic').hidden=true;nodeDiagnostic=null};
document.addEventListener('visibilitychange',()=>{if(document.hidden)pauseMeasurements();else if(typeof activeTab==='string'&&activeTab==='nodes')autoMeasure()});window.addEventListener('pagehide',pauseMeasurements);
