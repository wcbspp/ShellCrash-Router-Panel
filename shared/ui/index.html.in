<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ShellCrash</title>
<style>
:root{color-scheme:light;--blue:#087ec2;--brand:#087ec2;--brand-bg:#eaf4fe;--ink:#253348;--muted:#798494;--line:#e1e7ef}*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;background:#f4f6f9;color:var(--ink);font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif}main{max-width:920px;margin:24px auto;padding:0 20px}h1{font-size:23px;margin:0 0 18px}button,input,select{font:inherit}button{cursor:pointer}button:disabled{cursor:default;opacity:.5}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:2px solid var(--blue);outline-offset:2px}button,input,select{transition:border-color .15s,background .15s}button svg{vertical-align:middle}a{color:var(--blue);text-decoration:none}a:hover{text-decoration:underline}.status-card{display:flex;align-items:center;justify-content:space-between;gap:10px;background:#fff;border:1px solid var(--line);border-radius:8px;padding:13px 16px;margin-bottom:12px}.caption{font-size:11px;color:var(--muted);letter-spacing:1px;margin-bottom:3px}.current{font-size:18px;font-weight:650;line-height:1.4}.state{color:var(--muted);font-size:12px;margin-top:4px}.online{display:inline-flex;align-items:center;gap:5px;color:#16835f;font-size:12px;background:#ecf8f1;padding:4px 8px;border-radius:20px;white-space:nowrap}.online:before{content:"";width:6px;height:6px;background:currentColor;border-radius:50%}.workspace{background:#fff;border:1px solid var(--line);border-radius:8px;padding:12px 14px}.regions{display:flex;align-items:center;gap:5px;flex-wrap:wrap;padding-bottom:11px;border-bottom:1px solid #edf0f5}.region{border:0;background:#f2f5f9;color:#59677b;border-radius:5px;padding:6px 12px;font-size:13px}.region:hover{background:#e7f2fb;color:var(--blue)}.region.active{background:#e7f2fb;color:var(--blue);font-weight:650}.regions select{min-width:110px;max-width:145px;border:1px solid var(--line);background:#fff;border-radius:5px;padding:5px 7px;color:#59677b;font-size:12px;margin-left:auto}.toolbar{display:flex;align-items:center;gap:8px;margin:11px 0}.search-wrap{display:flex;align-items:center;gap:6px;flex:1;border:1px solid var(--line);background:#fafbfd;border-radius:5px;padding:0 9px}.search-wrap svg{flex-shrink:0;color:#8c97a6}.search-wrap input{width:100%;min-width:0;border:0;background:transparent;outline:0;padding:7px 0;color:var(--ink);font-size:13px}.search-wrap:focus-within{border-color:#8cc8ec}.refresh{border:1px solid var(--line);background:#fff;color:#59677b;border-radius:5px;padding:6px 9px;font-size:12px;white-space:nowrap}.refresh:hover{color:var(--blue);border-color:#8cc8ec}.list-heading{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;color:var(--muted);font-size:12px}.list-heading strong{color:var(--ink);font-size:13px;font-weight:600}.nodes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.node{display:flex;align-items:center;min-width:0;height:42px;border:1px solid #e7ebf1;border-radius:5px;overflow:hidden;background:#fff}.node:hover{border-color:#a3ceea;background:#f8fbff}.node.selected{border-color:#8dc7e9;background:#edf7fe}.pick{flex:1;min-width:0;align-self:stretch;text-align:left;border:0;background:transparent;color:var(--ink);padding:0 9px;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.node.selected .pick{color:#0878b8;font-weight:650}.node.selected .pick:before{content:"";display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--blue);margin-right:5px;vertical-align:2px}.test{flex-shrink:0;max-width:67px;border:0;background:transparent;color:#8a96a6;padding:6px 7px;font-size:11px;white-space:nowrap}.test:hover{color:var(--blue);background:#eaf3fc}.test.measured{color:#16835f}.test.failed{color:#bd7857}.empty{grid-column:1/-1;text-align:center;color:var(--muted);padding:25px 10px}.pagination{display:flex;align-items:center;justify-content:space-between;margin-top:10px;font-size:11px;color:var(--muted)}.page-actions{display:flex;align-items:center;gap:7px}.page-actions button{width:25px;height:24px;border:1px solid var(--line);background:#fff;border-radius:4px;color:#59677b;padding:0;font-size:16px}.page-actions button:hover:enabled{border-color:#8cc8ec;color:var(--blue)}details{margin-top:10px;color:var(--muted);font-size:12px}summary{cursor:pointer;padding:5px 0}summary span{margin-left:8px;color:#a0a9b6;font-size:11px}details p{margin:5px 0 7px}.notice{font-size:12px;color:#0878b8;background:#eaf4fe;border-radius:5px;padding:7px 10px;margin:0 0 10px}.notice.error{color:#ac5942;background:#fff0eb}.login{border:1px solid var(--line);border-radius:8px;background:#fff;padding:18px}.login h2{font-size:16px;margin:0 0 7px}.embedded main{margin:0;padding:12px 14px}.embedded h1{display:none}@media(max-width:560px){main{padding:0 12px}.current{font-size:16px}.status-card{padding:11px 12px}.workspace{padding:10px}.region{padding:5px 8px;font-size:12px}.regions select{margin-left:0;max-width:100%;flex:1}.nodes{grid-template-columns:repeat(2,minmax(0,1fr))}.pick{font-size:12px;padding:0 7px}.test{padding:5px;font-size:10px}.pagination>span{max-width:60%}.embedded main{padding:10px}}
.service-area{text-align:right;flex-shrink:0}.service-buttons{display:flex;gap:5px;margin-top:8px}.service-buttons button{font-size:11px;padding:3px 8px;border:1px solid var(--line);border-radius:4px;background:#fff;color:#59677b}.service-buttons button:hover{color:var(--blue);border-color:#8cc8ec}.online.off{background:#edf0f4;color:#798494}.manager-tabs{display:flex;gap:18px;margin:-3px 0 12px;border-bottom:1px solid var(--line)}.manager-tabs button{border:0;border-bottom:2px solid transparent;background:transparent;color:#798494;padding:8px 2px;font-size:13px}.manager-tabs button.active{border-bottom-color:var(--blue);color:var(--blue);font-weight:600}#subscription-form label{display:block;font-weight:600;font-size:13px;margin:8px 0}#subscription-url{display:block;width:100%;padding:8px 10px;margin-bottom:12px;border:1px solid var(--line);border-radius:5px;font-size:12px}.primary{border:0;border-radius:5px;background:var(--blue);color:#fff;padding:7px 14px;font-size:13px}.small-note,#operation-message{color:var(--muted);font-size:12px;margin:12px 0 5px}.log-tools{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--muted)}#log-output{background:#f6f8fb;border:1px solid var(--line);border-radius:5px;padding:10px;font:11px/1.6 ui-monospace,monospace;white-space:pre-wrap;word-break:break-word;max-height:290px;overflow:auto}@media(max-width:560px){.current{font-size:14px}.service-buttons{gap:3px}.service-buttons button{padding:3px 5px}.state{font-size:11px}}
.log-tools{flex-wrap:wrap;gap:8px}#dns-mode{max-width:100%;min-width:0}#dns-index{min-width:0;max-width:calc(100% - 72px);flex:1}#dns-tab .log-tools label{display:flex;align-items:center;gap:8px;flex-wrap:wrap;min-width:0;max-width:100%}
.check-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:3px 0 18px}.check-head .caption{font-size:10px;letter-spacing:1.5px}.check-head h2{font-size:18px;font-weight:650;margin:0 0 4px;letter-spacing:-.3px}.check-head p{font-size:11px;color:var(--muted);margin:0}.site-sections{display:grid;grid-template-columns:1fr 1fr;gap:16px}.site-section{min-width:0}.site-section-head{display:flex;justify-content:space-between;align-items:center;margin:0 0 9px;font-size:12px}.site-section-head strong{font-family:inherit;font-size:12px;font-weight:600;line-height:1.5}.site-section-head>span{font-family:inherit;font-size:12px;font-weight:600;line-height:1.5;color:var(--ink);max-width:58%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.site-grid{display:grid;grid-template-columns:1fr;gap:8px}.site-card{color:var(--ink);display:flex;align-items:center;gap:10px;text-align:left;width:100%;min-width:0;border:1px solid #e6ebf2;background:#fff;border-radius:8px;padding:11px 12px;transition:border-color .15s,box-shadow .15s;opacity:1!important}.site-card:hover:enabled{border-color:#a4cde7;box-shadow:0 3px 12px #17385308}.site-logo{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:9px;flex-shrink:0;background:var(--brand-bg);color:var(--brand)}.site-logo svg,.site-logo img{width:23px;height:23px;fill:currentColor;object-fit:contain}.site-info{display:flex;flex-direction:column;min-width:0;flex:1}.site-info strong{font-size:13px;font-weight:600;line-height:1.5}.site-info>span{font-size:10px;color:#8b96a6;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.site-state{display:flex;flex-direction:column;align-items:flex-end;flex-shrink:0;font-size:10px;color:#9aa4b2;gap:2px}.site-result{display:flex;align-items:center;gap:4px}.site-result:before{content:"";width:5px;height:5px;background:currentColor;border-radius:50%}.site-delay{font-size:11px;font-variant-numeric:tabular-nums;line-height:1.4}.site-card.good .site-result{color:#15926a}.site-card.good .site-delay{color:#4d6577}.site-card.warn .site-result{color:#9a761c}.site-card.warn .site-delay{color:#9a761c}.site-card.bad .site-result{color:#c87958}.site-card.bad .site-delay{color:#a58c80}.site-card.testing .site-result{color:var(--blue)}.site-card.testing .site-result:before{width:7px;height:7px;border:1.5px solid #b9d9ee;border-top-color:var(--blue);background:none;animation:site-spin .8s linear infinite}.check-note{display:flex;gap:6px;align-items:baseline;font-size:10px;color:#8b96a6;margin:14px 0 2px;line-height:1.6}.check-note>span{display:inline-flex;align-items:center;justify-content:center;width:12px;height:12px;flex-shrink:0;border:1px solid #adb8c7;border-radius:50%;font-size:9px}@keyframes site-spin{to{transform:rotate(360deg)}}@media(max-width:560px){.manager-tabs{gap:13px}.site-sections{grid-template-columns:1fr;gap:18px}.site-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.site-card{flex-wrap:wrap;padding:9px;gap:7px}.site-logo{width:30px;height:30px;border-radius:7px}.site-logo svg,.site-logo img{width:20px;height:20px}.site-info strong{font-size:12px}.site-info>span{font-size:9px}.site-state{flex-direction:row;align-items:center;justify-content:space-between;width:100%;padding-top:5px;border-top:1px solid #f0f3f7}.site-result,.site-delay{font-size:10px}.check-head{margin-bottom:14px}.check-head h2{font-size:16px}.check-head p{font-size:10px;max-width:230px}.check-note{font-size:10px}}@media(prefers-reduced-motion:reduce){.site-card.testing .site-result:before{animation:none}}

.status-card{position:relative}.startup-brief{font-size:11px;color:var(--muted);line-height:1.6;text-align:right;max-width:170px}.resource-line{display:flex;align-items:baseline;flex-wrap:wrap;gap:7px}.text-link{border:0;background:transparent;color:var(--blue);font-size:11px;padding:0;line-height:1.5}.core-tools{border-top:1px solid var(--line);margin-top:18px;padding-top:13px}.core-tools strong{font-size:13px;color:var(--ink)}.core-current{font-size:13px;margin:8px 0 0}.core-tools .small-note{margin-top:6px}.memory-history{margin:0 0 14px;padding-bottom:12px;border-bottom:1px solid var(--line)}.memory-history summary{font-size:13px;color:var(--ink);font-weight:600}.memory-history summary span{font-weight:400}.memory-history .small-note{margin:7px 0}.memory-legend{display:flex;gap:14px;margin:9px 0 0;font-size:10px;color:var(--muted)}.memory-legend .core-line{color:#087ec2}.memory-legend .free-line{color:#15926a}.memory-legend .core-line:before,.memory-legend .free-line:before{content:"";display:inline-block;width:12px;height:2px;background:currentColor;margin-right:5px;vertical-align:3px}#memory-chart{width:100%;display:block;max-height:170px}#memory-chart text{font-family:inherit}@media(max-width:560px){.resource-line{gap:5px}.core-tools .log-tools{gap:6px}.memory-history summary span{font-size:10px;margin-left:4px}}
.incident-row{padding:10px 0;border-top:1px solid var(--line)}.incident-row strong{font-size:12px;font-weight:600}.incident-row p{margin:5px 0 0}#mirror-form label{display:block;font-size:12px;color:var(--muted);margin:10px 0 5px}#mirror-form input{padding:8px 10px;border:1px solid var(--line);border-radius:5px;font-size:12px;color:var(--ink);background:#fafbfd}#source-versions{background:#f4f8fc;padding:9px 10px;border-radius:5px;line-height:1.7}
.manager-tabs{gap:14px;flex-wrap:wrap}.monitor-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:14px 0}.monitor-grid>div{background:#f6f8fb;border:1px solid var(--line);border-radius:7px;padding:11px}.monitor-grid span{display:block;color:var(--muted);font-size:11px;margin-bottom:5px}.monitor-grid strong{font-size:17px;font-variant-numeric:tabular-nums}@media(max-width:560px){.monitor-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.manager-tabs{gap:10px}}
.memory-limits-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:12px 0}.memory-limits-grid label{font-size:11px;color:var(--muted)}.memory-limits-grid input{display:block;width:100%;margin-top:6px;border:1px solid var(--line);border-radius:5px;padding:7px;background:#fff;color:var(--ink)}@media(max-width:560px){.memory-limits-grid{grid-template-columns:1fr}}
@@if ax5@@
#mirror-section,main{max-width:1100px;margin:24px auto;padding:0 16px}:root{--blue:#2879da}body{background:#f5f7fa}.status-card,.workspace{border-color:#e5eaf1;box-shadow:0 2px 7px #234c7810}.manager-tabs{gap:22px}.manager-tabs button{font-size:14px}.primary{background:#2879da}.region.active{background:#e9f2ff;color:#256bc5}.node.selected{background:#f0f6ff;border-color:#9ac2f1}@media(max-width:600px){main{padding:0 12px;margin-top:14px}}
@@else@@
@@end@@
.protocol{font-size:9px;line-height:16px;border:1px solid #e1e7ef;border-radius:3px;padding:0 4px;white-space:nowrap;color:#6c7e94;background:#f7f9fc;flex-shrink:0;margin-right:2px}
.runtime-inspector{margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--line)}.inspect-search{display:flex;gap:6px;flex:1;min-width:180px}.inspect-search input{width:100%;min-width:0;box-sizing:border-box;border:1px solid var(--line);border-radius:5px;padding:7px;font:inherit}.inspect-list{display:grid;gap:5px;max-height:320px;overflow:auto}.inspect-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:8px;padding:8px 10px;background:#f7f9fc;border:1px solid var(--line);border-radius:5px;overflow-wrap:anywhere;font-size:12px}.inspect-row strong{display:block;font-weight:500}.inspect-row small{display:block;color:var(--muted);margin-top:0;font-size:11px;max-width:360px}.pagination{display:flex;justify-content:flex-end;align-items:center;gap:8px;margin-top:8px}@media(max-width:520px){.startup-brief{max-width:100px;font-size:10px}.service-area{min-width:100px}.resource-line{gap:6px}.state{overflow-wrap:anywhere}}
.maintenance{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}.maintenance>summary{cursor:pointer;font-size:12px;font-weight:500;color:var(--ink)}.maintenance .core-tools:first-of-type{margin-top:10px}.status-card .state{font-size:11px}.inspect-row small{text-align:right}@media(max-width:520px){.inspect-row{grid-template-columns:minmax(0,1fr)}.inspect-row small{text-align:left}.service-area{gap:4px}.status-card{gap:10px}}
.group-card{display:flex;flex-direction:column;align-items:flex-start;gap:3px;border:1px solid #e2e8f0;background:#fff;border-radius:7px;padding:8px 11px;min-width:130px;text-align:left;color:var(--ink)}.group-card strong{font-size:12px}.group-card span{font-size:10px;color:var(--muted)}.group-card.active{background:var(--brand-bg);border-color:#a7c9ec}.group-open{font-size:10px;border:0;background:transparent;color:var(--brand);padding:4px;white-space:nowrap}.node .pick{min-width:0}#regions{flex-wrap:wrap}#region-select{max-width:190px}.policy-heading{display:flex;align-items:baseline;gap:12px;margin:3px 0 14px}.policy-heading strong{font-size:14px}.policy-heading span{font-size:11px;color:var(--muted)}#policy-add{display:flex;gap:8px;align-items:center;flex-wrap:wrap}#policy-add input,#policy-add select{height:34px;border:1px solid #dce5ef;border-radius:6px;background:#fff;padding:5px 9px;color:var(--ink);font:inherit}#policy-domain{flex:1;min-width:140px}#policy-target{max-width:220px}.policy-arrow{color:#9ba7b8}.policy-row{display:flex;gap:10px;align-items:center;padding:11px 0;border-bottom:1px solid #eef1f5;font-size:12px}.policy-row strong{flex:1;overflow-wrap:anywhere}.policy-row small{color:var(--muted)}.policy-row button{background:transparent;border:0;color:#b57060;font-size:11px}.policy-footer{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:15px 0 20px}.policy-footer span{font-size:11px;color:var(--muted)}@media(max-width:560px){.group-card{min-width:100px;flex:1}#regions>select{width:100%;max-width:none}.policy-heading{flex-direction:column;gap:3px}#policy-domain{width:100%;flex-basis:100%}.policy-row{flex-wrap:wrap}.policy-row strong{flex-basis:100%}.policy-footer{align-items:flex-start}}.group-mode-tools{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:0 0 12px;font-size:11px;color:var(--muted)}.group-mode-tools label{display:flex;align-items:center;gap:8px}.group-mode-tools select{border:1px solid #dce5ef;border-radius:5px;padding:5px 7px;background:white;color:var(--ink);font:inherit}.group-mode-tools button{margin-left:auto}#group-mode-note{font-size:10px}.quick-policies{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:0 0 16px}.quick-policy{padding:10px;border:1px solid #e3e9f1;border-radius:7px;min-width:0;background:#fafbfe}.quick-policy strong{font-size:12px;display:block;margin:0 0 7px}.quick-policy select{width:100%;font:inherit;font-size:11px;border:1px solid #dde5ef;border-radius:5px;padding:5px;color:var(--ink);background:white}.quick-policy button{border:0;background:transparent;color:var(--brand);font-size:10px;padding:5px 0 0}.quick-policy small{font-size:10px;display:block;color:var(--muted);margin-top:4px}@media(max-width:650px){.quick-policies{grid-template-columns:repeat(2,minmax(0,1fr))}}.advanced-switch{display:flex;justify-content:space-between;align-items:center;margin:8px 0;font-size:11px;color:var(--muted)}.advanced-toolbar{display:flex;justify-content:space-between;align-items:center}.advanced-toolbar strong{font-size:14px}#advanced-message{font-size:11px;color:var(--muted);line-height:1.7}#advanced-frame{width:100%;height:650px;border:0;background:white;border-radius:8px}.quick-policy:nth-child(1){border-top:2px solid #4285f4}.quick-policy:nth-child(2){border-top:2px solid #10a37f}.quick-policy:nth-child(3){border-top:2px solid #b480de}.quick-policy:nth-child(4){border-top:2px solid #586174}.policy-icon{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:6px;margin-right:6px;color:#4285f4;background:#eaf2ff}.quick-policy:nth-child(2) .policy-icon{color:#10a37f;background:#e7f6ef}.quick-policy:nth-child(3) .policy-icon{color:#9869bf;background:#f3ebfa}.quick-policy:nth-child(4) .policy-icon{color:#586174;background:#edf0f4}.group-card{border-top:2px solid #7cb2e8}.advanced-switch button,.advanced-toolbar button{font:inherit;font-size:11px;background:#f5f8fc;border:1px solid #dce5ef;border-radius:5px;padding:5px 9px;color:var(--brand);cursor:pointer}.quick-policy{padding:8px 9px}.quick-policy strong{margin-bottom:5px}.quick-policy select{width:calc(100% - 34px);font-size:11px}.quick-policy button{width:34px;text-align:right;font:inherit;font-size:10px}.quick-policy small{display:none}.quick-policies{margin-bottom:12px}#lightweight-area .manager-tabs{margin-top:0}.policy-icon{width:19px;height:19px;background:transparent!important;margin-right:5px}.policy-icon svg{width:15px;height:15px;fill:currentColor}.quick-policy strong{display:flex;align-items:center}.quick-policy{display:grid;grid-template-columns:minmax(0,1fr) 42px;align-items:center;gap:5px}.quick-policy strong{grid-column:1/-1;margin:0 0 3px}.quick-policy select{width:100%;min-width:0}.quick-policy button{width:auto;white-space:nowrap;padding:5px 4px;border:1px solid #dce5ef;border-radius:5px;background:white;color:var(--brand);height:28px}.quick-policy.pending strong:after{content:"";width:5px;height:5px;border-radius:50%;background:#e0a340;margin-left:auto}.quick-policy button:disabled{opacity:.5}.quick-policy{display:flex;flex-direction:column;align-items:stretch;gap:6px;padding:9px 10px}.quick-policy strong{margin:0}.quick-policy select{height:30px;width:100%;box-sizing:border-box;line-height:normal}.quick-actions{display:flex;gap:8px;align-items:center;margin:-3px 0 14px;font-size:10px;color:var(--muted)}.quick-actions span{flex:1}.quick-actions button{white-space:nowrap;height:28px;padding:4px 10px;font:inherit;border:1px solid #dce5ef;border-radius:5px;background:white;color:var(--brand)}.quick-actions button:last-child{background:var(--brand);color:white;border-color:var(--brand)}.quick-actions button:disabled{opacity:.45}#quick-status.unsaved{color:#a76c13;background:#fff4dc;border:1px solid #f1ddb7;border-radius:5px;padding:4px 8px;font-weight:600}.advanced-toolbar{gap:10px;flex-wrap:wrap}.advanced-toolbar strong{margin-right:auto}.dashboard-scale{display:flex;gap:6px;align-items:center;font-size:11px;color:var(--muted)}.dashboard-scale select{font:inherit;border:1px solid var(--line);padding:4px 6px;border-radius:5px;background:white}#advanced-frame{zoom:var(--dashboard-scale,.9);width:100%;height:calc(650px / var(--dashboard-scale,.9));max-width:100%}.status-card{display:grid;grid-template-columns:minmax(0,1fr) 134px;gap:16px;align-items:start}.status-card>div:first-child{min-width:0}.service-area{display:flex;flex-direction:column;align-items:flex-end;gap:7px;min-width:0}.service-buttons{margin:0;justify-content:flex-end}.startup-brief{display:block;max-width:134px;font-size:10px;line-height:1.5}.resource-line{margin-top:3px}.status-card .state{line-height:1.6}.status-card .online{flex:none;align-self:flex-end}@media(max-width:560px){.status-card{grid-template-columns:minmax(0,1fr) auto;gap:10px;padding:12px}.startup-brief{max-width:96px}.current{font-size:16px}.resource-line{gap:5px}.status-card .state{font-size:11px}}.log-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 0 14px}.log-actions{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.log-actions button,.log-actions select{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;min-height:30px;margin:0;padding:5px 9px;font-size:12px;line-height:1.3;float:none;width:auto}.log-toolbar .small-note{margin:4px 0 0}#log-output.log-list{background:none;border:0;padding:0;max-height:none;font:inherit}.log-section{border:1px solid var(--line);border-radius:6px;margin:8px 0;overflow:hidden}.log-section summary{padding:9px 12px;background:#f7f9fc;font-size:12px;font-weight:600;cursor:pointer;display:list-item}.log-section pre{font:11px/1.7 ui-monospace,monospace;white-space:pre-wrap;overflow-wrap:anywhere;max-height:260px;overflow:auto;margin:0;padding:10px 12px}.log-empty{font-size:12px;color:var(--muted);padding:10px 12px;margin:0}@media(max-width:560px){.log-toolbar{align-items:flex-start;flex-direction:column}.log-actions{width:100%}}
/* Keep mobile navigation and automatic group members readable. */
.manager-tabs{flex-wrap:nowrap;overflow-x:auto;gap:16px;scrollbar-width:thin}.manager-tabs button{flex:0 0 auto;white-space:nowrap}.node .pick:disabled{opacity:1;color:var(--ink)}.node .protocol{color:#52647b}.group-card strong,.group-card span{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.group-card{min-width:0}.quick-policy small{display:block;color:#52647b;font-size:11px;line-height:1.5}.quick-actions{flex-wrap:wrap;align-items:center}.quick-actions span{min-width:180px;line-height:1.6}.quick-actions #quick-follow{background:white;color:var(--brand);border-color:var(--line)}@media(max-width:560px){#regions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}#region-select{grid-column:1/-1;width:100%;max-width:none}.group-card{width:100%;padding:8px 10px}.group-card strong{font-size:12px}.group-card span{font-size:11px}.nodes{grid-template-columns:1fr}.quick-actions span{flex-basis:100%}.quick-policy select{font-size:12px}.quick-policies{gap:8px}}

.quick-policy.overridden select{border-color:#d5b77b;background:#fffdf7}.quick-policy select{height:30px}.quick-policy{gap:6px}#quick-status.has-overrides{color:#88621e}.quick-actions span{min-width:0}.quick-actions #quick-follow{font-size:10px}@media(max-width:560px){.quick-actions span{flex-basis:auto;min-width:130px}.quick-actions{gap:6px}.quick-actions button{padding:4px 7px}.quick-policy{padding:8px 9px}}

.notice{display:flex;align-items:flex-start;gap:10px}.notice #msg-text{flex:1;min-width:0;overflow-wrap:anywhere}.notice #msg-close{flex:none;border:0;background:transparent;color:inherit;white-space:nowrap;font-size:19px;line-height:1;padding:1px 4px;opacity:.7}.notice #msg-close:hover{opacity:1}

.node .pick .node-owner{display:block;font-size:10px;font-weight:400;color:#65758a;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.subscription-current{border:1px solid var(--line);border-left:3px solid var(--brand);border-radius:6px;padding:9px 12px;margin:0 0 15px;background:#f8fbfe}.subscription-current strong{font-size:12px}.subscription-current p{margin:4px 0 0;line-height:1.7}

.subscription-current{padding:10px 12px;background:#f5f8fc;border:1px solid var(--line);border-radius:7px;margin-bottom:15px}.subscription-current p{margin:5px 0 0}#converter-options{padding:10px 12px;background:#f8faff;border:1px solid var(--line);border-radius:7px;margin:10px 0}#subscription-form input:not([type=checkbox]),#subscription-form select{max-width:100%;box-sizing:border-box}#converter-url,#converter-template,#subscription-ua{display:block;width:100%;border:1px solid var(--line);border-radius:6px;padding:8px 10px;font:inherit;margin:5px 0 10px}#policy-add{display:grid;grid-template-columns:minmax(140px,1fr) 110px 15px minmax(120px,180px) auto}#policy-target{width:100%;min-width:0}.policy-row{display:grid;grid-template-columns:minmax(100px,1fr) auto 12px minmax(100px,1fr) auto;gap:8px;padding:9px 0}.policy-row strong{font-size:12px}.policy-row span{overflow-wrap:anywhere}.policy-row small{font-size:10px}.policy-row button{white-space:nowrap}.policy-footer button{white-space:nowrap}.policy-footer .primary{background:var(--brand);color:white}.memory-history>summary{padding:7px 0}.monitor-grid{margin:10px 0}.manager-tabs{flex-wrap:nowrap;overflow-x:auto;white-space:nowrap}@media(max-width:560px){#policy-add{grid-template-columns:105px 12px minmax(100px,1fr) auto}#policy-domain{grid-column:1/-1;width:100%;min-width:0}#policy-add button{padding:6px 9px}.policy-row{grid-template-columns:minmax(0,1fr) 12px minmax(0,1fr) auto;row-gap:3px}.policy-row strong{grid-column:1;grid-row:1}.policy-row small{grid-column:1;grid-row:2}.policy-row .policy-arrow{grid-column:2;grid-row:1/3}.policy-row span:not(.policy-arrow){grid-column:3;grid-row:1/3;font-size:11px}.policy-row button{grid-column:4;grid-row:1/3}.policy-footer{align-items:center}.subscription-current{font-size:12px}#converter-options{padding:9px}.log-actions{gap:5px}}

/* Subscription editor: aligned controls, compact groups, single column on phones. */
#subscription-form{margin-top:16px}
#subscription-form label{font-size:13px;font-weight:600;color:var(--ink);margin:0 0 6px}
#subscription-form :is(select,input:not([type=checkbox]),textarea){width:100%;min-width:0;border:1px solid var(--line);border-radius:6px;background:#fff;color:var(--ink);font:inherit;box-sizing:border-box}
#subscription-form :is(select,input:not([type=checkbox])){height:38px;padding:7px 10px}
#subscription-form :is(select,input:not([type=checkbox]),textarea):focus{outline:2px solid #cce5fa;outline-offset:1px;border-color:var(--blue)}
.subscription-fields,.converter-fields{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;margin:14px 0}
.subscription-field{min-width:0}.subscription-field label{display:block}
#subscription-form .subscription-field input{margin-top:7px}
#subscription-form #converter-options{padding:12px 14px;border:1px solid var(--line);border-radius:8px;background:#f8fafc;margin:0 0 12px}
#subscription-form .converter-fields{margin:0 0 10px}
#subscription-form #converter-custom label{margin-top:8px}
#subscription-form .converter-auto-label{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:400;margin:0}
#subscription-form .converter-auto-label input{margin:0;width:14px;height:14px;flex:0 0 auto}
#subscription-form .converter-risk{font-size:11px;line-height:1.6;color:#9a653f;margin:8px 0 0}
#subscription-form .subscription-exclusion{border:1px solid var(--line);border-radius:7px;padding:9px 12px;margin:12px 0;background:#fafbfd}
#subscription-form .subscription-exclusion summary{font-size:12px;font-weight:600;color:var(--ink);cursor:pointer}
#subscription-form #subscription-exclude-status{font-size:11px;font-weight:400;margin-left:6px}
#subscription-form .subscription-exclusion textarea{margin-top:8px;padding:8px;font-size:12px;line-height:1.6}
#subscription-form .subscription-exclusion .small-note{margin:5px 0 0;font-size:11px}
#subscription-help{margin:10px 0;color:var(--muted);font-size:12px;line-height:1.6}
#subscription-form .subscription-preview{border:1px solid var(--line);background:#f6f9fc;border-radius:7px;padding:10px 12px;margin:12px 0}
#subscription-form .subscription-preview .log-tools{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}
#subscription-form .subscription-preview strong{font-size:12px}
#subscription-defaults{font-size:12px;line-height:1.7;margin:8px 0 0}
#subscription-parameters-details{margin-top:6px;font-size:11px;color:var(--muted)}
#subscription-form>details:not(.subscription-exclusion){font-size:11px;color:var(--muted);margin:10px 0}
#subscription-form #subscription-update{margin-top:4px;min-height:36px;padding:7px 16px}
@media(max-width:600px){.subscription-fields,.converter-fields{grid-template-columns:minmax(0,1fr);gap:12px}#subscription-form #converter-options{padding:10px}#subscription-form .subscription-preview{padding:9px 10px}#subscription-form .subscription-preview .log-tools button{font-size:11px}}

.proxy-mode-control{display:block;margin-top:6px}.proxy-mode-control select{max-width:100%;font:inherit;font-size:11px;padding:3px 7px;border:1px solid var(--line);border-radius:5px;background:#fff;color:var(--ink)}.proxy-mode-control select.mode-override{color:#a96610;background:#fff7e6;border-color:#f2d39b}
.remote-fields{display:grid;grid-template-columns:2fr 1fr 80px;gap:10px}.remote-fields input{width:100%;box-sizing:border-box}#mirror-form input[type=checkbox]{width:auto}#mirror-form button{white-space:nowrap;flex-shrink:0}@media(max-width:560px){.remote-fields{grid-template-columns:1fr 80px}.remote-fields>div:first-child{grid-column:1/-1}}
.backup-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:12px 0 20px}.backup-heading h2{font-size:17px;margin:0}.backup-heading p{margin:5px 0 0}.backup-badge{padding:4px 9px;border-radius:14px;background:#f0f3f8;color:var(--muted);font-size:11px;white-space:nowrap}.backup-badge.ready{background:#e9f7f0;color:#16825b}.backup-switch{display:flex!important;align-items:center;gap:7px;font-weight:600;color:var(--ink)!important;margin:0 0 16px!important}.backup-fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.backup-fields .backup-address{grid-column:1/-1}.backup-fields input{width:100%;box-sizing:border-box}.backup-actions{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0 0}.backup-actions button{white-space:nowrap}.backup-exports{border-top:1px solid var(--line);padding-top:18px;margin-top:22px}.backup-help{margin-top:16px;padding-top:14px;border-top:1px solid var(--line)}@media(max-width:560px){.backup-fields{grid-template-columns:1fr}.backup-heading{align-items:flex-start}.backup-actions button{font-size:12px}}
.remote-home{font-size:10px;white-space:nowrap;color:#16825b;margin-right:6px}.remote-versions{border-top:1px solid var(--line);margin-top:18px;padding-top:15px}.remote-versions strong{font-size:12px}.remote-versions p{white-space:pre-line;overflow-wrap:anywhere}#mirror-save.dirty{box-shadow:0 0 0 2px #dceaff}.backup-download{display:inline-flex;align-items:center;padding:6px 10px;border:1px solid var(--line);border-radius:5px;font-size:12px}
.status-card{grid-template-columns:minmax(0,1fr) auto;gap:10px 18px}.status-card .service-area{gap:6px;min-width:100px}.status-card .resource-line{margin-top:6px}.status-footer{grid-column:1/-1;border-top:1px solid var(--line);padding-top:9px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 12px;align-items:center}.status-meta{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.status-meta .startup-brief{max-width:none;font-size:11px;line-height:1.5}.status-meta .remote-home{margin:0;font-size:11px}.mode-bar{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--muted)}.mode-bar select{font:inherit;color:var(--ink);border:1px solid var(--line);border-radius:5px;padding:4px 7px;background:white;min-width:96px}.mode-bar select.mode-override{color:#98600b;background:#fff7e6;border-color:#f2d39b}.mode-help{grid-column:1/-1;margin:0;font-size:11px;line-height:1.6;color:var(--muted)}.mode-help.override{color:#98600b}.mode-scope{grid-column:1/-1;margin:0;font-size:10px;color:var(--muted)}.mode-scope summary{cursor:pointer}.mode-scope p{margin:5px 0 0;line-height:1.7}.advanced-switch{gap:12px;margin:0 0 12px;padding:0 0 9px;border-bottom:1px solid var(--line)}.advanced-switch>div{min-width:0;display:flex;gap:8px;align-items:center;flex-wrap:wrap}.advanced-switch strong{font-size:11px;color:var(--ink)}.advanced-hint{font-size:10px;line-height:1.5}.advanced-switch button{flex:none;display:inline-flex;gap:5px;align-items:center;justify-content:center;white-space:nowrap;height:30px;padding:5px 10px;background:#f5f8fc;border:1px solid var(--line);border-radius:5px;font:inherit;font-size:11px;color:var(--brand);cursor:pointer}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:560px){.status-footer{grid-template-columns:minmax(0,1fr);gap:7px}.mode-bar{justify-content:space-between}.mode-bar select{min-width:132px}.status-meta{gap:6px 12px}.advanced-switch>div{display:block}.advanced-hint{display:block;margin-top:3px}.status-card .service-area{min-width:83px}.status-card{gap:10px}}
.backup-recovery{border-top:1px solid var(--line);padding-top:14px;margin-top:18px}.recovery-dialog{box-sizing:border-box;width:min(720px,calc(100% - 24px));max-height:calc(100dvh - 28px);padding:22px;border:1px solid var(--line);border-radius:12px;color:var(--ink);background:#fff;overflow:auto}.recovery-dialog::backdrop{background:rgba(20,32,50,.45)}.recovery-dialog h2{margin:0;font-size:18px;color:var(--ink)}.recovery-dialog .recovery-close{min-width:38px}.recovery-dialog label{display:block;font-size:12px;font-weight:600;margin:14px 0 6px}.recovery-dialog input,.recovery-dialog select{box-sizing:border-box;width:100%;padding:9px;border:1px solid var(--line);border-radius:6px;background:#fff;color:inherit;font:inherit;font-size:13px}.recovery-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.recovery-file{padding:12px 0;border-bottom:1px solid var(--line);font-size:12px;line-height:1.7}.recovery-file strong{display:block}.recovery-file code{display:block;color:var(--muted);overflow-wrap:anywhere;font-size:11px}.recovery-dialog .backup-actions{margin-top:18px;flex-wrap:wrap}.recovery-scope{margin:14px 0;padding:12px;border-radius:6px;background:#f5f8fc;font-size:12px;line-height:1.8}.recovery-dialog [hidden]{display:none!important}@media(max-width:520px){.recovery-dialog{padding:16px}.recovery-grid{grid-template-columns:1fr;gap:0}.recovery-dialog .backup-actions button{flex:1}}.backup-paths{font-size:12px;line-height:1.65;margin:10px 0}.backup-paths dt{color:var(--muted);margin-top:8px}.backup-paths dd{margin:2px 0 0;overflow-wrap:anywhere;word-break:break-word;font-family:monospace}.baseline-section{border-top:1px solid var(--line);padding-top:14px;margin-top:20px}.backup-feedback{margin:10px 0 6px;padding:9px 12px;border-radius:6px;font-size:12px;line-height:1.6;overflow-wrap:anywhere;background:#edf5ff;color:#2467a6;border:1px solid #cddff7}.backup-feedback.success{background:#e9f7f0;color:#16754d;border-color:#bce6d1}.backup-feedback.error{background:#fff0ec;color:#b33e2b;border-color:#f2c0b4}.backup-feedback.working{background:#fff8e5;color:#886315;border-color:#eedda4}.backup-feedback[hidden]{display:none!important}.operation-result{border:1px solid #a6d9c7;background:#edf8f2;color:#146849!important;border-radius:6px;padding:10px 12px;line-height:1.7}.operation-result.error{border-color:#edc1b5;background:#fff1ec;color:#a4472e!important}.operation-result.warning{border-color:#e6d299;background:#fff9e9;color:#806219!important}.operation-result.pending{border-color:#c2d8ee;background:#f0f6fc;color:#336894!important}
.test.partial{color:#9a761c;max-width:86px}
.region-mark{display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:650;line-height:1.2;border:1px solid #d7e3f2;border-radius:3px;padding:1px 3px;margin-right:4px;vertical-align:1px;color:#557298;background:#f2f6fc}
.transport-settings{border-bottom:1px solid var(--line);padding:0 0 14px;margin-bottom:16px}.transport-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}.transport-controls{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.transport-controls select{width:210px;max-width:100%;border:1px solid var(--line);border-radius:6px;padding:7px 10px;font:inherit;background:white;color:var(--ink)}.transport-controls button{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;float:none;margin:0;min-height:32px}.transport-controls .primary{background:var(--brand);border-color:var(--brand);color:white}.transport-controls .changed{border-color:#d49d36;background:#fffaf0}.transport-settings p{margin:7px 0 0;line-height:1.6}@media(max-width:560px){.transport-heading{align-items:flex-start;flex-direction:column}.transport-controls select{flex:1;min-width:150px}.transport-controls button{font-size:11px;padding:7px 9px}}
.kernel-traffic{grid-column:1/-1;display:flex;align-items:center;flex-wrap:wrap;gap:8px 18px;margin-top:0;font-size:11px;font-variant-numeric:tabular-nums}.traffic-pair{display:flex;align-items:baseline;gap:7px}.traffic-pair b{display:inline-block;min-width:7ch;font-size:12px;font-weight:600;color:#34415a;white-space:nowrap}.traffic-caption{color:#8390a3}.traffic-state-tag:empty{display:none}.traffic-state-tag{font-size:10px;color:#8995a7}.traffic-details{font-size:11px;white-space:nowrap}@media(max-width:600px){.kernel-traffic{gap:5px 12px}.traffic-pair{gap:5px}.traffic-pair b{font-size:11px;min-width:6ch}.traffic-state-tag{margin-left:0}}

.exit-ip,.subscription-quota{border:1px solid var(--line);border-radius:7px;padding:10px 12px;margin:12px 0;background:#fafcfe}.ip-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:9px}.ip-grid>div{min-width:0}.ip-grid span{display:block;font-size:11px;color:var(--muted)}.ip-grid small{display:block;font-size:11px;color:var(--muted);line-height:1.6;overflow-wrap:anywhere}.ip-grid .ipv6-exit{grid-column:1/-1;border-top:1px solid var(--line);padding-top:6px}.ip-grid strong{display:block;font:600 12px/1.6 ui-monospace,monospace;overflow-wrap:anywhere}.subscription-quota progress{width:100%;height:7px;accent-color:#139b76}.subscription-quota .good{color:#07855c}.subscription-quota .bad{color:#b65835}.exit-ip .small-note,.subscription-quota .small-note{margin:5px 0 0}
#zt-log{white-space:pre-wrap;overflow-wrap:anywhere}
.node-diagnostic{border:1px solid var(--line);border-radius:8px;padding:12px;margin:12px 0}.node-diagnostic-values{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.node-diagnostic-values>div{display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:0}.node-diagnostic-values span{font-size:11px;color:var(--muted)}.node-diagnostic-values strong,#node-diagnostic-name{overflow-wrap:anywhere;max-width:100%}.node-diagnostic .small-note{line-height:1.6}@media(max-width:560px){.node-diagnostic-values{grid-template-columns:1fr}}
 .proxy-access{padding:20px;border:1px solid var(--line);border-radius:14px;margin:16px 0 24px;background:var(--paper,#fff)}
 .access-heading{display:flex;justify-content:space-between;align-items:center;gap:16px}.access-heading h3{margin:0 0 6px}.access-heading p{margin:0;color:var(--muted);font-size:12px;line-height:1.6}.access-switch{display:flex;align-items:center;gap:8px;white-space:nowrap;font-size:13px}.access-switch input{appearance:none;width:38px;height:22px;border-radius:20px;background:#c9ced6;position:relative;cursor:pointer;flex-shrink:0;transition:background .15s}.access-switch input:before{content:"";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff;box-shadow:0 1px 3px #0002;transition:transform .15s}.access-switch input:checked{background:#238264}.access-switch input:checked:before{transform:translateX(16px)}.access-switch input:disabled{cursor:default;opacity:.55}.access-switch input:focus-visible{outline:2px solid var(--blue);outline-offset:3px}
 .access-status{display:flex;align-items:flex-start;gap:10px;margin:18px 0 14px;padding:13px 15px;border:1px solid #ecd7b5;border-radius:10px;background:#fff8eb;color:#866022;font-size:13px;line-height:1.6}.access-status:before{content:"";width:7px;height:7px;flex:none;margin-top:7px;background:currentColor;border-radius:50%}.access-status[data-state=on]{background:#edf8f2;border-color:#bddfcb;color:#256449}.access-status[data-state=error]{background:#fff1ee;border-color:#edc6bd;color:#a74332}.access-status[data-state=busy]{background:#eff6ff;border-color:#c4d9ef;color:#315f8c}.access-footer{display:flex;align-items:center;justify-content:space-between;gap:14px}.access-footer span{color:var(--muted);font-size:12px}
 .access-dialog{width:min(720px,calc(100vw - 32px));max-height:calc(100dvh - 40px);box-sizing:border-box;padding:0;border:1px solid var(--line);border-radius:16px;background:var(--paper,#fff);color:var(--ink,#202a36);box-shadow:0 24px 80px #101d3540}.access-dialog[open]{display:flex;flex-direction:column;overflow:hidden}.access-editor-head,.access-editor-actions{flex-shrink:0}.access-dialog::backdrop{background:#15223966}.access-editor-head{padding:22px 24px 14px;border-bottom:1px solid var(--line)}.access-editor-head h3{margin:0 0 7px}.access-editor-head p{margin:0;color:var(--muted);font-size:12px;line-height:1.6}.access-editor-body{padding:18px 24px;overflow-y:auto;min-height:0}.access-editor-actions{position:sticky;bottom:0;display:flex;justify-content:flex-end;gap:10px;padding:15px 24px;background:var(--paper,#fff);border-top:1px solid var(--line)}.access-editor-actions button{min-width:96px}.access-editor-note{font-size:12px;color:#96641d;margin:10px 0 0}.access-dialog textarea{display:block;width:100%;box-sizing:border-box;margin:10px 0;padding:10px;border:1px solid var(--line);border-radius:8px;font:inherit;line-height:1.6;resize:vertical}.access-dialog details{border-top:1px solid var(--line);padding-top:14px;margin-top:16px}.access-devices{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:10px;margin:14px 0}.access-device{display:flex;align-items:flex-start;gap:10px;padding:13px;border:1px solid var(--line);border-radius:10px;cursor:pointer;transition:background .15s,border-color .15s}.access-device:has(input:checked){border-color:var(--blue);background:#f0f7ff}.access-device input{margin:4px 0 0;accent-color:var(--blue)}.access-device>span{display:grid;gap:4px;flex:1;min-width:0}.access-device strong{overflow-wrap:anywhere;font-size:13px}.access-device span span{font-size:12px}.access-device small{color:var(--muted);font-size:11px}.access-device>small{max-width:64px;text-align:right;line-height:1.5}
 @media(max-width:520px){.proxy-access{padding:16px}.access-heading{align-items:flex-start}.access-heading p{max-width:210px}.access-editor-head,.access-editor-body{padding:18px}.access-editor-actions{padding:14px 18px}.access-footer{align-items:flex-start}.access-dialog{max-height:calc(100dvh - 24px)}}
</style></head><body><main>
<h1>ShellCrash</h1>
<section id="login" class="login" hidden><h2>打开管理入口</h2><p>登录路由器后台后，页面会自动连接。</p><a id="router-entry" target="_top">前往路由器后台</a></section>
<div id="msg" class="notice" role="status" hidden><span id="msg-text"></span><button id="msg-close" type="button" aria-label="关闭提示" title="关闭提示">×</button></div>
<div id="panel" hidden>
<p id="memory-protection" class="small-note" hidden></p><section class="status-card"><div><div class="caption">主策略组</div><div id="current" class="current">—</div><div id="state" class="state"></div><div class="resource-line"><span id="resources" class="state"></span><button id="incident-open" class="text-link">异常详情</button><button id="memory-open" class="text-link" title="查看每分钟内存记录">趋势</button></div></div><div class="service-area"><span id="online" class="online">连接中</span><div class="service-buttons"><button id="service-start" hidden>启动</button><button id="service-stop">停止</button><button id="service-restart">重启</button></div></div><div class="kernel-traffic" aria-label="内核处理流量，包含直连" title="包括内核代理与DIRECT直连；绕过内核的流量不计入。累计从本次内核启动开始。"><span class="traffic-pair"><span class="traffic-caption">内核实时 ↑</span><b id="traffic-up">采样中</b><span class="traffic-caption">↓</span><b id="traffic-down">采样中</b></span><span class="traffic-pair"><span class="traffic-caption">内核累计↑</span><b id="traffic-up-total">待统计</b><span class="traffic-caption">↓</span><b id="traffic-down-total">待统计</b></span><span id="traffic-scope" class="traffic-caption">当前含直连</span><span id="traffic-sample-state" class="traffic-state-tag" role="status"></span><a id="traffic-connections" class="traffic-details" href="#runtime-inspection">连接明细 ›</a></div><div class="status-footer"><div class="status-meta"><span id="traffic-state" class="startup-brief"></span><span id="startup-state" class="startup-brief" aria-live="polite"></span><span id="remote-home" class="remote-home" hidden></span></div><div class="mode-bar"><label for="proxy-mode">流量模式</label><select id="proxy-mode" aria-label="代理运行模式" aria-describedby="proxy-mode-help" disabled><option value="rule">规则分流</option><option value="direct">直连上网</option><option value="global">全局 TCP 代理</option></select></div><p id="proxy-mode-help" class="mode-help" role="status"></p><details class="mode-scope"><summary>作用范围</summary><p id="proxy-mode-scope">规则与全局主要接管外网 IPv4 TCP；局域网、ZeroTier 与内核自身保留必要例外。普通 UDP 未完整接管。直连关闭透明代理与 DNS 接管，但不退出内核。旧连接和客户端 DNS 缓存可能需要重新建立。内核重启后恢复规则分流。节点测速是指定节点测试，不用于验证分流。</p></details></div></section>
<section class="workspace" aria-label="选择代理节点">
<div class="advanced-switch"><div><strong>轻量面板</strong><span class="advanced-hint">高级面板共用当前内核；打开后暂停本页操作</span></div><button id="advanced-open" type="button" aria-describedby="advanced-entry-help">打开高级面板 <span aria-hidden="true">↗</span></button><span id="advanced-entry-help" class="sr-only">查看策略组、规则与连接，返回后同步选择。文件按需下载到内存。</span></div><section id="advanced-area" hidden><div class="advanced-toolbar"><strong id="advanced-title">高级面板</strong><label class="dashboard-scale">显示比例 <select id="dashboard-scale" aria-label="高级面板显示比例"><option value="0.75">75%</option><option value="0.85">85%</option><option value="0.9" selected>90%（默认）</option><option value="1">100%</option></select></label><button id="advanced-close">返回轻量面板</button></div><p id="advanced-message">轻量面板的操作与测速已暂停。规则和节点使用同一个内核；这里不提供覆盖配置、更新订阅或修改 DNS。流量图和实时日志暂不接入。</p><iframe id="advanced-frame" title="YACD 高级面板" hidden></iframe></section><div id="lightweight-area"><nav class="manager-tabs"><button id="tab-nodes" class="active">节点</button><button id="tab-checks">检测</button><button id="tab-subscription">配置</button><button id="tab-backup">备份</button><button id="tab-rules">规则</button><button id="tab-dns">DNS</button><button id="tab-monitor">监控</button><button id="tab-logs">运行日志</button></nav><div id="nodes-tab"><div id="stopped" class="empty" hidden>服务已停止。点击上方“启动”即可恢复。</div><div id="nodes-content"><div id="quick-policies" class="quick-policies" aria-label="常用网站分流"></div><div class="quick-actions"><span id="quick-status"></span><button id="quick-follow" type="button" hidden>全部跟随订阅</button><button id="quick-cancel" hidden>取消修改</button><button id="quick-save" hidden>保存分流</button></div><nav id="regions" class="regions" aria-label="策略组"></nav>
<div class="toolbar"><label class="search-wrap"><svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><input id="search" type="search" placeholder="搜索全部节点，如 台湾 AnyTLS、HK01" aria-label="搜索全部节点"></label><button id="refresh" class="refresh" title="刷新运行状态"><svg width="13" height="13" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16 7a6.5 6.5 0 1 0 .4 5M16 3v4h-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg> 刷新</button></div>
<div class="list-heading"><strong id="list-title"></strong><div><span id="list-count"></span> · HTTPS 耗时</div></div>
<div class="group-mode-tools"><span id="group-mode-note"></span></div><div id="nodes" class="nodes"></div>
<div class="pagination"><span id="node-list-help">点击成员切换当前组 · 展开查看下级组</span><div class="page-actions"><button id="previous" aria-label="上一页">‹</button><span id="page-number"></span><button id="next" aria-label="下一页">›</button></div></div>
<section id="node-diagnostic" class="node-diagnostic" hidden aria-label="节点诊断"><div class="log-tools"><strong>节点诊断</strong><button id="node-diagnostic-close" type="button" class="text-link">收起</button></div><p id="node-diagnostic-name" class="small-note"></p><div class="node-diagnostic-values"><div><span>到节点服务器的 Ping</span><strong id="node-ping-value">尚未检测</strong><button id="node-ping-run" type="button" class="refresh">测节点 Ping</button></div><div><span>经节点访问 Gstatic 的 HTTPS 耗时</span><strong id="node-https-value">尚未检测</strong><button id="node-https-run" type="button" class="refresh">重测 HTTPS</button></div></div><p class="small-note">Ping 是路由器到节点服务器的往返时间；HTTPS 包含节点出口到测试站及握手。两者范围不同，不能相减判断握手成本。未取得 ICMP 响应不代表代理不可用；IPv6 地址、链式出站等暂不提供此项参考。每次只测一项，不切换节点，结果两分钟后过期。</p></section>
@@if ax5@@
</div></div><div id="checks-tab" hidden><div class="check-head"><div><div class="caption">CONNECTIVITY</div><h2>网络连通检测</h2><p id="sites-summary">通过当前内核规则访问网站</p></div><button id="sites-run" class="refresh"><svg width="13" height="13" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16 7a6.5 6.5 0 1 0 .4 5M16 3v4h-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg> 全部检测</button></div><section class="exit-ip"><div class="log-tools"><strong>出口 IP</strong><button id="ip-check" class="refresh" type="button">检测 IP</button></div><div class="ip-grid"><div><span>国内网站出口 · IPIP</span><strong id="ip-cn">尚未检测</strong><small id="ip-geo-cn"></small></div><div><span>国外网站出口 · IP.SB / IPify</span><strong id="ip-world">尚未检测</strong><small id="ip-geo-world"></small></div><div class="ipv6-exit"><span>IPv6 出口</span><strong id="ip-v6">尚未检测</strong><small id="ip-geo-v6"></small></div></div><p id="ip-summary" class="small-note" role="status">检测当前浏览器的公网出口；不代表所有网站都使用同一出口。</p></section><div class="site-sections"><section class="site-section"><div class="site-section-head"><strong>国内网站</strong><span>当前规则</span></div><div id="sites-cn" class="site-grid"></div></section><section class="site-section"><div class="site-section-head"><strong>国外网站</strong><span id="site-route">当前节点</span></div><div id="sites-world" class="site-grid"></div></section></div><p class="check-note"><span>i</span> 只检测网络是否可达和 HTTPS 请求耗时，不判断网站登录或地区解锁。切换模式后旧结果清空。</p></div><div id="subscription-tab" hidden><section class="subscription-current"><strong>最近成功加载的订阅</strong><p id="subscription-current" class="small-note" style="white-space:pre-line;overflow-wrap:anywhere">正在读取…</p></section><button id="subscription-restore-draft" type="button" class="refresh" hidden>恢复旧浏览器草稿</button><section class="transport-settings"><div class="transport-heading"><strong>流量接管方式</strong><span id="transport-state" class="small-note"></span></div><div class="transport-controls"><select id="transport-mode" aria-label="流量接管方式"><option value="redir">Redir · TCP</option><option value="mixed">混合 · TCP + UDP</option></select><button id="transport-save" class="refresh" type="button" disabled>应用并重启 ShellCrash</button></div><p id="transport-result" class="small-note" role="status"></p></section><section class="subscription-quota"><div class="log-tools"><strong>订阅余量</strong><button id="quota-refresh" class="refresh" type="button">查询余量</button></div><p id="quota-summary" class="small-note" role="status">服务商未提供用量数据时无法显示余量。</p><progress id="quota-progress" max="100" value="0" hidden aria-label="订阅已使用流量"></progress><p id="quota-detail" class="small-note"></p></section><form id="subscription-form"><label for="subscription-url">代理订阅链接</label><input id="subscription-url" type="url" autocomplete="off" spellcheck="false" placeholder="https://…" required><div class="subscription-fields"><div class="subscription-field"><label for="subscription-method">获取方式</label><select id="subscription-method"><option value="direct">从订阅地址直接下载（默认）</option><option value="convert">通过转换服务下载</option><option value="panel">面板直接下载（兼容）</option></select></div><div id="subscription-ua-field" class="subscription-field"><label for="subscription-ua-mode">User-Agent</label><select id="subscription-ua-mode"><option value="">沿用 ShellCrash（默认）</option><option value="clash-verge/v2.4.5">clash-verge/v2.4.5</option><option value="clash.meta/1.19.20">clash.meta/1.19.20</option><option value="Clash">Clash</option><option value="v2rayN">v2rayN</option><option value="custom">自定义</option></select><input id="subscription-ua" placeholder="填写自定义 User-Agent" maxlength="128" autocomplete="off" hidden></div></div><div id="converter-options" hidden><div class="converter-fields"><div class="subscription-field"><label for="converter-server">转换服务</label><select id="converter-server"><option value="0">使用 ShellCrash 当前选择</option><option value="asailor">api.asailor.org</option><option value="custom">自定义转换服务</option></select><div id="converter-custom" hidden><label for="converter-url">转换服务地址</label><input id="converter-url" type="url" placeholder="https://api.asailor.org" autocomplete="off" maxlength="512"></div></div><div class="subscription-field"><label for="converter-template-mode">规则模板</label><select id="converter-template-mode"><option value="">沿用 ShellCrash（默认）</option><option value="https://raw.githubusercontent.com/Aethersailor/Custom_OpenClash_Rules/main/cfg/Custom_Clash_Full.ini">Aethersailor · Full · 需完整 Geo 数据库</option><option value="https://raw.githubusercontent.com/Aethersailor/Custom_OpenClash_Rules/main/cfg/Custom_Clash_Lite.ini">Aethersailor · Lite · 需核对数据库</option><option value="custom">自定义模板地址</option></select><input id="converter-template" hidden type="url" placeholder="https://…/Custom_Clash_Full.ini" autocomplete="off" maxlength="2048"></div></div><label class="converter-auto-label"><input id="converter-auto" type="checkbox" checked> 失败后依次尝试ShellCrash 列表中的其他服务</label><p class="converter-risk">转换服务来自互联网，请自行斟酌。订阅地址会发送给所选服务；自动切换可能发送给多家服务。接口预检不含订阅。</p></div><details class="subscription-exclusion"><summary>排除节点 <span id="subscription-exclude-status" class="small-note">未设置</span></summary><textarea id="subscription-exclude" rows="3" spellcheck="false" aria-label="节点排除条件" placeholder="每行一条，例如：海外用户" style="width:100%;box-sizing:border-box;resize:vertical;padding:8px;border:1px solid var(--line);border-radius:5px;font:inherit"></textarea><p class="small-note">每行一条，自动识别关键字或正则；下次更新订阅时生效，留空取消。</p></details><p id="subscription-help" class="small-note"></p><section class="subscription-preview"><div class="log-tools"><strong>下次更新参数（预览）</strong><button id="subscription-defaults-refresh" type="button" class="refresh">刷新工具参数</button></div><p id="subscription-defaults" class="small-note" style="white-space:pre-line;overflow-wrap:anywhere" role="status">正在读取 ShellCrash 设置…</p><details id="subscription-parameters-details" hidden><summary>转换参数</summary><p id="subscription-parameters" class="small-note" style="overflow-wrap:anywhere"></p></details></section><details><summary>获取和加载流程</summary><p class="small-note">调用 ShellCrash 获取当前内核格式。完整配置保留订阅策略组与模板规则；仅有节点时采用兼容解析。本机 DNS 与自定义域名分流独立保留。候选校验成功后才替换，失败继续使用当前配置。</p></details><button id="subscription-update" class="primary" type="submit">更新订阅</button><p id="subscription-error" class="small-note" role="alert" hidden style="white-space:pre-wrap;overflow-wrap:anywhere;color:#ac5942;background:#fff1ec;padding:10px;border-radius:5px"></p></form><p id="operation-message" role="status"></p><section class="core-tools"><strong>启动与守护</strong><p id="startup-source" class="small-note"></p><div class="toolbar"><label for="guard-mode">守护模式</label><select id="guard-mode"><option value="procd">系统守护（procd）</option><option value="conservative">每分钟检测（保守模式）</option></select><button id="guard-save" class="refresh" type="button">保存并应用</button></div><p class="small-note">与工具的保守模式设置同步；只运行一套守护。切换时代理短暂重启，保留开机启动设置；手动停止后不恢复。</p><p id="guard-result" class="small-note" role="status"></p></section><details class="maintenance"><summary>内核与工具维护</summary><section class="core-tools"><div class="log-tools"><strong>ShellCrash 工具</strong><div><button id="tool-check" class="refresh">检查正式版</button> <button id="tool-update" class="refresh">更新工具</button></div></div><p id="tool-current" class="small-note"></p><p id="tool-message" class="small-note" role="status"></p><p class="small-note">只更新官方 stable 正式版。同版本不替换；保留配置、面板与适配，兼容校验不通过则保留旧版。工具更新不重启代理或其他服务。</p></section><section class="core-tools"><div class="log-tools"><strong>代理内核</strong><div><select id="core-kind" aria-label="内核"><option value="singbox">sing-box</option><option value="meta">mihomo</option></select> <button id="core-check" class="refresh">检查内核更新</button> <button id="core-update" class="refresh" disabled>安装 / 更新</button></div></div><p id="core-current" class="core-current">sing-box mini</p><p id="core-summary" class="small-note"></p><p id="core-message" class="small-note" role="status"></p><p class="small-note">调用 ShellCrash 适配源，校验通过后替换本地内核包，再同步镜像。失败恢复旧版；闪存只容纳一个内核包时，替换前须确认旧版可回退。开机不查询新版本。工具索引可能高于 mini 包实际版本，运行版本以安装校验为准。</p></section></details></div><div id="backup-tab" hidden><section class="backup-heading"><div><h2>备份</h2><p class="small-note">备份当前应用、内核与资源；基础恢复点独立保留</p></div><span id="backup-badge" class="backup-badge">已关闭</span></section><form id="mirror-form" novalidate><label class="backup-switch"><input id="remote-enabled" type="checkbox">开启 WebDAV 备份与恢复</label><div class="backup-fields"><div class="backup-address"><label for="mirror-base">WebDAV 地址</label><input id="mirror-base" type="url" placeholder="https://dav.example.com/backup" autocomplete="off"></div><div><label for="remote-user">账号</label><input id="remote-user" autocomplete="off" placeholder="WebDAV 账号"></div><div><label for="remote-password">密码</label><input id="remote-password" type="password" autocomplete="new-password" placeholder="WebDAV 密码"><span id="backup-password-state" class="small-note"></span></div></div><p id="backup-http-note" class="small-note" hidden>HTTP 为明文传输，仅用于可信内网；公网建议 HTTPS。</p><div class="backup-actions"><button id="mirror-verify" type="button" class="refresh">测试连接</button><button id="mirror-save" type="submit" class="primary">保存设置</button></div><p id="mirror-message" class="backup-feedback" role="status" aria-live="polite" hidden></p><p id="mirror-status" class="small-note" role="status"></p><section class="remote-versions"><div class="log-tools"><strong>最新远端备份</strong><button id="remote-versions-refresh" class="refresh" type="button">刷新记录</button></div><p id="remote-versions" class="small-note">尚未读取</p></section><div class="backup-exports"><div><strong>手动备份</strong><p class="small-note">WebDAV 分组件保存完整备份；本地导出是应用与配置 .tar.gz。</p></div><div class="backup-actions"><button id="mirror-sync" type="button" class="refresh">完整备份到 WebDAV</button><button id="backup-local" type="button" class="refresh">导出应用与配置</button><button id="backup-core" type="button" class="refresh">另存内核</button></div></div><section class="backup-recovery"><div class="log-tools"><strong>恢复备份</strong><button id="backup-restore" type="button" class="refresh">选择备份</button></div><p class="small-note">先查看来源和组件，再校验文件。检查不会改动当前配置。</p></section><details id="backup-locations" class="backup-help"><summary>文件存放位置</summary><p id="backup-path-state" class="small-note"></p><dl class="backup-paths"><dt>日常备份</dt><dd id="backup-path-latest"></dd><dt>基础备份（独立保留）</dt><dd id="backup-path-baseline"></dd><dt>手动恢复目录</dt><dd id="backup-path-imports"></dd></dl><p class="small-note">手动放入时，每份备份使用一个子目录，保留 manifest.json 与原文件名；不要覆盖日常备份和基础备份目录。</p></details><details id="baseline-section" class="backup-help baseline-section"><summary>基础备份</summary><p class="small-note">确认当前使用正常后创建。日常备份不会覆盖它；更新基础备份是重新保存当前状态，不是恢复。</p><p id="baseline-version" class="small-note">尚未读取基础备份</p><div class="backup-actions"><button id="baseline-create" type="button" class="refresh" disabled>创建基础备份</button><button id="baseline-restore" type="button" class="refresh">恢复基础备份</button></div></details><details class="backup-help"><summary>备份范围与文件说明</summary><p class="small-note">完整 WebDAV 备份：应用、ShellCrash、内核、已安装面板与规则资源，以及订阅、DNS、分流和启动设置。各文件用途可在恢复窗口查看，包内也附说明。</p><p class="small-note">本地导出为应用与配置 .tar.gz，不含内核和临时资源。备份含订阅与节点密码，请妥善保管；不含固件、SSH/WebDAV 凭据及 ZeroTier 身份。恢复保留当前连接凭据，不更改 LAN 或 Wi-Fi。</p></details></form></div><div id="rules-tab" hidden><section class="proxy-access"><div class="access-heading"><div><h3>代理设备白名单</h3><p>按设备分配代理权限，名单外设备仍可直连。</p></div><label class="access-switch"><input id="proxy-access-enabled" type="checkbox" aria-label="启用设备白名单"><span>启用</span></label></div><p id="proxy-access-result" class="access-status" role="status" aria-live="polite" data-state="off">正在读取当前设置…</p><div class="access-footer"><span id="proxy-access-summary">名单尚未读取</span><button id="proxy-access-edit" type="button" class="refresh">设置并开启</button></div><dialog id="proxy-access-editor" class="access-dialog" aria-labelledby="proxy-access-editor-title"><div class="access-editor-head"><h3 id="proxy-access-editor-title">选择允许使用代理的设备</h3><p>按 IP 查找设备，核对名称与 MAC；优先按 MAC 匹配，换 IP 后仍可识别。</p></div><div class="access-editor-body"><div class="log-tools"><strong id="proxy-access-count">已选择 0 / 64 台</strong><button id="proxy-access-refresh" type="button" class="refresh">刷新设备</button></div><div id="proxy-access-devices" class="access-devices"></div><p id="proxy-access-devices-note" class="small-note">在线状态来自邻居表，租约记录不保证设备此刻在线。</p><details><summary>手工添加 IP / MAC</summary><label for="proxy-access-macs" class="small-note">每行一个 IP 或 MAC 地址</label><textarea id="proxy-access-macs" rows="2" spellcheck="false" placeholder="192.168.1.20 或 02:11:22:33:44:55"></textarea><button id="proxy-access-add" type="button" class="refresh">添加到名单</button></details><p class="small-note">手机请使用当前 Wi-Fi 的固定 MAC。多级路由可能只能识别上级路由器的 MAC。</p><p id="proxy-access-editor-note" class="access-editor-note" role="status"></p></div><div class="access-editor-actions"><button id="proxy-access-cancel" type="button" class="refresh">取消</button><button id="proxy-access-save" type="button" class="primary" disabled>确认开启</button></div></dialog></section><section class="policy-editor"><div class="policy-heading"><strong>自定义域名分流</strong><span>为指定网站设置出口，优先于订阅规则</span></div><form id="policy-add"><input id="policy-domain" aria-label="分流域名" placeholder="例如 github.com" maxlength="253" required><select id="policy-match" aria-label="域名匹配"><option value="suffix">含子域名</option><option value="exact">仅此域名</option></select><span class="policy-arrow">→</span><select id="policy-target" aria-label="分流目标"></select><button class="refresh" type="submit">添加</button></form><div id="policy-list"></div><p class="small-note"><span id="policy-scope">作用于已接管的连接；局域网绕过代理。保存会短暂重启服务。</span></p><div class="policy-footer"><span id="policy-status" role="status">未添加额外规则，沿用当前分流。</span><button id="policy-save" class="refresh">保存并应用</button></div></section><details id="runtime-inspection" class="maintenance"><summary>查看运行规则与连接</summary><section class="runtime-inspector"><div class="log-tools"><strong>实际运行配置</strong><button id="inspect-refresh" class="refresh" type="button">查询</button></div><div class="toolbar"><select id="inspect-kind" aria-label="查询内容"><option value="rules">分流规则</option><option value="groups">策略组</option><option value="connections">当前连接</option></select><form id="inspect-search-form" class="inspect-search"><input id="inspect-query" placeholder="筛选规则、组名或域名" maxlength="128" aria-label="筛选运行信息"><button class="refresh" type="submit">筛选</button></form></div><p id="inspect-summary" class="small-note" role="status">按需查询内核已加载的数据</p><div id="inspect-list" class="inspect-list"></div><div class="pagination"><button id="inspect-previous" class="refresh" type="button" disabled>上一页</button><span id="inspect-page" class="small-note"></span><button id="inspect-next" class="refresh" type="button" disabled>下一页</button></div></section></details><section class="transport-settings"><div class="transport-heading"><strong>国内直连加速</strong><span id="cn-bypass-state" class="small-note"></span></div><div class="transport-controls"><label><input id="cn-bypass-enabled" type="checkbox"> 绕过国内 IP</label><button id="cn-bypass-save" class="refresh" type="button" disabled>应用设置</button></div><p id="cn-bypass-result" class="small-note" role="status">关闭时由内核匹配 DIRECT；开启后国内 IP 提前直连，不计入内核流量。</p></section><details class="maintenance"><summary>直连数据更新</summary><div class="log-tools"><strong>国内 IP 表</strong><button id="rules-update" class="refresh">更新国内 IP 表</button></div><p id="rules-summary" class="small-note"></p><p class="small-note">让未被其他规则指定出口的国内 IP 直连。只更新此表，不改订阅规则；开启绕过时也使用它。<span id="rules-apply-effect">正在确认应用方式…</span></p><p class="small-note">下载源：ispip.clang.cn。更新成功后本机保存，重启沿用；失败继续使用旧表。</p><section class="core-tools"><div class="log-tools"><strong>国内域名库</strong><button id="domain-update" class="refresh">更新当前域名库</button></div><p id="domain-summary" class="small-note"></p><p id="domain-message" class="small-note" role="status"></p><p class="small-note">用于按域名识别国内网站。更新本机 cn.mrs 或 cn.srs，内容变化时会短暂重启；失败继续使用旧库。订阅自行引用的其他域名库不受此按钮影响。</p></section><details><summary>数据库与订阅规则有什么区别？</summary><p class="small-note">以上两个按钮只维护本机的国内 IP 表和国内域名库。订阅中的 GeoIP、GeoSite 和其他规则集由订阅模板指定，请在“查看运行规则与连接”中确认实际引用。</p><p class="small-note">分流顺序：自定义域名规则 → 订阅规则 → 国内 IP 直连补充 → 默认出口。开启国内 IP 绕过后，匹配该表的连接提前直连，国内 IP 上的代理和拦截规则会被跳过。仅安装数据库不会让规则自动生效。</p><p class="small-note">域名库格式随内核选择：Mihomo 使用 MRS，sing-box 使用 SRS。内存与闪存有限，优先下载正在使用的库。</p></details></details></div><div id="dns-tab" hidden><form id="dns-form"><div class="log-tools"><label>DNS 模式 <select id="dns-mode"><option value="mix">Mix：国内及例外真实地址，其余 Fake IP</option><option value="redir_host">全部真实地址：不使用 Fake IP</option></select></label><button id="dns-save" type="submit" class="refresh">保存并应用</button></div><p class="small-note">Mix 对国内域名返回真实地址，对其他域名返回 198.18.x.x 虚拟地址；例外名单返回真实地址。两种模式都继续按同一分流规则决定直连或代理。</p><div class="toolbar"><label for="dns-index">名单索引</label><select id="dns-index"></select></div><textarea id="dns-filter" spellcheck="false" aria-label="Fake IP 例外名单" style="width:100%;height:260px;line-height:20px;border:1px solid var(--line);border-radius:5px;padding:8px;font:12px/20px monospace"></textarea><p class="small-note">名单内返回真实地址，流量仍按分流规则决定。每行一项；支持域名、*.、+. 和 # 注释；最多 512 项。Mijia Cloud 使用小米生态域名替代。保存时代理短暂重启。</p><p class="small-note">保存后路由器按新名单回答 A 查询；客户端已有 DNS 缓存需刷新。当前关闭 IPv6，AAAA 不返回 IPv6 地址。</p><p class="small-note"><span id="dns-udp-scope">普通 UDP 保持直连；指向 Fake IP 的 UDP 被拒绝以便回落 TCP。游戏、STUN 等需在例外名单中。</span></p></form></div><div id="monitor-tab" hidden><section class="core-tools"><div class="log-tools"><strong>ZeroTier</strong><button id="zt-refresh" class="refresh">查询状态</button></div><p id="zt-state" class="small-note">按需查询</p><div id="zt-networks"></div><details><summary>诊断记录</summary><pre id="zt-log">只在本页查询时记录，最多保留 30 条；重启清空。</pre></details></section><div class="log-tools"><strong>运行监控</strong><div><button id="monitor-refresh" class="refresh">刷新状态</button> <button id="memory-cleanup" class="refresh">清理临时文件</button></div></div><div class="monitor-grid"><div><span>可用内存</span><strong id="monitor-available">—</strong></div><div><span>代理内核</span><strong id="monitor-rss">—</strong></div><div><span>保护状态</span><strong id="monitor-pressure">—</strong></div><div><span>连接跟踪</span><strong id="monitor-connections">—</strong></div></div><p id="cleanup-result" class="small-note" role="status">暂无清理记录</p><p class="small-note">每分钟自动检查；安全清理保留最近日志、异常记录和配置。清理完成后自动刷新状态、趋势与异常记录。</p><details class="memory-history"><summary>内存管理设置 <span id="memory-limits-summary"></span></summary><form id="memory-limits-form"><div class="memory-limits-grid"><label>提醒阈值（MB）<input id="memory-warning" type="number" min="13" max="64" step="1" required></label><label>保护阈值（MB）<input id="memory-protect" type="number" min="12" max="63" step="1" required></label><label>自动清理阈值（MB）<input id="memory-trigger" type="number" min="0" max="96" step="1" required></label></div><p class="small-note">可用内存低于阈值时触发；提醒必须高于保护，保护最低 12 MB。清理填 0 表示关闭自动清理；其他值须不低于提醒。日志始终限制大小，手动清理不限阈值。</p><button id="memory-limits-save" class="refresh" type="submit">保存设置</button><p id="memory-settings-result" class="small-note" role="status"></p></form></details><details id="incident-details" class="memory-history" open><summary>异常记录 <span id="incident-summary">正在读取…</span></summary><div class="log-tools"><span class="small-note">记录时间、原因与恢复结果；清空运行日志时保留。</span><button id="incident-refresh" class="refresh">刷新记录</button></div><div id="incident-list"></div><p id="resource-breakdown" class="small-note"></p></details><details id="memory-details" class="memory-history" open><summary>内存趋势 <span>每分钟采样 · 近 24 小时</span></summary><div class="log-tools"><p id="memory-summary" class="small-note">等待采样</p><button id="memory-refresh" class="refresh">刷新趋势</button></div><p class="memory-legend"><span class="core-line">内核占用</span><span class="free-line">系统可用</span><span>单位：MB</span></p><svg id="memory-chart" viewBox="0 0 680 132" role="img" aria-label="内核占用与可用内存历史趋势"></svg><p id="memory-trend" class="small-note"></p><p class="small-note">每分钟记录，保留近 24 小时；路由器重启清空。</p></details></div><div id="logs-tab" hidden><div class="log-toolbar"><div><strong>运行日志</strong><p id="logs-summary" class="small-note">按来源查看最近记录</p></div><div class="log-actions"><select id="logs-view" aria-label="日志来源"><option value="all">全部记录</option><option value="operation">操作与校验</option><option value="core">内核运行</option><option value="subscription">订阅获取</option><option value="system">服务与异常</option></select><button id="logs-refresh" class="refresh" type="button">刷新</button><button id="logs-clear" class="refresh" type="button">清空</button></div></div><div id="log-output" class="log-list">正在读取…</div></div></section>
<details id="help"><summary>使用说明<span>切换与保存</span></summary><p>基础节点视图沿订阅中的手动组选点；共享该组的分流也会跟随变化。单个网站要独立固定节点，请在上方分流目标中选择“固定节点”。</p><p>点击具体节点切换，选择会自动保存。打开、刷新、翻页或切换地区后，依次调用内核延迟接口检测当前页节点，每个节点只测一次，直接显示内核返回的 HTTPS 请求耗时，不取平均或最短值。使用 Gstatic HTTPS 204 地址；耗时包含测试站 TLS 握手、节点连接和协议处理，不等同于 Ping 延迟或已有连接的响应速度。内核超时设为 3 秒；失败显示原因，点击数值打开节点诊断，可按需分别测 Ping 和 HTTPS，两项串行执行。测速不切换当前节点，也不代表实际下载速度。</p><p>保守模式由面板复用每分钟采样任务检测并恢复代理；系统模式由 procd 恢复，两者只启用一套。手动停止后暂停恢复。内存监控与清理单独运行。</p></details>
@@else@@
</div></div><div id="checks-tab" hidden><div class="check-head"><div><div class="caption">CONNECTIVITY</div><h2>网络连通检测</h2><p id="sites-summary">检测指定出站的 HTTPS 响应；规则模式下不代表实际域名分流</p></div><button id="sites-run" class="refresh"><svg width="13" height="13" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16 7a6.5 6.5 0 1 0 .4 5M16 3v4h-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg> 全部检测</button></div><section class="exit-ip"><div class="log-tools"><strong>出口 IP</strong><button id="ip-check" class="refresh" type="button">检测 IP</button></div><div class="ip-grid"><div><span>国内网站出口 · IPIP</span><strong id="ip-cn">尚未检测</strong><small id="ip-geo-cn"></small></div><div><span>国外网站出口 · IP.SB / IPify</span><strong id="ip-world">尚未检测</strong><small id="ip-geo-world"></small></div><div class="ipv6-exit"><span>IPv6 出口</span><strong id="ip-v6">尚未检测</strong><small id="ip-geo-v6"></small></div></div><p id="ip-summary" class="small-note" role="status">检测当前浏览器的公网出口；不代表所有网站都使用同一出口。</p></section><div class="site-sections"><section class="site-section"><div class="site-section-head"><strong>国内网站</strong><span>路由器直连</span></div><div id="sites-cn" class="site-grid"></div></section><section class="site-section"><div class="site-section-head"><strong>国外网站</strong><span id="site-route">当前节点</span></div><div id="sites-world" class="site-grid"></div></section></div><p class="check-note"><span>i</span> 只检测网络是否可达和 HTTPS 请求耗时，不判断网站登录或地区解锁。全局模式均测代理出口，直连模式均测直连出口；切换模式后旧结果清空。</p></div><div id="subscription-tab" hidden><section class="subscription-current"><strong>最近成功加载的订阅</strong><p id="subscription-current" class="small-note" style="white-space:pre-line;overflow-wrap:anywhere">正在读取…</p></section><button id="subscription-restore-draft" type="button" class="refresh" hidden>恢复旧浏览器草稿</button><section class="transport-settings"><div class="transport-heading"><strong>流量接管方式</strong><span id="transport-state" class="small-note"></span></div><div class="transport-controls"><select id="transport-mode" aria-label="流量接管方式"><option value="redir">Redir · TCP</option><option value="mixed">混合 · TCP + UDP</option></select><button id="transport-save" class="refresh" type="button" disabled>应用并重启 ShellCrash</button></div><p id="transport-result" class="small-note" role="status"></p></section><section class="subscription-quota"><div class="log-tools"><strong>订阅余量</strong><button id="quota-refresh" class="refresh" type="button">查询余量</button></div><p id="quota-summary" class="small-note" role="status">服务商未提供用量数据时无法显示余量。</p><progress id="quota-progress" max="100" value="0" hidden aria-label="订阅已使用流量"></progress><p id="quota-detail" class="small-note"></p></section><form id="subscription-form"><label for="subscription-url">代理订阅链接</label><input id="subscription-url" type="url" autocomplete="off" spellcheck="false" placeholder="https://…" required><div class="subscription-fields"><div class="subscription-field"><label for="subscription-method">获取方式</label><select id="subscription-method"><option value="direct">从订阅地址直接下载（默认）</option><option value="panel">服务商直取（兼容下载）</option></select></div><div id="subscription-ua-field" class="subscription-field"><label for="subscription-ua-mode">User-Agent</label><select id="subscription-ua-mode"><option value="">沿用 ShellCrash（默认）</option><option value="custom">自定义</option></select><input id="subscription-ua" placeholder="填写自定义 User-Agent" maxlength="128" autocomplete="off" hidden></div></div><div id="converter-options" hidden><div class="converter-fields"><div class="subscription-field"><label for="converter-server">转换服务</label><select id="converter-server"><option value="0">使用 ShellCrash 当前选择</option><option value="asailor">api.asailor.org</option><option value="custom">自定义转换服务</option></select><div id="converter-custom" hidden><label for="converter-url">转换服务地址</label><input id="converter-url" type="url" placeholder="https://api.asailor.org" autocomplete="off" maxlength="512"></div></div><div class="subscription-field"><label for="converter-template-mode">规则模板</label><select id="converter-template-mode"><option value="">沿用 ShellCrash（默认）</option><option value="custom">自定义模板地址</option></select><input id="converter-template" hidden type="url" value="" placeholder="https://…/template.ini" maxlength="2048"></div></div><label class="converter-auto-label"><input id="converter-auto" type="checkbox" checked> 失败后依次尝试ShellCrash 列表中的其他服务</label><p class="converter-risk">转换服务来自互联网，请自行斟酌。订阅地址会发送给所选服务；自动切换可能发送给多家服务。接口预检不含订阅。</p></div><details class="subscription-exclusion"><summary>排除节点 <span id="subscription-exclude-status" class="small-note">未设置</span></summary><textarea id="subscription-exclude" rows="3" spellcheck="false" aria-label="节点排除条件" placeholder="每行一条，例如：海外用户" style="width:100%;box-sizing:border-box;resize:vertical;padding:8px;border:1px solid var(--line);border-radius:5px;font:inherit"></textarea><p class="small-note">每行一条，自动识别关键字或正则；下次更新订阅时生效，留空取消。</p></details><p id="subscription-help" class="small-note"></p><section class="subscription-preview"><div class="log-tools"><strong>下次更新参数（预览）</strong><button id="subscription-defaults-refresh" type="button" class="refresh">刷新工具参数</button></div><p id="subscription-defaults" class="small-note" style="white-space:pre-line;overflow-wrap:anywhere" role="status">正在读取 ShellCrash 设置…</p><details id="subscription-parameters-details" hidden><summary>转换参数</summary><p id="subscription-parameters" class="small-note" style="overflow-wrap:anywhere"></p></details></section><details><summary>获取和加载流程</summary><p class="small-note">K2P 仅从原服务商订阅地址获取，不调用第三方转换。兼容当前 sing-box 的完整配置保留策略组与规则；本机 DNS 和自定义域名分流继续保留。仅节点内容使用本机基础分流。SSR 不适用于当前 mini 内核。</p></details><button id="subscription-update" class="primary" type="submit">更新订阅</button><p id="subscription-error" class="small-note" role="alert" hidden style="white-space:pre-wrap;overflow-wrap:anywhere;color:#ac5942;background:#fff1ec;padding:10px;border-radius:5px"></p></form><p id="operation-message" role="status"></p><section class="core-tools"><strong>启动与守护</strong><p id="startup-source" class="small-note"></p><div class="toolbar"><label for="guard-mode">守护模式</label><select id="guard-mode"><option value="conservative">ShellCrash 每分钟检测</option></select></div><p class="small-note">此 Padavan 固件只支持 ShellCrash 保守模式，工具也不支持切换到系统守护。面板显示当前状态。</p><p id="guard-result" class="small-note" role="status"></p></section><details class="maintenance"><summary>内核与工具维护</summary><section class="core-tools"><div class="log-tools"><strong>ShellCrash 工具</strong><div><button id="tool-check" class="refresh">检查正式版</button> <button id="tool-update" class="refresh">更新工具</button></div></div><p id="tool-current" class="small-note"></p><p id="tool-message" class="small-note" role="status"></p><p class="small-note">只更新官方 stable 正式版。同版本不替换；保留配置、面板与适配，兼容校验不通过则保留旧版。工具更新不重启代理或其他服务。</p></section><section class="core-tools"><div class="log-tools"><strong>代理内核</strong><div><button id="core-check" class="refresh">检查更新</button> <button id="core-update" class="refresh" disabled>更新内核</button></div></div><p id="core-current" class="core-current">sing-box mini</p><p id="core-summary" class="small-note"></p><p id="core-message" class="small-note" role="status"></p><p class="small-note">仅支持 sing-box mini，程序在内存中运行；配置保存在 Storage。</p><details class="kernel-help"><summary>恢复与备份说明</summary><p class="small-note">重启按已安装版本记录恢复。有效本地包优先，WebDAV 开启且验证通过后可提供备份，再用已配置的 ShellCrash 下载源；未开启时不访问 WebDAV。</p></details></section></details></div><div id="backup-tab" hidden><section class="backup-heading"><div><h2>备份</h2><p class="small-note">备份当前应用、内核与资源；基础恢复点独立保留</p></div><span id="backup-badge" class="backup-badge">已关闭</span></section><form id="mirror-form" novalidate><label class="backup-switch"><input id="remote-enabled" type="checkbox">开启 WebDAV 备份与恢复</label><div class="backup-fields"><div class="backup-address"><label for="mirror-base">WebDAV 地址</label><input id="mirror-base" type="url" placeholder="https://dav.example.com/backup" autocomplete="off"></div><div><label for="remote-user">账号</label><input id="remote-user" autocomplete="off" placeholder="WebDAV 账号"></div><div><label for="remote-password">密码</label><input id="remote-password" type="password" autocomplete="new-password" placeholder="WebDAV 密码"><span id="backup-password-state" class="small-note"></span></div></div><p id="backup-http-note" class="small-note" hidden>HTTP 为明文传输，仅用于可信内网；公网建议 HTTPS。</p><div class="backup-actions"><button id="mirror-verify" type="button" class="refresh">测试连接</button><button id="mirror-save" type="submit" class="primary">保存设置</button></div><p id="mirror-message" class="backup-feedback" role="status" aria-live="polite" hidden></p><p id="mirror-status" class="small-note" role="status"></p><section class="remote-versions"><div class="log-tools"><strong>最新远端备份</strong><button id="remote-versions-refresh" class="refresh" type="button">刷新记录</button></div><p id="remote-versions" class="small-note">尚未读取</p></section><div class="backup-exports"><div><strong>手动备份</strong><p class="small-note">WebDAV 分组件保存完整备份；本地导出是应用与配置 .tar.gz。</p></div><div class="backup-actions"><button id="mirror-sync" type="button" class="refresh">完整备份到 WebDAV</button><button id="backup-local" type="button" class="refresh">导出应用与配置</button></div></div><section class="backup-recovery"><div class="log-tools"><strong>恢复备份</strong><button id="backup-restore" type="button" class="refresh">选择备份</button></div><p class="small-note">先查看来源和组件，再校验文件。检查不会改动当前配置。</p></section><details id="backup-locations" class="backup-help"><summary>文件存放位置</summary><p id="backup-path-state" class="small-note"></p><dl class="backup-paths"><dt>日常备份</dt><dd id="backup-path-latest"></dd><dt>基础备份（独立保留）</dt><dd id="backup-path-baseline"></dd><dt>手动恢复目录</dt><dd id="backup-path-imports"></dd></dl><p class="small-note">手动放入时，每份备份使用一个子目录，保留 manifest.json 与原文件名；不要覆盖日常备份和基础备份目录。</p></details><details id="baseline-section" class="backup-help baseline-section"><summary>基础备份</summary><p class="small-note">确认当前使用正常后创建。日常备份不会覆盖它；更新基础备份是重新保存当前状态，不是恢复。</p><p id="baseline-version" class="small-note">尚未读取基础备份</p><div class="backup-actions"><button id="baseline-create" type="button" class="refresh" disabled>创建基础备份</button><button id="baseline-restore" type="button" class="refresh">恢复基础备份</button></div></details><details class="backup-help"><summary>备份范围与文件说明</summary><p class="small-note">完整 WebDAV 备份：应用、ShellCrash、内核、已安装面板与规则资源，以及订阅、DNS、分流和启动设置。各文件用途可在恢复窗口查看，包内也附说明。</p><p class="small-note">本地导出为应用与配置 .tar.gz，不含内核和临时资源。备份含订阅与节点密码，请妥善保管；不含固件、SSH/WebDAV 凭据及 ZeroTier 身份。恢复保留当前连接凭据，不更改 LAN 或 Wi-Fi。</p></details></form></div><div id="rules-tab" hidden><section class="proxy-access"><div class="access-heading"><div><h3>代理设备白名单</h3><p>按设备分配代理权限，名单外设备仍可直连。</p></div><label class="access-switch"><input id="proxy-access-enabled" type="checkbox" aria-label="启用设备白名单"><span>启用</span></label></div><p id="proxy-access-result" class="access-status" role="status" aria-live="polite" data-state="off">正在读取当前设置…</p><div class="access-footer"><span id="proxy-access-summary">名单尚未读取</span><button id="proxy-access-edit" type="button" class="refresh">设置并开启</button></div><dialog id="proxy-access-editor" class="access-dialog" aria-labelledby="proxy-access-editor-title"><div class="access-editor-head"><h3 id="proxy-access-editor-title">选择允许使用代理的设备</h3><p>按 IP 查找设备，核对名称与 MAC；优先按 MAC 匹配，换 IP 后仍可识别。</p></div><div class="access-editor-body"><div class="log-tools"><strong id="proxy-access-count">已选择 0 / 64 台</strong><button id="proxy-access-refresh" type="button" class="refresh">刷新设备</button></div><div id="proxy-access-devices" class="access-devices"></div><p id="proxy-access-devices-note" class="small-note">在线状态来自邻居表，租约记录不保证设备此刻在线。</p><details><summary>手工添加 IP / MAC</summary><label for="proxy-access-macs" class="small-note">每行一个 IP 或 MAC 地址</label><textarea id="proxy-access-macs" rows="2" spellcheck="false" placeholder="192.168.1.20 或 02:11:22:33:44:55"></textarea><button id="proxy-access-add" type="button" class="refresh">添加到名单</button></details><p class="small-note">手机请使用当前 Wi-Fi 的固定 MAC。多级路由可能只能识别上级路由器的 MAC。</p><p id="proxy-access-editor-note" class="access-editor-note" role="status"></p></div><div class="access-editor-actions"><button id="proxy-access-cancel" type="button" class="refresh">取消</button><button id="proxy-access-save" type="button" class="primary" disabled>确认开启</button></div></dialog></section><section class="policy-editor"><div class="policy-heading"><strong>自定义域名分流</strong><span>为指定网站设置出口，优先于订阅规则</span></div><form id="policy-add"><input id="policy-domain" aria-label="分流域名" placeholder="例如 github.com" maxlength="253" required><select id="policy-match" aria-label="域名匹配"><option value="suffix">含子域名</option><option value="exact">仅此域名</option></select><span class="policy-arrow">→</span><select id="policy-target" aria-label="分流目标"></select><button class="refresh" type="submit">添加</button></form><div id="policy-list"></div><p class="small-note"><span id="policy-scope">作用于已接管的连接；局域网绕过代理。保存会短暂重启服务。</span></p><div class="policy-footer"><span id="policy-status" role="status">未添加额外规则，沿用当前分流。</span><button id="policy-save" class="refresh">保存并应用</button></div></section><details id="runtime-inspection" class="maintenance"><summary>查看运行规则与连接</summary><section class="runtime-inspector"><div class="log-tools"><strong>实际运行配置</strong><button id="inspect-refresh" class="refresh" type="button">查询</button></div><div class="toolbar"><select id="inspect-kind" aria-label="查询内容"><option value="rules">分流规则</option><option value="groups">策略组</option><option value="connections">当前连接</option></select><form id="inspect-search-form" class="inspect-search"><input id="inspect-query" placeholder="筛选规则、组名或域名" maxlength="128" aria-label="筛选运行信息"><button class="refresh" type="submit">筛选</button></form></div><p id="inspect-summary" class="small-note" role="status">按需查询内核已加载的数据</p><div id="inspect-list" class="inspect-list"></div><div class="pagination"><button id="inspect-previous" class="refresh" type="button" disabled>上一页</button><span id="inspect-page" class="small-note"></span><button id="inspect-next" class="refresh" type="button" disabled>下一页</button></div></section></details><section class="transport-settings"><div class="transport-heading"><strong>国内直连加速</strong><span id="cn-bypass-state" class="small-note"></span></div><div class="transport-controls"><label><input id="cn-bypass-enabled" type="checkbox"> 绕过国内 IP</label><button id="cn-bypass-save" class="refresh" type="button" disabled>应用设置</button></div><p id="cn-bypass-result" class="small-note" role="status">关闭时由内核匹配 DIRECT；开启后国内 IP 提前直连，不计入内核流量。</p></section><details class="maintenance"><summary>直连数据更新</summary><div class="log-tools"><strong>国内 IP 表</strong><button id="rules-update" class="refresh">更新国内 IP 表</button></div><p id="rules-summary" class="small-note"></p><p class="small-note">让未被其他规则指定出口的国内 IP 直连；开启绕过时也使用此表。新内容需要短暂重启内核，内容相同不重启。失败继续使用旧表，不改订阅规则。</p><p class="small-note">下载源：ispip.clang.cn。更新成功后保存，重启沿用。本按钮不更新域名库：K2P 沿用轻量 cn.srs，完整订阅的规则集仍由订阅指定。</p></details></div><div id="dns-tab" hidden><form id="dns-form"><div class="log-tools"><label>DNS 模式 <select id="dns-mode"><option value="mix">Mix：国内及例外真实地址，其余 Fake IP</option><option value="redir_host">全部真实地址：不使用 Fake IP</option></select></label><button id="dns-save" type="submit" class="refresh">保存并应用</button></div><p class="small-note">Mix 对国内域名返回真实地址，对其他域名返回 198.18.x.x 虚拟地址；例外名单返回真实地址。两种模式都继续按同一分流规则决定直连或代理。</p><div class="toolbar"><label for="dns-index">名单索引</label><select id="dns-index"></select></div><textarea id="dns-filter" spellcheck="false" aria-label="Fake IP 例外名单" style="width:100%;height:260px;line-height:20px;border:1px solid var(--line);border-radius:5px;padding:8px;font:12px/20px monospace"></textarea><p class="small-note">名单内返回真实地址，流量仍按分流规则决定。每行一项；支持域名、*.、+. 和 # 注释；最多 512 项。Mijia Cloud 使用小米生态域名替代。保存时代理短暂重启。</p><p class="small-note">保存后路由器按新名单回答 A 查询；客户端已有 DNS 缓存需刷新。当前关闭 IPv6，AAAA 不返回 IPv6 地址。</p><p class="small-note"><span id="dns-udp-scope">普通 UDP 保持直连；指向 Fake IP 的 UDP 被拒绝以便回落 TCP。游戏、STUN 等需在例外名单中。</span></p></form></div><div id="monitor-tab" hidden><div class="log-tools"><strong>运行监控</strong><div><button id="monitor-refresh" class="refresh">刷新状态</button> <button id="memory-cleanup" class="refresh">清理临时文件</button></div></div><div class="monitor-grid"><div><span>可用内存</span><strong id="monitor-available">—</strong></div><div><span>代理内核</span><strong id="monitor-rss">—</strong></div><div><span>保护状态</span><strong id="monitor-pressure">—</strong></div><div><span>连接跟踪</span><strong id="monitor-connections">—</strong></div></div><p id="cleanup-result" class="small-note" role="status">暂无清理记录</p><p class="small-note">每分钟自动检查；安全清理保留最近日志、异常记录和配置。清理完成后自动刷新状态、趋势与异常记录。</p><details class="memory-history"><summary>内存管理设置 <span id="memory-limits-summary"></span></summary><form id="memory-limits-form"><div class="memory-limits-grid"><label>提醒阈值（MB）<input id="memory-warning" type="number" min="13" max="64" step="1" required></label><label>保护阈值（MB）<input id="memory-protect" type="number" min="12" max="63" step="1" required></label><label>自动清理阈值（MB）<input id="memory-trigger" type="number" min="0" max="96" step="1" required></label></div><p class="small-note">可用内存低于阈值时触发；提醒必须高于保护，保护最低 12 MB。清理填 0 表示每分钟；其他值须不低于提醒。日志始终限制大小，手动清理不限阈值。</p><button id="memory-limits-save" class="refresh" type="submit">保存设置</button><p id="memory-settings-result" class="small-note" role="status"></p></form></details><details id="incident-details" class="memory-history" open><summary>异常记录 <span id="incident-summary">正在读取…</span></summary><div class="log-tools"><span class="small-note">记录时间、原因与恢复结果；清空运行日志时保留。</span><button id="incident-refresh" class="refresh">刷新记录</button></div><div id="incident-list"></div><p id="resource-breakdown" class="small-note"></p></details><details id="memory-details" class="memory-history" open><summary>内存趋势 <span>每分钟采样 · 近 24 小时</span></summary><div class="log-tools"><p id="memory-summary" class="small-note">等待采样</p><button id="memory-refresh" class="refresh">刷新趋势</button></div><p class="memory-legend"><span class="core-line">内核占用</span><span class="free-line">系统可用</span><span>单位：MB</span></p><svg id="memory-chart" viewBox="0 0 680 132" role="img" aria-label="内核占用与可用内存历史趋势"></svg><p id="memory-trend" class="small-note"></p><p class="small-note">每分钟记录，保留近 24 小时；路由器重启清空。</p></details></div><div id="logs-tab" hidden><div class="log-toolbar"><div><strong>运行日志</strong><p id="logs-summary" class="small-note">按来源查看最近记录</p></div><div class="log-actions"><select id="logs-view" aria-label="日志来源"><option value="all">全部记录</option><option value="operation">操作与校验</option><option value="core">内核运行</option><option value="subscription">订阅获取</option><option value="system">服务与异常</option></select><button id="logs-refresh" class="refresh" type="button">刷新</button><button id="logs-clear" class="refresh" type="button">清空</button></div></div><div id="log-output" class="log-list">正在读取…</div></div></section>
<details id="help"><summary>使用说明<span>切换与保存</span></summary><p>基础节点视图沿订阅中的手动组选点；共享该组的分流也会跟随变化。单个网站要独立固定节点，请在上方分流目标中选择“固定节点”。</p><p>点击具体节点切换，选择会自动保存。打开、刷新、翻页或切换地区后，依次调用内核延迟接口检测当前页节点，每个节点只测一次，直接显示内核返回的 HTTPS 请求耗时，不取平均或最短值。使用 Gstatic HTTPS 204 地址；耗时包含测试站 TLS 握手、节点连接和协议处理，不等同于 Ping 延迟或已有连接的响应速度。内核超时设为 3 秒；失败显示原因，点击数值打开节点诊断，可按需分别测 Ping 和 HTTPS，两项串行执行。测速不切换当前节点，也不代表实际下载速度。</p><p>代理恢复由 ShellCrash 原生每分钟守护执行；面板补充停止保护、重试间隔和异常记录，不另开代理守护。手动停止后暂停恢复。内存监控与清理单独运行。</p></details>
@@end@@
</div>
</div></main><script>
@@if ax5@@
const backendBase='@@BASE@@';
const embedded=window.parent!==window,routerOrigin=location.origin,el=id=>document.getElementById(id),label=s=>String(s||'—').replace(/^地区\//,'').replace(/🇹🇼\s*(?=\S)/g,'');
@@else@@
const embedded=window.parent!==window,routerOrigin=location.origin,el=id=>document.getElementById(id),label=s=>String(s||'—').replace(/^地区\//,'').replace(/🇹🇼\s*(?=\S)/g,'');
@@end@@
let token='',busy=false,proxies={},selected='',viewRegion='',version='',count=0,page=0,nodeView='members';
const pageSize=12,delays=new Map();
function mainName(){return [nativeState?.main_group,'proxy-main','office-anytls'].find(k=>k&&proxies[k]?.all)||Object.keys(proxies).find(k=>proxies[k].type==='Selector'&&k!=='GLOBAL')||groupNames()[0]||'proxy-main'}
@@if ax5@@
// Xiaomi's LuCI relay forks a Lua worker per request. Keep one read/relay in flight.
let routerRequestQueue=Promise.resolve();
function withRouterRequest(task,signal){
 const request=routerRequestQueue.then(()=>{if(signal?.aborted){const e=Error('查询已取消');e.name='AbortError';throw e}return task()});
 routerRequestQueue=request.catch(()=>{});return request;
}
async function routedSiteProbe(site,signal){return api('/panel-probe/'+site.id,'GET',undefined,signal)}
async function api(path,method='GET',body,signal){return withRouterRequest(async()=>{const r=await fetch(apiBase+'?path='+encodeURIComponent(path),{method:['PUT','PATCH'].includes(method)?'POST':method,signal,headers:{'X-SC-CSRF':csrf,'Content-Type':'application/x-www-form-urlencoded'},body:body===undefined?undefined:new URLSearchParams({payload:JSON.stringify(body)})});if(!r.ok){const e=Error(r.status===401?'登录信息已更新，请从路由器后台重新打开':'请求失败：'+r.status);e.status=r.status;throw e;}return r.status===204?null:r.json()},signal)}
@@else@@
async function api(path,method='GET',body,signal){const r=await fetch(apiBase+path,{method,signal,headers:{Authorization:'Bearer '+token,'Content-Type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});if(!r.ok){const e=Error(r.status===401?'登录信息已更新，请从路由器后台重新打开':'请求失败：'+r.status);e.status=r.status;throw e;}return r.status===204?null:r.json()}
@@end@@
let noticeTimer=null;
function note(t,error=false,options={}){
 if(noticeTimer!==null){clearTimeout(noticeTimer);noticeTimer=null}
 const box=el('msg');el('msg-text').textContent=t;box.hidden=!t;box.classList.toggle('error',error);box.dataset.pending=options.pending?'1':'0';
 if(t&&!options.pending)noticeTimer=setTimeout(()=>{box.hidden=true;noticeTimer=null},error?15000:5000);
}
el('msg-close').onclick=()=>note('');
function groupNames(){return Object.keys(proxies).filter(n=>Array.isArray(proxies[n].all)&&n!=='GLOBAL'&&n!=='DIRECT'&&n!=='direct')}
function groupIcon(n){return n===mainName()?'◉':/[\u2600-\u27ff]|[\uD800-\uDBFF]/.test(n)?'':n==='手动选择'?'☝':n==='自动选择'?'↻':'🌐'}
function groupLabel(n){return n==='office-anytls'?'默认代理':nativeState?.template_kind?label(n):n===mainName()?'默认代理':n==='proxy-main'?'默认出口':label(n)}
function isSelectable(p){return /^(selector|select)$/i.test(p?.type||'')}
function selectionPath(name){const path=[],seen=new Set();while(name&&!seen.has(name)){seen.add(name);path.push(name);const p=proxies[name];if(!p?.all||!p.now)break;name=p.now}return path;}
function resolvedNode(name){return selectionPath(name).at(-1)||name;}
function displayNodeLabel(target,name,prefix=''){target.replaceChildren(document.createTextNode(prefix));if(String(name).includes('🇹🇼')){const badge=document.createElement('span');badge.className='region-mark';badge.textContent='TW';badge.setAttribute('aria-hidden','true');target.append(badge)}target.append(document.createTextNode(groupLabel(name)));}
function browse(group){pauseMeasurements();viewRegion=group;page=0;el('search').value='';render();autoMeasure()}
function searchText(text){return String(text).normalize('NFKC').replace(/台灣/g,'台湾').replace(/美國/g,'美国').toLowerCase().replace(/[\s\p{P}\p{S}]/gu,'')}
function nodeProtocol(n){const k=String(n?.type||'').toLowerCase().replace(/[-_]/g,'');return ({shadowsocks:'SS',ss:'SS',shadowsocksr:'SSR',ssr:'SSR',anytls:'AnyTLS',trojan:'Trojan',vmess:'VMess',vless:'VLESS',hysteria2:'HY2',tuic:'TUIC',socks5:'SOCKS5'}[k]||n?.type||'—')}
function nodeOwner(name){const groups=groupNames().filter(g=>proxies[g].all.includes(name));if(groups.includes(viewRegion))return viewRegion;return groups.find(g=>isSelectable(proxies[g])&&/手动/.test(g))||groups.find(g=>isSelectable(proxies[g])&&!g.startsWith('分流/'))||groups[0]||''}
function searchNodes(query){const tokens=query.trim().split(/\s+/).map(searchText).filter(Boolean);return Object.keys(proxies).filter(name=>{const n=proxies[name];if(n.all||/^(direct|reject.*|pass.*|block|compatible|dns)$/i.test(n.type||''))return false;const alias=name.replace(/香港/g,'hk').replace(/台湾|台灣/g,'tw').replace(/日本/g,'jp').replace(/新加坡|狮城/g,'sg').replace(/美国|美國/g,'us');const text=searchText(name+' '+alias+' '+nodeProtocol(n)+' '+(n.type||''));return tokens.every(t=>text.includes(t))})}
function manualNodePath(group,target){
 const queue=[{name:group,path:[]}],seen=new Set();
 while(queue.length){const next=queue.shift();if(seen.has(next.name))continue;seen.add(next.name);const p=proxies[next.name];if(!isSelectable(p)||!Array.isArray(p.all))continue;
  if(p.all.includes(target))return [...next.path,{group:next.name,name:target}];
  const children=p.all.filter(n=>isSelectable(proxies[n])).sort((a,b)=>Number(/手动|manual/i.test(b))-Number(/手动|manual/i.test(a)));
  for(const n of children)queue.push({name:n,path:[...next.path,{group:next.name,name:n}]});
 }return null;
}
function basicNodes(group){return Object.keys(proxies).filter(n=>!proxies[n].all&&!/^(direct|reject.*|pass.*|block|compatible|dns)$/i.test(proxies[n].type||'')&&manualNodePath(group,n));}
function isPinnedAutoGroup(p){return /^(urltest|fallback)$/i.test(p?.type||'')&&typeof p.fixed==='string'&&!!p.fixed;}
async function releaseGroupFixed(group){
 if(busy||manageBusy||!running||!isPinnedAutoGroup(proxies[group]))return;
 const before=proxies[group].now;busy=true;pauseMeasurements();render();try{await api('/proxies/'+encodeURIComponent(group),'DELETE');const current=await api('/proxies/'+encodeURIComponent(group));if(isPinnedAutoGroup(current))throw Error('内核未确认解除固定');let warning='';if(current.now!==before)try{await closeGroupConnections([group])}catch{warning='；旧连接未清理'}busy=false;await refresh();note(groupLabel(group)+' 已恢复自动选择'+warning,!!warning)}catch(e){busy=false;note(e.message,true)}finally{busy=false;render()}
}
async function reconnectCurrentGroup(){
 if(busy||manageBusy||!running)return;busy=true;pauseMeasurements();render();try{const r=await closeGroupConnections([viewRegion]);busy=false;await refresh();note('已重连 '+r.closed+' 条当前组连接'+(r.failed?'，'+r.failed+' 条未确认；可重试':'；内核未重启'),!!r.failed)}catch(e){note('重连失败：'+e.message,true)}finally{busy=false;render()}
}
async function closeGroupConnections(groups){
 const data=await api('/connections'),connections=(data.connections||[]).filter(c=>(c.chains||[]).some(g=>groups.includes(g))&&/^[A-Za-z0-9-]{1,80}$/.test(c.id||''));
 const results=[];for(let i=0;i<Math.min(connections.length,256);i+=4)results.push(...await Promise.allSettled(connections.slice(i,Math.min(i+4,256)).map(c=>api('/connections/'+encodeURIComponent(c.id),'DELETE'))));return {closed:results.filter(r=>r.status==='fulfilled').length,failed:results.filter(r=>r.status==='rejected').length+Math.max(0,connections.length-256)};
}
async function chooseBasicNode(group,name){
 if(busy||manageBusy||!running)return;const path=manualNodePath(group,name);if(!path){note('该组没有可手动固定此节点的路径，请选择手动策略组',true);return}
 const changes=path.filter(step=>proxies[step.group].now!==step.name).map(step=>({...step,before:proxies[step.group].now}));if(!changes.length){note('当前已使用 '+name);return}
 pauseMeasurements();busy=true;render();const applied=[];let warning='';
 try{for(const step of [...changes].reverse()){await api('/proxies/'+encodeURIComponent(step.group),'PUT',{name:step.name});applied.push(step)}
  const live=await api('/proxies');if(changes.some(s=>live.proxies[s.group]?.now!==s.name))throw Error('内核未确认节点切换');
  try{const r=await closeGroupConnections(changes.map(s=>s.group));if(r.failed)warning='；部分旧连接未重连，新连接使用新选择'}catch{warning='；旧连接未清理，新连接使用新选择'}
  busy=false;await refresh();note(groupLabel(group)+' 已固定 '+name+'，通过 '+path.map(s=>groupLabel(s.group)).join(' → ')+'，一分钟内自动保存'+warning,!!warning);
 }catch(e){for(const step of [...applied].reverse())if(step.before)try{await api('/proxies/'+encodeURIComponent(step.group),'PUT',{name:step.before})}catch{warning='；回退未确认，请刷新核对'}busy=false;await refresh();note(e.message+warning,true)}finally{busy=false;render()}
}
function revealNode(name,owner){if(!owner){note('当前内核没有包含此节点的策略组',true);return}browse(owner);page=Math.max(0,Math.floor(proxies[owner].all.indexOf(name)/pageSize));render();autoMeasure()}
function render(){
 const groups=groupNames();if(!groups.length)return;
 if(!groups.includes(viewRegion))viewRegion=mainName();if(!proxies[viewRegion]?.all)viewRegion=groups[0];
 const root=proxies[mainName()];selected=root?.now||'';el('current').textContent=groupLabel(mainName())+' / '+groupLabel(resolvedNode(mainName()));el('current').title='实际策略组：'+mainName()+'。此处显示主策略组的当前选择；网站实际出口由命中的分流规则决定。';paintCoreState();if(typeof paintProxyMode==='function')paintProxyMode();
 const nav=el('regions');nav.replaceChildren();
 const primary=[mainName(),'手动选择','自动选择',...groups.filter(g=>!g.startsWith('地区/')&&!g.startsWith('分流/')&&g!=='proxy-main')].filter((g,i,a)=>groups.includes(g)&&a.indexOf(g)===i);for(const g of primary.slice(0,5)){
  const b=document.createElement('button');b.className='group-card'+(g===viewRegion?' active':'');const name=document.createElement('strong'),now=document.createElement('span');name.textContent=groupIcon(g)+' '+groupLabel(g);displayNodeLabel(now,resolvedNode(g),'当前 ');b.title='当前路径：'+selectionPath(g).map(groupLabel).join(' → ');b.append(name,now);b.onclick=()=>browse(g);nav.append(b)
 }
 const select=document.createElement('select');select.id='region-select';select.setAttribute('aria-label','选择策略组');for(const g of groups){const o=document.createElement('option');o.value=g;o.textContent=groupLabel(g);select.append(o)}select.value=viewRegion;select.onchange=()=>browse(select.value);nav.append(select);
 const p=proxies[viewRegion],q=el('search').value.trim(),items=q?searchNodes(q):nodeView==='basic'?basicNodes(viewRegion):(p.all||[]);
 const toggle=document.createElement('button');toggle.id='node-view';toggle.className='region';toggle.textContent=nodeView==='basic'?'返回组成员':'直接选基础节点';toggle.disabled=busy||manageBusy||!isSelectable(p);toggle.onclick=()=>{nodeView=nodeView==='basic'?'members':'basic';page=0;render();autoMeasure()};nav.append(toggle);const reconnect=document.createElement('button');reconnect.id='reconnect-group';reconnect.className='region';reconnect.textContent='重连当前组';reconnect.title='仅关闭使用当前策略组的现有连接，由应用重新建立；不重启内核';reconnect.disabled=busy||manageBusy||!running;reconnect.onclick=reconnectCurrentGroup;nav.append(reconnect);const unpin=document.createElement('button');unpin.id='group-unpin';unpin.className='region';unpin.textContent='解除临时固定';unpin.hidden=!isPinnedAutoGroup(p);unpin.disabled=busy||manageBusy||!running;unpin.onclick=()=>releaseGroupFixed(viewRegion);nav.append(unpin);
 const pages=Math.max(1,Math.ceil(items.length/pageSize));page=Math.min(page,pages-1);el('list-title').textContent=q?'全部节点搜索':groupLabel(viewRegion);el('list-count').textContent=q?items.length+' 个匹配节点':(nodeView==='basic'?'可固定基础节点':isPinnedAutoGroup(p)?'临时固定':isSelectable(p)?'手动选择':'自动策略')+' · '+items.length+' 个成员';el('page-number').textContent=(page+1)+' / '+pages;el('previous').disabled=page===0;el('next').disabled=page>=pages-1;el('refresh').disabled=busy||manageBusy||!running;
 const list=el('nodes');list.replaceChildren();for(const name of items.slice(page*pageSize,(page+1)*pageSize)){
  const active=(nodeView==='basic'||q)?resolvedNode(viewRegion)===name:p.now===name,n=proxies[name],group=Array.isArray(n?.all),row=document.createElement('div');row.className='node'+(active?' selected':'');row.dataset.name=name;row.dataset.region=viewRegion;
  const pick=document.createElement('button');pick.className='pick';displayNodeLabel(pick,name);pick.title=active?'当前选择 '+groupLabel(name):'将 '+groupLabel(viewRegion)+' 切换到 '+groupLabel(name);pick.setAttribute('aria-label',pick.title);const owner=q?nodeOwner(name):viewRegion,localMember=(p.all||[]).includes(name);pick.disabled=busy||manageBusy||!running||(!q&&!isSelectable(p));pick.onclick=()=>!group&&(q||nodeView==='basic')&&manualNodePath(viewRegion,name)?chooseBasicNode(viewRegion,name):q&&(!localMember||!isSelectable(p))?revealNode(name,owner):choose(viewRegion,name);if(q){pick.title=manualNodePath(viewRegion,name)?'在 '+groupLabel(viewRegion)+' 中固定 '+name:localMember&&isSelectable(p)?'在 '+groupLabel(viewRegion)+' 中选择 '+name:'前往 '+groupLabel(owner)+' 查看 '+name;pick.setAttribute('aria-label',pick.title);const context=document.createElement('small');context.className='node-owner';context.textContent=owner?groupLabel(owner):'未归属策略组';pick.append(context)}row.append(pick);
  if(group){const open=document.createElement('button');open.className='group-open';open.textContent='展开 ›';open.setAttribute('aria-label','展开策略组 '+groupLabel(name));open.onclick=()=>browse(name);row.append(open)}
  const protocol=document.createElement('span');protocol.className='protocol';const kind=String(n?.type||'').toLowerCase().replace(/[-_]/g,'');protocol.textContent=group?'策略组':({shadowsocks:'SS',ss:'SS',shadowsocksr:'SSR',ssr:'SSR',anytls:'AnyTLS',trojan:'Trojan',vmess:'VMess',vless:'VLESS',hysteria2:'HY2',tuic:'TUIC',socks5:'SOCKS5'}[kind]||n?.type||'—');row.append(protocol);
  const test=document.createElement('button');test.className='test';test.setAttribute('aria-label','检测 '+name+' 的延迟');test.onclick=()=>openNodeDiagnostic(name);row.append(test);list.append(row);paintMeasurement(row,name)
 }
 if(!items.length){const empty=document.createElement('div');empty.className='empty';empty.textContent=q?'没有匹配节点，可尝试部分名称、地区缩写或协议':'没有匹配的成员';list.append(empty)}
 el('node-list-help').textContent=nodeView==='basic'?'点击基础节点固定使用 · 上方显示最终节点':q?'点击节点选择或查看所属组':'点击成员切换当前组 · 展开查看下级组';
 paintPolicyTargets();paintGroupMode();paintQuickPolicies();
}
let measureGeneration=0,measureQueue=[],measureWorker=false,measureController=null,measureSerial=0;
const measureTimeout=3000,measureURL='https://www.gstatic.com/generate_204';
function paintMeasurement(row,name){
 const r=delays.get(name),b=row.querySelector('.test'),complete=!r?.loading&&!r?.queued;
 const stale=complete&&r?.checkedAt>0&&Date.now()-r.checkedAt>120000;
 b.className='test'+(stale?' stale':complete&&r?.delay?' measured':'')+(!stale&&complete&&r?.failed?' failed':'');
 b.textContent=stale?'待重测':r?.loading?'检测中':r?.queued?'待测':r?.delay?r.delay+' ms':r?.failed?(r.reason||'失败'):'— ms';
 b.title=name+' · '+(stale?'两分钟前测得的结果，点击打开诊断':r?.delay?'内核单次 HTTPS 请求耗时（Gstatic），包含握手，不等同于 Ping；点击打开诊断':r?.failed?(r.detail||'未取得响应，可用网站检测确认'):'调用内核单次检测 HTTPS 请求耗时，包含握手，不切换节点')+(r?.queued||r?.loading?' · 检测中':'');
 b.disabled=!!r?.loading||!!r?.queued||(typeof diagnosticBusy!=='undefined'&&diagnosticBusy)||manageBusy||!running;
}
function paintMeasurements(){for(const row of el('nodes').children)if(row.dataset.name)paintMeasurement(row,row.dataset.name);paintNodeDiagnostic()}
function pauseMeasurements(){if(typeof cancelNodeDiagnostic==='function')cancelNodeDiagnostic();measureGeneration++;measureQueue=[];if(measureController)measureController.abort();for(const [n,r]of delays)if(r.loading||r.queued)delays.set(n,{loading:false,queued:false});paintMeasurements()}
function queueMeasurements(names,priority=false){
 names=[...new Set(names)];
 const tasks=names.map(name=>({name,generation:measureGeneration}));for(const name of names)delays.set(name,{queued:true});
 measureQueue=priority?[...tasks,...measureQueue.filter(t=>!names.includes(t.name))]:tasks;paintMeasurements();pumpMeasurements();
}
function autoMeasure(){if((typeof diagnosticBusy!=='undefined'&&diagnosticBusy)||nativeState?.pressure&&nativeState.pressure!=='normal'||siteBusy||!running||manageBusy||activeTab!=='nodes'||document.hidden)return;pauseMeasurements();queueMeasurements([...new Set([...el('nodes').children].map(r=>r.dataset.name).filter(Boolean))])}
function measure(name){if(diagnosticBusy)return;if(nativeState?.pressure==='protect'){note('内存保护中，暂缓测速');return}if(!running||manageBusy||delays.get(name)?.loading||delays.get(name)?.queued)return;queueMeasurements([name],true)}
let diagnosticBusy=false,nodeDiagnostic=null,nodeDiagnosticSerial=0;
function nodePingKey(name){let h=0;for(const b of new TextEncoder().encode(name))h=(h*131+b)%2147483647;return String(h)}
function nodeDiagnosticPath(name){return typeof selectionPath==='function'?selectionPath(name).join('\u0000'):name}
function cancelNodeDiagnostic(){nodeDiagnosticSerial++}
function diagnosticContextValid(d){return !!d&&nodeDiagnosticPath(d.group)===d.path&&String(nativeState?.node_config_revision||'')===d.revision&&String(nativeState?.core_kind||'')===d.kind&&String(nativeState?.core_version||'')===d.version}
function paintNodeDiagnostic(){
 const box=el('node-diagnostic');if(!box||!nodeDiagnostic)return;
 const d=nodeDiagnostic,valid=diagnosticContextValid(d),expired=d.checkedAt&&Date.now()-d.checkedAt>120000;
 if(!valid||expired){d.ping=null;d.message=!valid?'节点或配置已变化，请重新打开诊断':'结果已过期，请重新检测'}
 el('node-diagnostic-name').textContent=d.group===d.leaf?d.leaf:d.group+' → '+d.leaf;
 el('node-ping-value').textContent=d.ping!=null?d.ping+' ms':d.message||'尚未检测';
 const r=delays.get(d.leaf),httpsFresh=valid&&r?.delay&&!r.loading&&!r.queued&&r.checkedAt&&Date.now()-r.checkedAt<=120000&&r.revision===d.revision;
 el('node-https-value').textContent=httpsFresh?r.delay+' ms':r?.loading?'检测中':r?.failed?(r.reason||'未取得响应'):'尚未检测';
 for(const id of ['node-ping-run','node-https-run'])el(id).disabled=diagnosticBusy||manageBusy||advancedActive||!running||!valid||nativeState?.active||nativeState?.pressure==='protect';
}
function openNodeDiagnostic(name){
 if(manageBusy||advancedActive||diagnosticBusy||!running)return;
 pauseMeasurements();const leaf=resolvedNode(name),p=proxies[leaf];
 if(!p||p.all||['direct','reject','pass','compatible'].includes(String(p.type).toLowerCase())){note('此项没有可检测的实际代理节点');return}
 nodeDiagnostic={group:name,leaf,path:nodeDiagnosticPath(name),revision:String(nativeState?.node_config_revision||''),kind:String(nativeState?.core_kind||''),version:String(nativeState?.core_version||''),ping:null};
 el('node-diagnostic').hidden=false;paintNodeDiagnostic();
}
async function runNodePing(){
 const d=nodeDiagnostic;if((typeof diagnosticBusy!=='undefined'&&diagnosticBusy)||!diagnosticContextValid(d)||manageBusy||advancedActive||nativeState?.active||!running||nativeState?.pressure==='protect')return;
 pauseMeasurements();pauseSites();diagnosticBusy=true;const serial=++nodeDiagnosticSerial;d.message='等待上一项检测结束…';paintNodeDiagnostic();let until='',completed=false;
 try{
  const limit=Date.now()+12000;
  while((measureWorker||siteBusy||Number(sessionStorage.getItem('k2p-measure-until')||0)>Date.now())&&Date.now()<limit){if(serial!==nodeDiagnosticSerial)return;await new Promise(r=>setTimeout(r,150))}
  if(Date.now()>=limit)throw Error('上一项检测尚未结束，请稍后重试');
  await syncNative();if(serial!==nodeDiagnosticSerial||!diagnosticContextValid(d)||manageBusy||advancedActive||!running||nativeState?.active||nativeState?.pressure==='protect')return;
  const id=[...crypto.getRandomValues(new Uint8Array(4))].map(b=>b.toString(16).padStart(2,'0')).join(''),key=nodePingKey(d.leaf);
  until=String(Date.now()+14000);sessionStorage.setItem('k2p-measure-until',until);d.message='检测中';paintNodeDiagnostic();await control('sc-nodeping.sh',[id,key]);
  const end=Date.now()+18000;let result;
  while(Date.now()<end){await new Promise(r=>setTimeout(r,750));const r=await nativeRead('nodepingresult');if(r.id===id&&r.node_key===key&&r.state!=='working'){result=r;completed=true;break}}
  if(serial!==nodeDiagnosticSerial)return;
  if(!result)throw Error('未取得检测结果，请稍后重试');
  await syncNative();if(serial!==nodeDiagnosticSerial)return;
  const labels={no_reply:'未取得 ICMP 响应',unsupported:'此节点不支持此项参考',busy:'后台正在处理其他操作',stopped:'代理已停止',low_memory:'内存余量不足，暂缓检测',changed:'配置已变化，请重新检测'};
  if(result.state==='done'&&diagnosticContextValid(d)&&result.revision===d.revision&&Number.isFinite(result.delay)&&result.delay>=0){d.ping=result.delay;d.message='';d.checkedAt=Date.now()}
  else{d.ping=null;d.message=labels[result.state]||'结果已失效，请重新检测'}
 }catch(e){if(serial===nodeDiagnosticSerial){d.ping=null;d.message=e.message}}
 finally{diagnosticBusy=false;if(until&&(completed||Number(until)<=Date.now())&&sessionStorage.getItem('k2p-measure-until')===until)sessionStorage.removeItem('k2p-measure-until');paintNodeDiagnostic();paintMeasurements()}
}
function runNodeHTTPS(){if((typeof diagnosticBusy!=='undefined'&&diagnosticBusy)||!diagnosticContextValid(nodeDiagnostic))return;measure(nodeDiagnostic.leaf)}

async function pumpMeasurements(){
 if(measureWorker)return;measureWorker=true;
 try{while(measureQueue.length&&!diagnosticBusy&&running&&!manageBusy&&activeTab==='nodes'&&!document.hidden){
  if(nativeState?.pressure==='protect'){pauseMeasurements();break}
  const remaining=Math.min(18000,Math.max(0,Number(sessionStorage.getItem('k2p-measure-until')||0)-Date.now()));
  if(remaining)await new Promise(r=>setTimeout(r,remaining));
  if((typeof diagnosticBusy!=='undefined'&&diagnosticBusy)||!running||manageBusy||activeTab!=='nodes'||document.hidden)break;
  const task=measureQueue.shift();if(!task)break;const {name,generation}=task;if(generation!==measureGeneration)continue;
  const request=++measureSerial,controller=new AbortController(),until=String(Date.now()+measureTimeout+500);let answered=false;
  measureController=controller;sessionStorage.setItem('k2p-measure-until',until);
  const timer=setTimeout(()=>controller.abort(),measureTimeout+2000);
  delays.set(name,{...delays.get(name),loading:true,queued:false,request,revision:String(nativeState?.node_config_revision||'')});paintMeasurements();
  try{
   const r=await api('/proxies/'+encodeURIComponent(name)+'/delay?timeout='+measureTimeout+'&url='+encodeURIComponent(measureURL),'GET',undefined,controller.signal);answered=true;
   if(generation===measureGeneration){const valid=Number.isFinite(r.delay)&&r.delay>0;delays.set(name,{...delays.get(name),delay:valid?r.delay:undefined,failed:!valid,reason:'未响应'})}
  }catch(e){
   answered=e.name!=='AbortError';if(generation===measureGeneration){const old=delays.get(name);const reason=e.status===504||e.name==='AbortError'?'超时':e.status?'接口 '+e.status:'请求失败';delays.set(name,{...old,failed:true,reason,detail:e.status===504?'测试站在 3 秒内未响应，可重试或用网站检测确认':e.message})}
  }finally{
   clearTimeout(timer);if(answered&&sessionStorage.getItem('k2p-measure-until')===until)sessionStorage.removeItem('k2p-measure-until');if(measureController===controller)measureController=null;
   if(generation===measureGeneration)delays.set(name,{...delays.get(name),loading:false,queued:false,checkedAt:Date.now()});paintMeasurements();
  }
  await new Promise(r=>setTimeout(r,200));
 }}finally{measureWorker=false;if(measureQueue.length&&!diagnosticBusy&&running&&!manageBusy&&activeTab==='nodes'&&!document.hidden)pumpMeasurements()}
}
async function refresh(test=false){if(busy)return;const first=!proxies[mainName()];busy=true;el('refresh').disabled=true;try{const [p,v,c]=await Promise.all([api('/proxies'),api('/version'),api('/connections')]);proxies=p.proxies;version=v.version.replace(/^sing-box\s*/i,'');count=(c.connections||[]).length;el('panel').hidden=false;el('login').hidden=true;busy=false;render();note('');if(first||test)autoMeasure();if(embedded)window.parent.postMessage({type:'shellcrash-connected'},routerOrigin)}catch(e){if(e.message.startsWith('登录信息')){localStorage.removeItem('k2p-token');token='';el('panel').hidden=true;el('login').hidden=false}note(e.message,true)}finally{busy=false;el('refresh').disabled=manageBusy||!running}}
async function choose(group,name){
 if(busy||manageBusy||!running)return;if(!isSelectable(proxies[group])||!proxies[group].all.includes(name)){note('该组不可手动选择',true);return}
 if(proxies[group].now===name){note('该组已选择 '+groupLabel(name));return}
 pauseMeasurements();busy=true;render();try{await api('/proxies/'+encodeURIComponent(group),'PUT',{name});let warning='';try{const r=await closeGroupConnections([group]);if(r.failed)warning=' 部分旧连接未确认重连。'}catch{warning=' 旧连接未清理，新连接使用新选择。'}busy=false;await refresh();note(groupLabel(group)+' 已选择 '+groupLabel(name)+'，一分钟内自动保存。'+warning,!!warning)}catch(e){busy=false;render();note(e.message,true)}finally{busy=false}
}
